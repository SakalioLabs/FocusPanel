<UserControl x:Class="FocusPanel.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FocusPanel.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TasksViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="TaskListItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource FocusListBoxItem}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Width="40"
                    Height="40"
                    Margin="0,0,12,0"
                    Style="{StaticResource FocusIconButton}"
                    Command="{Binding NavigateUpCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="返回上一级">
                <TextBlock Text="&#xE72B;"
                           Style="{StaticResource FocusIconText}"
                           FontSize="17"/>
            </Button>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentParentItem.Title, TargetNullValue='任务项目'}"
                           FontSize="25"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentViewItems.Count, StringFormat={}{0} 个项目}"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource FocusMutedTextBrush}"
                           FontSize="12"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="3"
                    Background="{DynamicResource FocusSurfaceSoftBrush}"
                    CornerRadius="{StaticResource FocusControlCornerRadius}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="列表"
                                 GroupName="TaskViewMode"
                                 Style="{StaticResource FocusSegmentRadioButton}"
                                 IsChecked="{Binding IsListView}"
                                 Command="{Binding SwitchViewModeCommand}"
                                 CommandParameter="List"/>
                    <RadioButton Content="看板"
                                 GroupName="TaskViewMode"
                                 Style="{StaticResource FocusSegmentRadioButton}"
                                 IsChecked="{Binding IsBoardView}"
                                 Command="{Binding SwitchViewModeCommand}"
                                 CommandParameter="Board"/>
                    <RadioButton Content="字段"
                                 GroupName="TaskViewMode"
                                 Style="{StaticResource FocusSegmentRadioButton}"
                                 IsChecked="{Binding IsSettingsView}"
                                 Command="{Binding SwitchViewModeCommand}"
                                 CommandParameter="Settings"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding TaskStatusMessage}"
                   Foreground="{DynamicResource FocusDangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="4">
            <DockPanel Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid DockPanel.Dock="Top"
                      Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入任务名称，按 Enter 创建">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding AddItemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            MinWidth="92"
                            Content="新建任务"
                            Style="{StaticResource FocusPrimaryButton}"
                            Command="{Binding AddItemCommand}"/>
                </Grid>

                <ListBox ItemsSource="{Binding CurrentViewItems}"
                         SelectedItem="{Binding SelectedTask}"
                         ItemContainerStyle="{StaticResource TaskListItemStyle}"
                         Style="{StaticResource FocusListBox}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsCompleted}"
                                          VerticalAlignment="Center"
                                          Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"
                                          ToolTip="标记完成"/>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource FocusMutedTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"
                                               FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Width="34"
                                            Height="34"
                                            Style="{StaticResource FocusIconButton}"
                                            Command="{Binding DataContext.NavigateToItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="进入子任务">
                                        <TextBlock Text="&#xE76C;"
                                                   Style="{StaticResource FocusIconText}"
                                                   FontSize="15"/>
                                    </Button>
                                    <Button Width="34"
                                            Height="34"
                                            Style="{StaticResource FocusIconButton}"
                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="删除">
                                        <TextBlock Text="&#xE74D;"
                                                   Style="{StaticResource FocusIconText}"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource FocusDangerBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Visibility="{Binding IsBoardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid DockPanel.Dock="Top"
                      Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入项目名称，按 Enter 创建">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding AddItemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            MinWidth="92"
                            Content="新建任务"
                            Style="{StaticResource FocusPrimaryButton}"
                            Command="{Binding AddItemCommand}"/>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <ItemsControl ItemsSource="{Binding BoardColumns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="218"
                                        Margin="0,0,12,0"
                                        Padding="12"
                                        Background="{DynamicResource FocusSurfaceSoftBrush}"
                                        CornerRadius="{StaticResource FocusCardCornerRadius}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top"
                                              Margin="2,0,2,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayHeader}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <Border Grid.Column="1"
                                                    Padding="7,2"
                                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                                    CornerRadius="8">
                                                <TextBlock Text="{Binding Tasks.Count}"
                                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                                           FontSize="11"/>
                                            </Border>
                                        </Grid>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                Padding="10"
                                                                Background="{DynamicResource FocusSurfaceStrongBrush}"
                                                                CornerRadius="{StaticResource FocusControlCornerRadius}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="42"/>
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                                           Margin="0,4,0,7"
                                                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                                                           FontSize="10"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Width="30"
                                                                            Height="30"
                                                                            Style="{StaticResource FocusIconButton}"
                                                                            Command="{Binding DataContext.MoveTaskPrevCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="移到前一列">
                                                                        <TextBlock Text="&#xE76B;"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="13"/>
                                                                    </Button>
                                                                    <Button Grid.Column="2"
                                                                            Width="30"
                                                                            Height="30"
                                                                            Style="{StaticResource FocusIconButton}"
                                                                            Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="查看详情">
                                                                        <TextBlock Text="&#xE70F;"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="13"/>
                                                                    </Button>
                                                                    <Button Grid.Column="3"
                                                                            Width="30"
                                                                            Height="30"
                                                                            Style="{StaticResource FocusIconButton}"
                                                                            Command="{Binding DataContext.NavigateToItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="进入子任务">
                                                                        <TextBlock Text="&#xE8A7;"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="13"/>
                                                                    </Button>
                                                                    <Button Grid.Column="4"
                                                                            Width="30"
                                                                            Height="30"
                                                                            Style="{StaticResource FocusIconButton}"
                                                                            Command="{Binding DataContext.MoveTaskNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="移到后一列">
                                                                        <TextBlock Text="&#xE76C;"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="13"/>
                                                                    </Button>
                                                                    <Button Grid.Column="5"
                                                                            Width="30"
                                                                            Height="30"
                                                                            Style="{StaticResource FocusIconButton}"
                                                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="删除任务">
                                                                        <TextBlock Text="&#xE74D;"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource FocusDangerBrush}"/>
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <ScrollViewer Visibility="{Binding IsSettingsView, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="640"
                            HorizontalAlignment="Left">
                    <Border Style="{StaticResource FocusCard}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Markdown 图片"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="插入到任务长文本中的图片会复制到此目录。"
                                       Margin="0,4,0,10"
                                       Foreground="{DynamicResource FocusMutedTextBrush}"
                                       FontSize="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ImageSavePath}"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Content="选择文件夹"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        Command="{Binding SelectImageSavePathCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FocusCard}">
                        <StackPanel>
                            <TextBlock Text="自定义字段"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="字段应用于当前项目；在根目录配置时作为全局字段。"
                                       Margin="0,4,0,12"
                                       Foreground="{DynamicResource FocusMutedTextBrush}"
                                       FontSize="12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewFieldName}"
                                         Margin="0,0,8,0"
                                         ToolTip="字段名称"/>
                                <ComboBox Grid.Column="1"
                                          Margin="0,0,8,0"
                                          ItemsSource="{Binding FieldTypes}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedFieldType}"
                                          Style="{StaticResource FocusComboBox}"/>
                                <Button Grid.Column="2"
                                        Content="添加字段"
                                        Style="{StaticResource FocusPrimaryButton}"
                                        MinWidth="94"
                                        Command="{Binding AddCustomFieldCommand}"/>
                            </Grid>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsFieldTypeSelect, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="选项"
                                           Margin="2,0,0,5"
                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                           FontSize="12"/>
                                <TextBox Text="{Binding NewFieldOptions}"
                                         ToolTip="用逗号或换行分隔多个选项"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding CustomFieldDefinitions}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                                           FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="34"
                                                    Height="34"
                                                    Style="{StaticResource FocusIconButton}"
                                                    Command="{Binding DataContext.DeleteCustomFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="删除字段">
                                                <TextBlock Text="&#xE74D;"
                                                           Style="{StaticResource FocusIconText}"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource FocusDangerBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
