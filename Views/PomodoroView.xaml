<UserControl x:Class="FocusPanel.Views.PomodoroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:FocusPanel.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:PomodoroViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="专注计时"
                           Style="{StaticResource FocusPageTitleText}"/>
                <TextBlock Text="保持节奏，完成后 FocusPanel 会通过声音和通知提醒你。"
                           Margin="0,5,0,0"
                           Style="{StaticResource FocusSecondaryBodyText}"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Style="{StaticResource FocusCard}"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FocusSecondaryBodyText}"/>
                        <TextBlock Text="{Binding TimerDisplay}"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FocusDisplayText}"/>
                        <TextBlock Text="{Binding ElapsedDisplay}"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FocusCaptionText}"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="2"
                                 Height="7"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress}"
                                 Style="{StaticResource FocusLinearProgress}"/>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="25 分钟"
                                Style="{StaticResource FocusSecondaryButton}"
                                MinWidth="88"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanChangeDuration}"
                                Command="{Binding SetDurationCommand}"
                                CommandParameter="25"/>
                        <Button Content="45 分钟"
                                Style="{StaticResource FocusSecondaryButton}"
                                MinWidth="88"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanChangeDuration}"
                                Command="{Binding SetDurationCommand}"
                                CommandParameter="45"/>
                        <Button Content="60 分钟"
                                Style="{StaticResource FocusSecondaryButton}"
                                MinWidth="88"
                                IsEnabled="{Binding CanChangeDuration}"
                                Command="{Binding SetDurationCommand}"
                                CommandParameter="60"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="开始 / 继续"
                                Style="{StaticResource FocusPrimaryButton}"
                                MinWidth="126"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanStart}"
                                Command="{Binding StartCommand}"/>
                        <Button Content="暂停"
                                Style="{StaticResource FocusSecondaryButton}"
                                MinWidth="88"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanPause}"
                                Command="{Binding PauseCommand}"/>
                        <Button Content="重置"
                                Style="{StaticResource FocusSecondaryButton}"
                                MinWidth="88"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource FocusSurfaceSoftBrush}"
                    CornerRadius="{StaticResource FocusControlCornerRadius}"
                    Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CompletedPomodoros}"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FocusMetricText}"
                                   Foreground="{DynamicResource FocusAccentBrightBrush}"/>
                        <TextBlock Text="已完成轮次"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource FocusCaptionText}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource FocusStrokeBrush}"/>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalFocusMinutes, StringFormat={}{0:0.#}}"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FocusMetricText}"
                                   Foreground="{DynamicResource FocusAccentBrightBrush}"/>
                        <TextBlock Text="累计专注分钟"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource FocusCaptionText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
