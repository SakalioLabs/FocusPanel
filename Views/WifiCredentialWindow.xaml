<Window x:Class="FocusPanel.Views.WifiCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接 Wi-Fi"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text"
        AutomationProperties.Name="Panel Wi-Fi 密码对话框">
    <Border x:Name="DialogSurface"
            Padding="24"
            BorderThickness="0"
            Background="{DynamicResource FocusShellTintBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Border Width="40"
                        Height="40"
                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                        Background="{DynamicResource FocusAccentSoftBrush}">
                    <TextBlock Text="&#xE701;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FocusAccentBrush}"
                               Style="{StaticResource FocusIconText}"
                               FontSize="18"/>
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="连接 Wi-Fi"
                               Style="{StaticResource FocusSectionTitleText}"/>
                    <TextBlock x:Name="NetworkNameText"
                               Margin="0,2,0,0"
                               Style="{StaticResource FocusMetaText}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Width="38"
                        Height="38"
                        Style="{StaticResource FocusIconButton}"
                        Click="CancelButton_Click"
                        ToolTip="取消"
                        AutomationProperties.Name="取消连接">
                    <TextBlock Text="&#xE711;"
                               Style="{StaticResource FocusIconText}"
                               FontSize="14"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,22,0,0">
                <TextBlock Text="网络密码"
                           Style="{StaticResource FocusCardTitleText}"/>
                <PasswordBox x:Name="PasswordInput"
                             Margin="0,8,0,0"
                             MinHeight="44"
                             Style="{StaticResource FocusPasswordBox}"
                             PasswordChanged="PasswordInput_PasswordChanged"
                             AutomationProperties.Name="Wi-Fi 网络密码"/>
                <TextBlock x:Name="PasswordHintText"
                           Margin="2,7,2,0"
                           Text="输入 8–63 个字符；密码只交给 Windows，本应用不保存"
                           Style="{StaticResource FocusCaptionText}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Padding="12"
                    CornerRadius="{StaticResource FocusControlCornerRadius}"
                    Background="{DynamicResource FocusAccentSoftBrush}">
                <TextBlock Text="连接成功后由 Windows 加密保存网络配置；FocusPanel 不把密码写入数据库、设置或日志。"
                           Style="{StaticResource FocusCaptionText}"
                           TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="3"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="92"
                        Height="42"
                        Margin="0,0,8,0"
                        Style="{StaticResource FocusSecondaryButton}"
                        Content="取消"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button x:Name="ConnectButton"
                        MinWidth="112"
                        Height="42"
                        Style="{StaticResource FocusPrimaryButton}"
                        Content="连接"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="ConnectButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
