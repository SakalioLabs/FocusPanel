<Window x:Class="FocusPanel.Views.FocusToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusPanel 通知"
        Width="380"
        MinHeight="132"
        MaxHeight="260"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Segoe UI Variable Text"
        AutomationProperties.Name="FocusPanel 通知">
    <Border x:Name="ToastSurface"
            Background="{DynamicResource FocusShellTintBrush}"
            BorderThickness="0"
            Padding="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Width="40"
                    Height="40"
                    Margin="0,0,14,0"
                    CornerRadius="{StaticResource FocusControlCornerRadius}"
                    Background="{DynamicResource FocusAccentSoftBrush}">
                <TextBlock x:Name="IconText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource FocusIconText}"
                           FontSize="17"
                           AutomationProperties.Name="通知类型"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource FocusCardTitleText}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText"
                           Margin="0,5,0,0"
                           Style="{StaticResource FocusBodyText}"
                           LineHeight="20"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Width="36"
                    Height="36"
                    Margin="10,-4,-4,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource FocusIconButton}"
                    Click="CloseButton_Click"
                    ToolTip="关闭"
                    AutomationProperties.Name="关闭通知">
                <TextBlock Text="&#xE711;"
                           Style="{StaticResource FocusIconText}"
                           FontSize="13"/>
            </Button>

            <Button x:Name="ActionButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,14,0,0"
                    MinWidth="104"
                    Height="40"
                    HorizontalAlignment="Left"
                    Style="{StaticResource FocusPrimaryButton}"
                    Click="ActionButton_Click"
                    AutomationProperties.Name="执行通知操作"/>
        </Grid>
    </Border>
</Window>
