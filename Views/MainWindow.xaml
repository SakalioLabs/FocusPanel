<Window x:Class="FocusPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:FocusPanel.Views"
        xmlns:vm="clr-namespace:FocusPanel.ViewModels"
        mc:Ignorable="d"
        TextElement.Foreground="#FF1D1D1F"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="{Binding Title}"
        Height="800"
        Visibility="Collapsed">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                        <local:TasksView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
                        <local:PomodoroView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FileOrganizerViewModel}">
                        <local:FileOrganizerView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:OkrViewModel}">
                        <local:OkrView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AIAssistantViewModel}">
                        <local:AIAssistantView />
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#D9F7F8FB"/>
            <SolidColorBrush x:Key="GlassCardBrush" Color="#C9FFFFFF"/>
            <SolidColorBrush x:Key="GlassRailBrush" Color="#7AFFFFFF"/>
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#9AFFFFFF"/>
            <SolidColorBrush x:Key="GlassTextBrush" Color="#FF1D1D1F"/>
            <SolidColorBrush x:Key="AppleBlueBrush" Color="#FF007AFF"/>
            <DropShadowEffect x:Key="GlassPanelShadow" Color="#44000000" BlurRadius="28" ShadowDepth="0" Opacity="0.32"/>
            <DropShadowEffect x:Key="GlassSoftShadow" Color="#22000000" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="FocusPanel"
                        MenuActivation="LeftOrRightClick"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示 FocusPanel" Command="{Binding ShowWindowCommand}" />
                    <MenuItem Header="退出" Command="{Binding CloseAppCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid>
            <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,100,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm}}"
                               FontSize="96"
                               FontWeight="Light"
                               Foreground="White"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#AA000000" BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:D}}"
                               FontSize="24"
                               Foreground="White"
                               Opacity="0.82"
                               HorizontalAlignment="Center"
                               Margin="0,-10,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#AA000000" BlurRadius="10" ShadowDepth="1" Opacity="0.28"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border x:Name="SidebarBorder"
                    Width="80"
                    HorizontalAlignment="Right"
                    Background="{StaticResource GlassSurfaceBrush}"
                    Margin="0,16,16,16"
                    CornerRadius="28"
                    Effect="{StaticResource GlassPanelShadow}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    AllowDrop="True"
                    MouseEnter="Sidebar_MouseEnter"
                    MouseLeave="Sidebar_MouseLeave"
                    DragEnter="Sidebar_DragEnter"
                    DragLeave="Sidebar_DragLeave">

                <Grid Width="800" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="20,16,16,10" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Click="CollapseSidebar_Click"
                                ToolTip="折叠侧边栏"
                                Height="32"
                                Width="32"
                                Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24"/>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FolderStarOutline"
                                                     Width="24"
                                                     Height="24"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"
                                                     Foreground="{StaticResource AppleBlueBrush}"/>
                            <TextBlock Text="桌面收纳"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource GlassTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Command="{Binding MinimizeAppCommand}"
                                    ToolTip="折叠"
                                    Height="32"
                                    Width="32">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Command="{Binding CloseAppCommand}"
                                    ToolTip="退出"
                                    Height="32"
                                    Width="32"
                                    Margin="6,0,0,0">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="15,0,0,15"
                                Background="{StaticResource GlassRailBrush}"
                                CornerRadius="22"
                                Padding="6"
                                VerticalAlignment="Center"
                                Effect="{StaticResource GlassSoftShadow}"
                                BorderBrush="{StaticResource GlassStrokeBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Files" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="桌面收纳" Padding="10" Margin="0,4" Height="Auto" materialDesign:ButtonAssist.CornerRadius="16">
                                    <materialDesign:PackIcon Kind="Folder" Width="24" Height="24"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Tasks" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="任务" Padding="10" Margin="0,4" Height="Auto" materialDesign:ButtonAssist.CornerRadius="16">
                                    <materialDesign:PackIcon Kind="CheckboxMarked" Width="24" Height="24"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Pomodoro" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="番茄钟" Padding="10" Margin="0,4" Height="Auto" materialDesign:ButtonAssist.CornerRadius="16">
                                    <materialDesign:PackIcon Kind="Timer" Width="24" Height="24"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="OKR" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="OKR" Padding="10" Margin="0,4" Height="Auto" materialDesign:ButtonAssist.CornerRadius="16">
                                    <materialDesign:PackIcon Kind="Target" Width="24" Height="24"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="AI" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="AI 助手" Padding="10" Margin="0,4" Height="Auto" materialDesign:ButtonAssist.CornerRadius="16">
                                    <materialDesign:PackIcon Kind="Robot" Width="24" Height="24"/>
                                </Button>

                                <Separator Background="{StaticResource GlassStrokeBrush}" Margin="4,8"/>

                                <Grid>
                                    <ToggleButton x:Name="SettingsToggle"
                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                  ToolTip="数据与设置"
                                                  Padding="10"
                                                  Margin="0,4"
                                                  Height="Auto"
                                                  materialDesign:ButtonAssist.CornerRadius="16">
                                        <materialDesign:PackIcon Kind="DatabaseSettings" Width="24" Height="24"/>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=SettingsToggle}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Margin="8,0,0,0"
                                                Padding="12"
                                                CornerRadius="16"
                                                Background="{StaticResource GlassSurfaceBrush}"
                                                BorderBrush="{StaticResource GlassStrokeBrush}"
                                                BorderThickness="1"
                                                Effect="{StaticResource GlassSoftShadow}">
                                            <StackPanel>
                                                <TextBlock Text="数据管理" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.65" Margin="8,4,8,8"/>
                                                <Button Command="{Binding RestoreDatabaseCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="BackupRestore" Margin="0,0,12,0" Foreground="Orange" VerticalAlignment="Center"/>
                                                        <TextBlock Text="恢复数据库" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ContentArea"
                                Grid.Column="1"
                                Margin="15,0,15,15"
                                Background="{StaticResource GlassCardBrush}"
                                CornerRadius="24"
                                Padding="14"
                                Opacity="0"
                                BorderBrush="{StaticResource GlassStrokeBrush}"
                                BorderThickness="1"
                                Effect="{StaticResource GlassSoftShadow}">
                            <ContentControl Content="{Binding CurrentViewModel}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
