<Window x:Class="FocusPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:FocusPanel.Views"
        xmlns:vm="clr-namespace:FocusPanel.ViewModels"
        xmlns:services="clr-namespace:FocusPanel.Services"
        mc:Ignorable="d"
        Title="FocusPanel"
        Width="76"
        Height="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <local:TasksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
            <local:PomodoroView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileOrganizerViewModel}">
            <local:FileOrganizerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OkrViewModel}">
            <local:OkrView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AIAssistantViewModel}">
            <local:AIAssistantView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="FocusPanel · Ctrl+Alt+Shift+F10 恢复系统任务栏"
                        MenuActivation="LeftOrRightClick"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示 FocusPanel" Command="{Binding ShowWindowCommand}"/>
                    <MenuItem Header="恢复原任务栏设置" Command="{Binding DisableReplacementCommand}"/>
                    <Separator/>
                    <MenuItem Header="退出" Command="{Binding CloseAppCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border x:Name="ShellBorder"
                Margin="0"
                CornerRadius="0"
                Background="{DynamicResource FocusShellTintBrush}"
                BorderThickness="0"
                MouseEnter="Shell_MouseEnter"
                MouseLeave="Shell_MouseLeave"
                LostKeyboardFocus="Shell_LostKeyboardFocus"
                AllowDrop="True"
                DragEnter="Sidebar_DragEnter"
                DragLeave="Sidebar_DragLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>

                <!-- Expandable FocusPanel workspace -->
                <Grid x:Name="WorkspaceHost"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      Margin="12,12,2,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSectionTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource FocusIconButton}"
                                    Click="CollapseSidebar_Click"
                                    ToolTip="收回工作区">
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE72B;"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="WorkspaceSurface"
                            Grid.Row="1"
                            Padding="0"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0">
                        <ContentControl Content="{Binding CurrentViewModel}"/>
                    </Border>

                    <!-- Search overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="10"
                            Margin="8,56,14,8"
                            Padding="18"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="启动应用" FontSize="18" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" Margin="0,14,0,12">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource FocusSearchBox}"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="搜索开始菜单应用"/>
                                <TextBlock Text="输入应用名称"
                                           Margin="16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding SearchResults}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemChrome"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="{StaticResource FocusControlCornerRadius}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource FocusHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="54" Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.ColumnSpan="2"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="30" Height="30"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               Margin="10,0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource FocusIconButton}"
                                                    Width="40"
                                                    Height="40"
                                                    ToolTip="固定或取消固定"
                                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource FocusIconText}" FontSize="16" Text="&#xE840;"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Focus center -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="11"
                            Width="390"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="0,10,14,10"
                            Padding="22"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsFocusCenterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Focus 中心" FontSize="19" FontWeight="SemiBold"/>
                                <Button Margin="0,14,0,10" Style="{StaticResource FocusSecondaryButton}"
                                        Command="{Binding OpenLastWorkspaceCommand}">
                                    <TextBlock Text="{Binding CurrentSectionTitle, StringFormat=最近使用 · {0}}"/>
                                </Button>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="桌面收纳" Command="{Binding NavigateCommand}" CommandParameter="Files"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="任务" Command="{Binding NavigateCommand}" CommandParameter="Tasks"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="番茄钟" Command="{Binding NavigateCommand}" CommandParameter="Pomodoro"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="OKR" Command="{Binding NavigateCommand}" CommandParameter="OKR"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="AI 助手" Command="{Binding NavigateCommand}" CommandParameter="AI"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="设置与更新" Click="SettingsMenuItem_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Status center -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="11"
                            Width="390"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="0,10,14,10"
                            Padding="22"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsStatusCenterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="状态中心" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ReplacementStatus}" Margin="0,5,0,12" Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                <TextBlock Text="{Binding ReplacementError}" Margin="0,0,0,10"
                                           Foreground="{DynamicResource FocusDangerBrush}" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource FocusSecondaryButton}" Content="重新接管任务栏"
                                        Command="{Binding EnableReplacementCommand}"
                                        Visibility="{Binding HasReplacementWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Grid Margin="0,14,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE701;" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding NetworkDisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding NetworkDetail}" Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource FocusSecondaryButton}" Content="网络" Command="{Binding OpenQuickSettingsCommand}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource FocusIconButton}" Command="{Binding ToggleMuteCommand}" ToolTip="静音">
                                        <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE767;"/>
                                    </Button>
                                    <Slider Grid.Column="1" Margin="8,0,14,0" Minimum="0" Maximum="1"
                                            Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Visibility="{Binding HasBattery, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE850;"/>
                                    <ProgressBar Grid.Column="1" Height="6" Margin="8,0,14,0" Maximum="100" Value="{Binding BatteryPercent}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding BatteryPercent, StringFormat={}{0}%}"/>
                                </Grid>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="输入法" Command="{Binding OpenInputSwitcherCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="通知中心" Command="{Binding OpenNotificationsCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="显示桌面" Command="{Binding ShowDesktopCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="锁定" Command="{Binding LockComputerCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="睡眠" Command="{Binding SleepComputerCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="电源" Command="{Binding TogglePowerMenuCommand}"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Clock and daily overview -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="11"
                            Width="360"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,8"
                            Padding="22"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsCalendarOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm:ss}}"
                                       FontSize="42"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:yyyy年M月d日 dddd}}"
                                       Margin="1,2,0,18"
                                       Foreground="{DynamicResource FocusMutedTextBrush}"/>
                            <Border Height="1" Background="{DynamicResource FocusStrokeBrush}" Margin="0,0,0,18"/>
                            <TextBlock Text="今日概览" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OpenTaskCount, StringFormat=还有 {0} 项任务待完成}"
                                       Margin="0,6,0,16"
                                       Foreground="{DynamicResource FocusMutedTextBrush}"/>
                            <UniformGrid Columns="3">
                                <Button Style="{StaticResource FocusPrimaryButton}" Content="查看任务" Command="{Binding NavigateCommand}" CommandParameter="Tasks"/>
                                <Button Style="{StaticResource FocusSecondaryButton}" Content="通知中心" Command="{Binding OpenNotificationsCommand}"/>
                                <Button Style="{StaticResource FocusSecondaryButton}" Content="显示桌面" Command="{Binding ShowDesktopCommand}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Settings overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="12"
                            Width="420"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,8"
                            Padding="20"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="系统与恢复" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="紧急恢复：Ctrl + Alt + Shift + F10"
                                       Margin="0,6,0,16"
                                       Foreground="{DynamicResource FocusMutedTextBrush}"/>
                             <Border Style="{StaticResource FocusCard}" Margin="0,0,0,12">
                                 <StackPanel>
                                     <TextBlock Text="侧边任务栏完整替代" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,10"
                                               Text="{Binding ReplacementStatus}"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                    <TextBlock Margin="0,0,0,10"
                                               Text="{Binding ReplacementError}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource FocusDangerBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource FocusPrimaryButton}"
                                                Content="启用"
                                                Command="{Binding EnableReplacementCommand}"/>
                                        <Button Style="{StaticResource FocusSecondaryButton}"
                                                Margin="8,3,0,3"
                                                Content="恢复原任务栏设置"
                                                Command="{Binding DisableReplacementCommand}"/>
                                    </StackPanel>
                                 </StackPanel>
                             </Border>
                            <Border Style="{StaticResource FocusCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="外观与交互" FontWeight="SemiBold"/>
                                    <TextBlock Text="主题"
                                               Margin="0,10,0,5"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                    <ComboBox SelectedValuePath="Tag"
                                              SelectedValue="{Binding ThemeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="跟随系统" Tag="System"/>
                                        <ComboBoxItem Content="浅色" Tag="Light"/>
                                        <ComboBoxItem Content="深色" Tag="Dark"/>
                                    </ComboBox>
                                    <CheckBox Margin="0,12,0,0"
                                              Content="全屏应用前台时停用鼠标热区"
                                              IsChecked="{Binding DisableHotZoneInFullscreen}"/>
                                    <CheckBox Margin="0,8,0,0"
                                              Content="随 Windows 启动 FocusPanel"
                                              IsChecked="{Binding StartWithWindows}"/>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="主动唤出：Ctrl + Alt + Space"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                    <Border Margin="0,12,0,0"
                                            Padding="10"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="#33FFB020"
                                            Visibility="{Binding ShowsProtectedSystemFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource FocusTextBrush}"
                                                   Text="当前 Explorer 已启用“显示受保护的系统文件”。收纳项目仍会保留在原路径，因此无法保证桌面图标不可见；关闭该系统选项后会立即按收纳状态隐藏。"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FocusCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="软件更新" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentAppVersion, StringFormat=v{0}}"
                                                   Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,10"
                                               Text="{Binding UpdateStatus}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                    <ProgressBar Height="5"
                                                 Margin="0,0,0,10"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding UpdateProgress}"
                                                 Visibility="{Binding IsUpdateBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Command="{Binding CheckAndInstallUpdateCommand}"
                                            Content="一键检查并安装更新">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FocusPrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdateBusy}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Content" Value="正在更新…"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource FocusSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="从最新备份恢复数据库"
                                    Command="{Binding RestoreDatabaseCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource FocusDangerBrush}"
                                    Content="退出 FocusPanel"
                                    Command="{Binding CloseAppCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Power overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="13"
                            Width="320"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,8"
                            Padding="18"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsPowerMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="电源" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Content="锁定" Command="{Binding LockComputerCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Content="睡眠" Command="{Binding SleepComputerCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Content="重启…" Command="{Binding RestartComputerCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Foreground="{DynamicResource FocusDangerBrush}" Content="关机…" Command="{Binding ShutdownComputerCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Compact app dock -->
                <Border Grid.Column="1"
                        Margin="10,12,10,12"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Grid Margin="0,3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="SearchButton"
                                Grid.Row="0"
                                Tag="CompactFixedEntry"
                                Style="{StaticResource FocusIconButton}"
                                Click="SearchButton_Click"
                                Command="{Binding ToggleSearchCommand}"
                                ToolTip="启动应用">
                            <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE721;"/>
                        </Button>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding TaskbarApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Style="{StaticResource FocusIconButton}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="TaskbarApp_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="TaskbarApp_PreviewMouseMove"
                                                        DragOver="TaskbarApp_DragOver"
                                                        Drop="TaskbarApp_Drop"
                                                        Click="TaskbarApp_Click"
                                                        ContextMenuOpening="TaskbarApp_ContextMenuOpening">
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding WindowSummary}" Opacity="0.65"/>
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                    <Button.ContextMenu>
                                                        <ContextMenu/>
                                                    </Button.ContextMenu>
                                                    <Image Source="{Binding Icon}" Width="30" Height="30"/>
                                                </Button>
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="{DynamicResource FocusAccentBrightBrush}"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Margin="-1,0,0,0"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Opacity" Value="0.42"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <Border Height="1" Margin="11,6" Background="{DynamicResource FocusStrokeBrush}"/>
                            <Button Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Command="{Binding OpenStartMenuCommand}"
                                    ToolTip="开始 · 右键打开系统管理菜单">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="安装的应用"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.InstalledApps}"/>
                                        <MenuItem Header="电源选项"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.PowerOptions}"/>
                                        <MenuItem Header="事件查看器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.EventViewer}"/>
                                        <MenuItem Header="系统"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.SystemAbout}"/>
                                        <MenuItem Header="设备管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DeviceManager}"/>
                                        <MenuItem Header="网络连接"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.NetworkConnections}"/>
                                        <MenuItem Header="磁盘管理"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DiskManagement}"/>
                                        <MenuItem Header="计算机管理"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.ComputerManagement}"/>
                                        <MenuItem Header="终端"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.Terminal}"/>
                                        <MenuItem Header="终端（管理员）"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.TerminalAdministrator}"/>
                                        <MenuItem Header="任务管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.TaskManager}"/>
                                        <Separator/>
                                        <MenuItem Header="设置"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.Settings}"/>
                                        <MenuItem Header="文件资源管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.FileExplorer}"/>
                                        <MenuItem Header="搜索"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWindowsSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="小组件"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWidgetsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="运行…"
                                                  Command="{Binding PlacementTarget.DataContext.OpenRunDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="关机或注销">
                                            <MenuItem Header="锁定"
                                                      Command="{Binding PlacementTarget.DataContext.LockComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="睡眠"
                                                      Command="{Binding PlacementTarget.DataContext.SleepComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="重启…"
                                                      Command="{Binding PlacementTarget.DataContext.RestartComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="关机…"
                                                      Command="{Binding PlacementTarget.DataContext.ShutdownComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </MenuItem>
                                        <MenuItem Header="桌面"
                                                  Command="{Binding PlacementTarget.DataContext.ShowDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE782;"/>
                            </Button>
                            <Button Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Command="{Binding OpenTaskViewCommand}"
                                    ToolTip="任务视图">
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE7C4;"/>
                            </Button>
                            <Button Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Click="FocusCenterButton_Click"
                                    ToolTip="Focus 中心">
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE8B7;"/>
                            </Button>
                            <Button Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Click="StatusCenterButton_Click"
                                    PreviewMouseWheel="VolumeButton_PreviewMouseWheel"
                                    MouseRightButtonUp="VolumeButton_MouseRightButtonUp"
                                    ToolTip="状态中心">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FocusIconText}">
                                            <Setter Property="Text" Value="&#xE95D;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasReplacementWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource FocusDangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Click="CalendarPanelButton_Click"
                                    ToolTip="时间与今日任务">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm}}"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:M/d}}"
                                               HorizontalAlignment="Center"
                                               FontSize="9"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- First-run safety onboarding -->
                <Border Grid.Column="0"
                        Panel.ZIndex="50"
                        Margin="0"
                        Padding="28"
                        CornerRadius="0"
                        Background="{DynamicResource FocusSurfaceStrongBrush}"
                        BorderThickness="0"
                        Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="500">
                            <Border Width="64" Height="64" CornerRadius="{StaticResource FocusCardCornerRadius}" Background="{DynamicResource FocusAccentBrush}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource FocusIconText}" FontSize="28" Text="&#xE7F8;"/>
                            </Border>
                            <TextBlock Text="启用 FocusPanel 侧边任务栏"
                                       Margin="0,22,0,10"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="14"
                                       LineHeight="23"
                                       Foreground="{DynamicResource FocusMutedTextBrush}"
                                       Text="FocusPanel 先通过 Windows AppBar 自动隐藏释放工作区，再隐藏主屏原生任务栏。守护器只验证状态，不反复改写工作区；异常、退出或紧急快捷键会恢复原设置。Win+A、Win+N、Win+Space 等系统入口仍可使用。"/>
                            <CheckBox Content="随 Windows 启动 FocusPanel"
                                      Margin="0,20,0,0"
                                      IsChecked="{Binding StartWithWindows}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FocusSecondaryButton}"
                                    Content="暂不启用"
                                    Command="{Binding SkipOnboardingCommand}"/>
                            <Button Style="{StaticResource FocusPrimaryButton}"
                                    Margin="10,3,0,3"
                                    Content="启用侧边任务栏"
                                    Command="{Binding EnableReplacementCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
