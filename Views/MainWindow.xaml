                                    <CheckBox Margin="0,8,0,0"
                                              Content="随 Windows 启动 FocusPanel"
                                              IsChecked="{Binding StartWithWindows}"/>
                                    <TextBlock Margin="24,5,0,0"
                                               Text="{Binding StartupStatus}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding SummonShortcutText}"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding TaskbarSlotShortcutText}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <Border x:Name="ProtectedFilesWarning"
                                            Margin="0,12,0,0"
                                            Padding="10"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusWarningSoftBrush}"
                                            BorderBrush="{DynamicResource FocusWarningBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding ShowsProtectedSystemFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource FocusWarningTextBrush}"
                                                   Text="当前 Explorer 已启用“显示受保护的系统文件”。收纳项目仍会保留在原路径，因此无法保证桌面图标不可见；关闭该系统选项后会立即按收纳状态隐藏。"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="SettingsUpdateCard"
                                    Style="{StaticResource FocusCard}"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="软件更新"
                                                   Style="{StaticResource FocusCardTitleText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentAppVersion, StringFormat=v{0}}"
                                                   Style="{StaticResource FocusMetaText}"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="更新源"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   Text="GitHub Releases · 静态清单"
                                                   Foreground="{DynamicResource FocusTextBrush}"/>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,10"
                                               Text="{Binding UpdateStatus}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <ProgressBar Height="5"
                                                 Margin="0,0,0,10"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding UpdateProgress}"
                                                 Visibility="{Binding IsUpdateBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button x:Name="SettingsUpdateActionButton"
                                            Command="{Binding CheckAndInstallUpdateCommand}"
                                            Content="一键检查并安装更新">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FocusPrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdateBusy}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Content" Value="正在更新…"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Margin="0,8,0,0"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Command="{Binding OpenUpdateDownloadPageCommand}"
                                            Content="打开官方下载页"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource FocusSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="从最新备份恢复数据库"
                                    Command="{Binding RestoreDatabaseCommand}"/>
                            <Button Style="{StaticResource FocusDangerButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="退出 FocusPanel"
                                    Command="{Binding CloseAppCommand}"/>
                          </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Power overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="13"
                            Width="320"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,8"
                            Padding="18"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsPowerMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="电源"
                                       Margin="4,0,0,10"
                                       Style="{StaticResource FocusSectionTitleText}"/>
                            <Button x:Name="PowerMenuLockButton"
                                    Style="{StaticResource FocusSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="锁定"
                                    Command="{Binding LockComputerCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Content="睡眠" Command="{Binding SleepComputerCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Content="重启…" Command="{Binding RestartComputerCommand}"/>
                            <Button Style="{StaticResource FocusDangerButton}" HorizontalContentAlignment="Left" Content="关机…" Command="{Binding ShutdownComputerCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Compact app dock -->
                <Border x:Name="CompactDock"
                        Grid.Column="1"
                        Margin="10,12,10,12"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderThickness="0"
                        KeyboardNavigation.TabNavigation="Cycle"
                        KeyboardNavigation.DirectionalNavigation="Cycle"
                        AutomationProperties.Name="FocusPanel 侧边任务栏">
                    <Grid Margin="0,3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Button x:Name="StartButton"
                                    Style="{StaticResource CompactLabeledEntryButton}"
                                    Tag="CompactFixedEntry"
                                    Click="StartButton_Click"
                                    AutomationProperties.Name="开始"
                                    AutomationProperties.HelpText="按 Enter 打开 Panel 全部应用，按 Shift+Enter 打开 Panel 统一搜索，按 Shift+F10 打开系统管理菜单"
                                    ToolTip="开始 · 左键打开 Panel 全部应用 · Shift+左键打开 Panel 统一搜索 · 右键打开系统管理菜单">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                 Opened="TransientContextMenu_Opened"
                                                 Closed="TransientContextMenu_Closed">
                                        <MenuItem Header="Panel 统一搜索"
                                                  InputGestureText="Shift+单击"
                                                  Click="OpenUnifiedSearchMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="安装的应用"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.InstalledApps}"/>
                                        <MenuItem Header="电源选项"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.PowerOptions}"/>
                                        <MenuItem Header="事件查看器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.EventViewer}"/>
                                        <MenuItem Header="系统"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.SystemAbout}"/>
                                        <MenuItem Header="设备管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DeviceManager}"/>
                                        <MenuItem Header="网络连接"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.NetworkConnections}"/>
                                        <MenuItem Header="磁盘管理"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DiskManagement}"/>
                                        <MenuItem Header="计算机管理"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.ComputerManagement}"/>
                                        <MenuItem Header="终端"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.Terminal}"/>
                                        <MenuItem Header="终端（管理员）"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.TerminalAdministrator}"/>
                                        <MenuItem Header="任务管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.TaskManager}"/>
                                        <Separator/>
                                        <MenuItem Header="设置"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.Settings}"/>
                                        <MenuItem Header="文件资源管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.FileExplorer}"/>
                                        <MenuItem Header="Panel 运行…"
                                                  Click="OpenPanelRunMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="虚拟桌面">
                                            <MenuItem Header="上一个桌面"
                                                      InputGestureText="Win+Ctrl+←"
                                                      Command="{Binding PlacementTarget.DataContext.SwitchVirtualDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{x:Static services:VirtualDesktopDirection.Previous}"/>
                                            <MenuItem Header="新建桌面"
                                                      InputGestureText="Win+Ctrl+D"
                                                      Command="{Binding PlacementTarget.DataContext.CreateVirtualDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="下一个桌面"
                                                      InputGestureText="Win+Ctrl+→"
                                                      Command="{Binding PlacementTarget.DataContext.SwitchVirtualDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{x:Static services:VirtualDesktopDirection.Next}"/>
                                            <MenuItem Header="关闭当前桌面…"
                                                      InputGestureText="Win+Ctrl+F4"
                                                      Click="CloseCurrentVirtualDesktop_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="关机或注销">
                                            <MenuItem Header="锁定"
                                                      Command="{Binding PlacementTarget.DataContext.LockComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="睡眠"
                                                      Command="{Binding PlacementTarget.DataContext.SleepComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="重启…"
                                                      Command="{Binding PlacementTarget.DataContext.RestartComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="关机…"
                                                      Command="{Binding PlacementTarget.DataContext.ShutdownComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </MenuItem>
                                        <MenuItem Header="桌面"
                                                  Command="{Binding PlacementTarget.DataContext.ShowDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="48" Height="48">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FocusIconText}"
                                                   HorizontalAlignment="Center"
                                                   Text="&#xE782;"/>
                                        <TextBlock Margin="0,-2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource FocusMetaText}"
                                                   Text="开始"/>
                                    </StackPanel>
                                    <Border Width="3"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusAccentBrightBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsApplicationLauncherOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="SearchButton"
                                    Tag="CompactFixedEntry"
                                    Style="{StaticResource CompactLabeledEntryButton}"
                                    Click="SearchButton_Click"
                                    AutomationProperties.Name="窗口总览与统一搜索"
                                    AutomationProperties.HelpText="点击查看全部窗口；顶部可切换应用、任务、系统命令和计算搜索"
                                    ToolTip="窗口总览与统一搜索">
                                <Grid Width="48" Height="48">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FocusIconText}"
                                                   HorizontalAlignment="Center"
                                                   Text="&#xE721;"/>
                                        <TextBlock Margin="0,-2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource FocusMetaText}"
                                                   Text="窗口"/>
                                    </StackPanel>
                                    <Border MinWidth="18"
                                            Height="18"
                                            Padding="4,0"
                                            Margin="0,-4,-4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                                            BorderBrush="{DynamicResource FocusAccentBrightBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="{Binding OpenWindowCount}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FocusMetaText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FocusAccentBrightBrush}"/>
                                    </Border>
                                    <Border Width="3"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusAccentBrightBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsUnifiedSearchEntryActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                            <Border Height="1"
                                    Margin="11,6"
                                    Background="{DynamicResource FocusStrokeBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              x:Name="TaskbarAppsHost"
                              AllowDrop="True"
                              PreviewMouseWheel="TaskbarAppsHost_PreviewMouseWheel"
                              PreviewDragEnter="TaskbarAppsHost_PreviewDragEnter"
                              PreviewDragOver="TaskbarAppsHost_PreviewDragOver"
                              PreviewDragLeave="TaskbarAppsHost_PreviewDragLeave"
                              PreviewDrop="TaskbarAppsHost_PreviewDrop">
                            <Button x:Name="TaskbarScrollUpButton"
                                    Panel.ZIndex="2"
                                    Style="{StaticResource FocusIconButton}"
                                    IsTabStop="False"
                                    Height="44"
                                    VerticalAlignment="Top"
                                    Margin="0"
                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                    Visibility="Collapsed"
                                    Click="TaskbarScrollUpButton_Click"
                                    AutomationProperties.Name="查看上方应用"
                                    AutomationProperties.HelpText="单击向上滚动一个应用；也可以在应用栏任意位置滚动鼠标滚轮"
                                    ToolTip="查看上方应用 · 应用栏任意位置均可滚动">
                                <TextBlock Style="{StaticResource FocusIconText}"
                                           FontSize="12"
                                           Text="&#xE70E;"/>
                            </Button>

                            <ScrollViewer x:Name="TaskbarAppsScrollViewer"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          ScrollChanged="TaskbarAppsScrollViewer_ScrollChanged">
                                <ItemsControl x:Name="TaskbarAppsItemsControl"
                                              ItemsSource="{Binding TaskbarApps}"
                                              KeyboardNavigation.DirectionalNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        AllowDrop="True"
                                                        PreviewMouseDown="TaskbarApp_PreviewMouseDown"
                                                        PreviewMouseWheel="TaskbarApp_PreviewMouseWheel"
                                                        MouseEnter="TaskbarApp_MouseEnter"
                                                        MouseLeave="TaskbarApp_MouseLeave"
                                                        PreviewKeyDown="TaskbarApp_PreviewKeyDown"
                                                        PreviewMouseLeftButtonDown="TaskbarApp_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="TaskbarApp_PreviewMouseMove"
                                                        DragOver="TaskbarApp_DragOver"
                                                        DragLeave="TaskbarApp_DragLeave"
                                                        Drop="TaskbarApp_Drop"
                                                        Click="TaskbarApp_Click"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        AutomationProperties.HelpText="{Binding AccessibleInteractionHint}"
                                                        ContextMenuOpening="TaskbarApp_ContextMenuOpening">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource FocusIconButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource FocusSurfaceSoftBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAttentionRequested}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource FocusWarningSoftBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFileDropTarget}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource FocusAccentSoftBrush}"/>
                                                                    <Setter Property="BorderThickness"
                                                                            Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Style="{StaticResource FocusCardTitleText}"/>
                                                            <TextBlock Text="{Binding StatusSummary}"
                                                                       Style="{StaticResource FocusMetaText}"/>
                                                            <TextBlock Text="{Binding WindowPreviewText}"
                                                                       Margin="0,6,0,0"
                                                                       Style="{StaticResource FocusCaptionText}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="260"
                                                                       Visibility="{Binding HasWindowPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding InteractionHint}"
                                                                       Margin="0,6,0,0"
                                                                       Style="{StaticResource FocusCaptionText}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                                     Opened="TransientContextMenu_Opened"
                                                                     Closed="TransientContextMenu_Closed"/>
                                                    </Button.ContextMenu>
                                                    <Grid>
                                                        <controls:AppIconPresenter
                                                            Icon="{Binding Icon}"
                                                            DisplayName="{Binding DisplayName}"/>
                                                        <Border Width="16"
                                                                Height="16"
                                                                Margin="-3,-3,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                CornerRadius="{StaticResource FocusControlCornerRadius}"
                                                                Background="{DynamicResource FocusSurfaceStrongBrush}"
                                                                BorderBrush="{DynamicResource FocusStrokeBrush}"
                                                                BorderThickness="1"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding HasShortcutGesture, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ShortcutSlotText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource FocusMetaText}"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border MinWidth="16"
                                                                Height="16"
                                                                Padding="2,0"
                                                                Margin="0,-4,-4,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                CornerRadius="{StaticResource FocusControlCornerRadius}"
                                                                Background="{DynamicResource FocusSurfaceStrongBrush}"
                                                                BorderBrush="{DynamicResource FocusAccentBrightBrush}"
                                                                BorderThickness="1"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding HasMultipleWindows, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding WindowCountBadgeText}"
                                                                       Style="{StaticResource FocusMetaText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource FocusAccentBrightBrush}"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Grid Width="14"
                                                              Height="14"
                                                              Margin="0,-3,-3,0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Top"
                                                              IsHitTestVisible="False"
                                                              Visibility="{Binding IsBackgroundOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              ToolTip="后台运行，无可见窗口"
                                                              AutomationProperties.Name="后台运行，无可见窗口">
                                                            <Ellipse Fill="{DynamicResource FocusSurfaceStrongBrush}"
                                                                     Stroke="{DynamicResource FocusAccentBrightBrush}"
                                                                     StrokeThickness="1"/>
                                                            <Ellipse Width="4"
                                                                     Height="4"
                                                                     Fill="{DynamicResource FocusAccentBrightBrush}"/>
                                                        </Grid>
                                                        <Grid Width="14"
                                                              Height="14"
                                                              Margin="0,0,-3,-3"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Bottom"
                                                              IsHitTestVisible="False"
                                                              Visibility="{Binding IsAttentionRequested, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              ToolTip="此应用需要注意"
                                                              AutomationProperties.Name="此应用需要注意">
                                                            <Ellipse Fill="{DynamicResource FocusWarningBrush}"/>
                                                            <TextBlock Text="&#xE7BA;"
                                                                       Style="{StaticResource FocusIconText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource FocusWarningTextBrush}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"/>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                                <Border Width="4"
                                                        CornerRadius="2"
                                                        Background="{DynamicResource FocusAccentBrightBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="1,0,0,0"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Height" Value="12"/>
                                                            <Setter Property="Opacity" Value="0.58"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFullyMinimized}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.34"/>
                                                                    <Setter Property="Height" Value="7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Height" Value="24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Height="3"
                                                        Margin="7,-1"
                                                        Panel.ZIndex="3"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource FocusAccentBrightBrush}"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding ShowsDropBefore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Border Height="3"
                                                        Margin="7,-1"
                                                        Panel.ZIndex="3"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource FocusAccentBrightBrush}"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding ShowsDropAfter, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button x:Name="TaskbarScrollDownButton"
                                    Panel.ZIndex="2"
                                    Style="{StaticResource FocusIconButton}"
                                    IsTabStop="False"
                                    Height="44"
                                    VerticalAlignment="Bottom"
                                    Margin="0"
                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                    Visibility="Collapsed"
                                    Click="TaskbarScrollDownButton_Click"
                                    AutomationProperties.Name="查看下方应用"
                                    AutomationProperties.HelpText="单击向下滚动一个应用；也可以在应用栏任意位置滚动鼠标滚轮"
                                    ToolTip="查看下方应用 · 应用栏任意位置均可滚动">
                                <TextBlock Style="{StaticResource FocusIconText}"
                                           FontSize="12"
                                           Text="&#xE70D;"/>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Border Height="1" Margin="11,6" Background="{DynamicResource FocusStrokeBrush}"/>
                            <Button x:Name="OrganizerButton"
                                    Style="{StaticResource CompactLabeledEntryButton}"
                                    Tag="CompactFixedEntry"
                                    Click="OrganizerButton_Click"
                                    AutomationProperties.Name="{Binding OrganizerEntryAutomationName}"
                                    AutomationProperties.HelpText="按 Enter 直接展开桌面收纳工作区"
                                    ToolTip="{Binding OrganizerEntryAutomationName}">
                                <Grid Width="48" Height="48">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FocusIconText}"
                                                   HorizontalAlignment="Center"
                                                   Text="&#xE8B7;"/>
                                        <TextBlock Margin="0,-2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource FocusMetaText}"
                                                   Text="收纳"/>
                                    </StackPanel>
                                    <Border Width="3"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusAccentBrightBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsOrganizerEntryActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Border MinWidth="16"
                                             Height="16"
                                             Padding="2,0"
                                             Margin="0,-4,-4,0"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             CornerRadius="{StaticResource FocusControlCornerRadius}"
                                             Background="{DynamicResource FocusSurfaceStrongBrush}"
                                             BorderBrush="{DynamicResource FocusAccentBrightBrush}"
                                             BorderThickness="1"
                                             IsHitTestVisible="False"
                                             Visibility="{Binding HasCollectedDesktopItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding CollectedDesktopItemCountBadgeText}"
                                                   Style="{StaticResource FocusMetaText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource FocusAccentBrightBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button x:Name="TasksButton"
                                    Style="{StaticResource CompactLabeledEntryButton}"
                                    Tag="CompactFixedEntry"
                                    Click="TasksButton_Click"
                                    AutomationProperties.Name="{Binding TasksEntryAutomationName}"
                                    AutomationProperties.HelpText="按 Enter 展开任务工作区；按 Shift+F10 可快速添加到 Inbox"
                                    ToolTip="任务 · 左键打开任务 · 右键快速添加">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                 Opened="TransientContextMenu_Opened"
                                                 Closed="TransientContextMenu_Closed">
                                        <MenuItem Header="快速添加到 Inbox…"
                                                  Click="TaskQuickCaptureMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="48" Height="48">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FocusIconText}"
                                                   HorizontalAlignment="Center"
                                                   Text="&#xE8A5;"/>
                                        <TextBlock Margin="0,-2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource FocusMetaText}"
                                                   Text="任务"/>
                                    </StackPanel>
                                    <Border Width="3"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusAccentBrightBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsTasksEntryActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Border MinWidth="16"
                                            Height="16"
                                            Padding="2,0"
                                            Margin="0,-4,-4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                                            BorderBrush="{DynamicResource FocusAccentBrightBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding HasOpenTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding OpenTaskCountBadgeText}"
                                                   Style="{StaticResource FocusMetaText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource FocusAccentBrightBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button x:Name="StatusCenterButton"
                                    Style="{StaticResource CompactLabeledEntryButton}"
                                    Tag="CompactFixedEntry"
                                    Click="StatusCenterButton_Click"
                                    PreviewMouseWheel="VolumeButton_PreviewMouseWheel"
                                    PreviewMouseDown="StatusCenterButton_PreviewMouseDown"
                                    MouseEnter="StatusCenterButton_MouseEnter"
                                    AutomationProperties.Name="{Binding StatusCenterAutomationName}"
                                    AutomationProperties.HelpText="按 Enter 打开状态中心，按 Shift+Enter 直接打开或收起 Panel 通知；鼠标滚轮调节音量，右键打开快捷菜单，中键播放或暂停媒体">
                                <Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusCenterSummary}"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Shift+点击通知 · 滚轮调音量 · 右键菜单"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                 Opened="TransientContextMenu_Opened"
                                                 Closed="TransientContextMenu_Closed">
                                        <MenuItem Header="{Binding PlacementTarget.DataContext.AudioToggleLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Command="{Binding PlacementTarget.DataContext.ToggleMuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  IsEnabled="{Binding PlacementTarget.DataContext.IsAudioAvailable, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="播放 / 暂停"
                                                  Command="{Binding PlacementTarget.DataContext.SendMediaCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:MediaTransportAction.PlayPause}"/>
                                        <Separator/>
                                        <MenuItem Header="网络与无线 · Panel"
                                                  Tag="{x:Static services:StatusCenterDetail.Network}"
                                                  Click="PanelStatusDetailMenuItem_Click"/>
                                        <MenuItem Header="应用音量 · Panel"
                                                  Tag="{x:Static services:StatusCenterDetail.ApplicationAudio}"
                                                  Click="PanelStatusDetailMenuItem_Click"/>
                                        <MenuItem Header="后台应用与窗口 · Panel"
                                                  Tag="{x:Static services:StatusCenterDetail.Applications}"
                                                  Click="PanelStatusDetailMenuItem_Click"/>
                                        <MenuItem Header="Panel 通知"
                                                  Tag="{x:Static services:StatusCenterDetail.PanelNotifications}"
                                                  Click="PanelStatusDetailMenuItem_Click"/>
                                        <MenuItem Header="输入法 · Panel"
                                                  Tag="{x:Static services:StatusCenterDetail.InputMethod}"
                                                  Click="PanelStatusDetailMenuItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="电源…"
                                                  Click="PowerMenuItem_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="48" Height="48">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FocusIconText}">
                                                    <Setter Property="Text" Value="{Binding AudioGlyph}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReplacementWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource FocusDangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,-2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource FocusMetaText}"
                                                   Text="{Binding AudioCompactValueText}"/>
                                    </StackPanel>
                                    <Border Width="3"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusAccentBrightBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsStatusEntryActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Border MinWidth="16"
                                            Height="16"
                                            Padding="2,0"
                                            Margin="0,-4,-4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusAccentBrightBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding HasUnreadPanelNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding PanelNotificationBadgeText}"
                                                   Style="{StaticResource FocusMetaText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource FocusWarningTextBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button x:Name="TimeButton"
                                    Style="{StaticResource CompactLabeledEntryButton}"
                                    Tag="CompactFixedEntry"
                                    Click="CalendarPanelButton_Click"
                                    PreviewMouseDown="TimeButton_PreviewMouseDown"
                                    AutomationProperties.Name="时间、今日任务与显示桌面"
                                    AutomationProperties.HelpText="按 Enter 打开月历，按 Shift+Enter 或鼠标中键显示桌面，按 Shift+F10 打开显示桌面、日期时间与通知菜单"
                                    ToolTip="时间与今日任务 · Shift+左键或中键显示桌面 · 右键更多">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                 Opened="TransientContextMenu_Opened"
                                                 Closed="TransientContextMenu_Closed">
                                        <MenuItem Header="显示桌面"
                                                  Command="{Binding PlacementTarget.DataContext.ShowDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="调整日期和时间"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DateAndTimeSettings}"/>
                                        <MenuItem Header="通知设置"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.NotificationSettings}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="48" Height="48">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm}}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:M/d}}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                    </StackPanel>
                                    <Border Width="3"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusAccentBrightBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsCalendarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- First-run safety onboarding -->
                <Border Grid.Column="0"
                        Panel.ZIndex="50"
                        Margin="0"
                        Padding="28"
                        CornerRadius="0"
                        Background="{DynamicResource FocusSurfaceStrongBrush}"
                        BorderThickness="0"
                        Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="500">
                            <Border Width="64" Height="64" CornerRadius="{StaticResource FocusCardCornerRadius}" Background="{DynamicResource FocusAccentBrush}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource FocusIconText}" FontSize="28" Text="&#xE7F8;"/>
                            </Border>
                            <TextBlock Text="先用起来，再决定是否替代任务栏"
                                       Margin="0,22,0,10"
                                       Style="{StaticResource FocusPageTitleText}"/>
                            <TextBlock TextWrapping="Wrap"
                                       Style="{StaticResource FocusSecondaryBodyText}"
                                       LineHeight="23"
                                       Text="建议先保留 Windows 任务栏体验 FocusPanel。紧凑栏会保持可见，桌面收纳、任务、番茄钟、AI、应用和系统状态都能正常使用；确认适合后，再从设置中一键接管任务栏。"/>
                            <CheckBox Content="始终显示 76px 紧凑栏（推荐）"
                                      Margin="0,20,0,0"
                                      IsChecked="{Binding KeepCompactDockVisible}"
                                      AutomationProperties.Name="首次启动始终显示紧凑任务栏"/>
                            <TextBlock Margin="24,5,0,0"
                                       Text="无需寻找屏幕热区；常用应用、工作区、状态和时间会一直可见，工作区仍按需展开。"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource FocusCaptionText}"/>
                            <TextBlock Margin="0,14,0,0"
                                       Text="立即接管仍可选择。FocusPanel 不会结束 Explorer；稳定运行时守护器只验证状态，Explorer 重建或抑制层丢失时整次会话最多自动修复一次，再次失效就安全恢复，绝不循环隐藏或反复改写工作区。异常、退出或 Ctrl+Alt+Shift+F10 会恢复原生任务栏。"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource FocusCaptionText}"/>
                            <CheckBox Content="随 Windows 启动 FocusPanel"
                                      Margin="0,12,0,0"
                                      IsChecked="{Binding StartWithWindows}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FocusSecondaryButton}"
                                    Content="立即接管任务栏"
                                    Command="{Binding EnableReplacementCommand}"/>
                            <Button Style="{StaticResource FocusPrimaryButton}"
                                    Margin="10,3,0,3"
                                    Content="开始使用（保留任务栏）"
                                    Command="{Binding SkipOnboardingCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
