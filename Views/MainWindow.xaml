<Window x:Class="FocusPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:FocusPanel.Views"
        xmlns:vm="clr-namespace:FocusPanel.ViewModels"
        mc:Ignorable="d"
        TextElement.Foreground="#1D1D1F"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="{Binding Title}"
        Height="800"
        Visibility="Collapsed">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                        <local:TasksView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
                        <local:PomodoroView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FileOrganizerViewModel}">
                        <local:FileOrganizerView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:OkrViewModel}">
                        <local:OkrView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AIAssistantViewModel}">
                        <local:AIAssistantView />
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F2F4F6F8"/>
            <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="RailBackgroundBrush" Color="#FFEDEFF3"/>
            <SolidColorBrush x:Key="PanelStrokeBrush" Color="#FFD8DCE3"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1D1D1F"/>
            <SolidColorBrush x:Key="AppleBlueBrush" Color="#FF007AFF"/>
            <DropShadowEffect x:Key="PanelShadow" Color="#33000000" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>
            <DropShadowEffect x:Key="SoftShadow" Color="#18000000" BlurRadius="10" ShadowDepth="0" Opacity="0.18"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="FocusPanel"
                        MenuActivation="LeftOrRightClick"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="&#x663E;&#x793A; FocusPanel" Command="{Binding ShowWindowCommand}" />
                    <MenuItem Header="&#x9000;&#x51FA;" Command="{Binding CloseAppCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid>
            <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,100,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm}}"
                               FontSize="96"
                               FontWeight="Light"
                               Foreground="White"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#99000000" BlurRadius="12" ShadowDepth="1" Opacity="0.35"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:D}}"
                               FontSize="24"
                               Foreground="White"
                               Opacity="0.82"
                               HorizontalAlignment="Center"
                               Margin="0,-10,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#99000000" BlurRadius="8" ShadowDepth="1" Opacity="0.25"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border x:Name="SidebarBorder"
                    Width="80"
                    HorizontalAlignment="Right"
                    Background="{StaticResource PanelBackgroundBrush}"
                    Margin="0,10,10,10"
                    CornerRadius="18"
                    Effect="{StaticResource PanelShadow}"
                    BorderBrush="{StaticResource PanelStrokeBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    AllowDrop="True"
                    MouseEnter="Sidebar_MouseEnter"
                    MouseLeave="Sidebar_MouseLeave"
                    DragEnter="Sidebar_DragEnter"
                    DragLeave="Sidebar_DragLeave">

                <Grid Width="800" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="18,14,14,8" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Click="CollapseSidebar_Click"
                                ToolTip="&#x6298;&#x53E0;&#x4FA7;&#x8FB9;&#x680F;"
                                Height="32"
                                Width="32"
                                Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="22" Height="22"/>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FolderStarOutline"
                                                     Width="23"
                                                     Height="23"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"
                                                     Foreground="{StaticResource AppleBlueBrush}"/>
                            <TextBlock Text="&#x684C;&#x9762;&#x6536;&#x7EB3;"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Command="{Binding MinimizeAppCommand}"
                                    ToolTip="&#x6298;&#x53E0;"
                                    Height="32"
                                    Width="32">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                    Command="{Binding CloseAppCommand}"
                                    ToolTip="&#x9000;&#x51FA;"
                                    Height="32"
                                    Width="32"
                                    Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="14,0,0,14"
                                Background="{StaticResource RailBackgroundBrush}"
                                CornerRadius="16"
                                Padding="6"
                                VerticalAlignment="Center"
                                BorderBrush="{StaticResource PanelStrokeBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Files" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="&#x684C;&#x9762;&#x6536;&#x7EB3;" Padding="10" Margin="0,3" Height="Auto" materialDesign:ButtonAssist.CornerRadius="12">
                                    <materialDesign:PackIcon Kind="Folder" Width="23" Height="23"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Tasks" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="&#x4EFB;&#x52A1;" Padding="10" Margin="0,3" Height="Auto" materialDesign:ButtonAssist.CornerRadius="12">
                                    <materialDesign:PackIcon Kind="CheckboxMarked" Width="23" Height="23"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Pomodoro" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="&#x756A;&#x8304;&#x949F;" Padding="10" Margin="0,3" Height="Auto" materialDesign:ButtonAssist.CornerRadius="12">
                                    <materialDesign:PackIcon Kind="Timer" Width="23" Height="23"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="OKR" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="OKR" Padding="10" Margin="0,3" Height="Auto" materialDesign:ButtonAssist.CornerRadius="12">
                                    <materialDesign:PackIcon Kind="Target" Width="23" Height="23"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="AI" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="AI &#x52A9;&#x624B;" Padding="10" Margin="0,3" Height="Auto" materialDesign:ButtonAssist.CornerRadius="12">
                                    <materialDesign:PackIcon Kind="Robot" Width="23" Height="23"/>
                                </Button>

                                <Separator Background="{StaticResource PanelStrokeBrush}" Margin="5,8"/>

                                <Grid>
                                    <ToggleButton x:Name="SettingsToggle"
                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                  ToolTip="&#x6570;&#x636E;&#x4E0E;&#x8BBE;&#x7F6E;"
                                                  Padding="10"
                                                  Margin="0,3"
                                                  Height="Auto"
                                                  materialDesign:ButtonAssist.CornerRadius="12">
                                        <materialDesign:PackIcon Kind="DatabaseSettings" Width="23" Height="23"/>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=SettingsToggle}"
                                           Placement="Right"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Margin="8,0,0,0"
                                                Padding="12"
                                                CornerRadius="12"
                                                Background="{StaticResource ContentBackgroundBrush}"
                                                BorderBrush="{StaticResource PanelStrokeBrush}"
                                                BorderThickness="1"
                                                Effect="{StaticResource SoftShadow}">
                                            <StackPanel>
                                                <TextBlock Text="&#x6570;&#x636E;&#x7BA1;&#x7406;" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.65" Margin="8,4,8,8"/>
                                                <Button Command="{Binding RestoreDatabaseCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="BackupRestore" Margin="0,0,12,0" Foreground="Orange" VerticalAlignment="Center"/>
                                                        <TextBlock Text="&#x6062;&#x590D;&#x6570;&#x636E;&#x5E93;" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ContentArea"
                                Grid.Column="1"
                                Margin="14,0,14,14"
                                Background="{StaticResource ContentBackgroundBrush}"
                                CornerRadius="16"
                                Padding="12"
                                Opacity="0"
                                BorderBrush="{StaticResource PanelStrokeBrush}"
                                BorderThickness="1">
                            <ContentControl Content="{Binding CurrentViewModel}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
