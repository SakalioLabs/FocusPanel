<Window x:Class="FocusPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:FocusPanel.Views"
        xmlns:controls="clr-namespace:FocusPanel.Controls"
        xmlns:vm="clr-namespace:FocusPanel.ViewModels"
        xmlns:services="clr-namespace:FocusPanel.Services"
        mc:Ignorable="d"
        Title="FocusPanel"
        Width="76"
        Height="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <local:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <local:TasksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
            <local:PomodoroView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileOrganizerViewModel}">
            <local:FileOrganizerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OkrViewModel}">
            <local:OkrView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AIAssistantViewModel}">
            <local:AIAssistantView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspaceLoadingViewModel}">
            <Grid>
                <StackPanel Width="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar Height="4"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar"
                                   BasedOn="{StaticResource FocusLinearProgress}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Margin="0,18,0,0"
                               Text="{Binding Message}"
                               TextAlignment="Center"
                               Style="{StaticResource FocusSecondaryBodyText}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="FocusPanel · Ctrl+Alt+Shift+F10 恢复系统任务栏"
                        MenuActivation="LeftOrRightClick"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource FocusContextMenu}"
                             Opened="TransientContextMenu_Opened"
                             Closed="TransientContextMenu_Closed">
                    <MenuItem Header="显示 FocusPanel" Command="{Binding ShowWindowCommand}"/>
                    <MenuItem Header="恢复原任务栏设置" Command="{Binding DisableReplacementCommand}"/>
                    <Separator/>
                    <MenuItem Header="退出" Command="{Binding CloseAppCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border x:Name="ShellBorder"
                Margin="0"
                CornerRadius="0"
                Background="{DynamicResource FocusShellTintBrush}"
                BorderThickness="0"
                MouseEnter="Shell_MouseEnter"
                MouseLeave="Shell_MouseLeave"
                LostKeyboardFocus="Shell_LostKeyboardFocus"
                AllowDrop="True"
                DragEnter="Sidebar_DragEnter"
                DragLeave="Sidebar_DragLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>

                <!-- Expandable FocusPanel workspace -->
                <Grid x:Name="WorkspaceHost"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      Margin="12,12,2,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSectionTitle}"
                                       Style="{StaticResource FocusSectionTitleText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ToggleWorkspacePinCommand}"
                                    AutomationProperties.Name="{Binding WorkspacePinActionText}"
                                    ToolTip="{Binding WorkspacePinActionText}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource FocusIconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkspacePinned}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource FocusAccentSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Style="{StaticResource FocusIconText}"
                                           Text="&#xE840;"/>
                            </Button>
                            <Button Style="{StaticResource FocusIconButton}"
                                    Click="CollapseSidebar_Click"
                                    AutomationProperties.Name="收回工作区"
                                    ToolTip="收回工作区">
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE72B;"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="WorkspaceSurface"
                            Grid.Row="1"
                            Padding="0"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0">
                        <ContentControl Content="{Binding CurrentViewModel}"/>
                    </Border>

                    <!-- Search overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="10"
                            Margin="8,56,14,8"
                            Padding="18"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="应用、窗口、待办、命令与计算"
                                       Style="{StaticResource FocusSectionTitleText}"/>
                            <Grid Grid.Row="1" Margin="0,14,0,12">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource FocusSearchBox}"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         AutomationProperties.Name="搜索应用、窗口、待办、系统命令与计算"
                                         AutomationProperties.HelpText="输入应用名、窗口标题、已有待办、系统工具、音量、媒体、专注或任务命令、算式，使用上下方向键选择，按回车执行"
                                         ToolTip="搜索应用、窗口和已有待办，直接控制媒体、完成待办、收集任务、调音量、开始专注或计算"/>
                                <TextBlock Text="输入应用、窗口、待办、音量、媒体或系统命令"
                                           Margin="16,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource FocusSecondaryBodyText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <ListBox x:Name="SearchResultsList"
                                         ItemsSource="{Binding SearchResults}"
                                         SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                         Style="{StaticResource FocusListBox}"
                                         Foreground="{DynamicResource FocusTextBrush}"
                                         AutomationProperties.Name="应用、窗口、待办、系统命令与计算结果"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"
                                               BasedOn="{StaticResource FocusListBoxItem}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,3"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="64" Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.ColumnSpan="2"
                                                        Style="{StaticResource FocusRowButton}"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Foreground="{DynamicResource FocusTextBrush}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DataContext.ExecuteSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="30"
                                                              Height="30">
                                                            <controls:AppIconPresenter
                                                                Icon="{Binding Icon}"
                                                                DisplayName="{Binding DisplayName}">
                                                                <controls:AppIconPresenter.Style>
                                                                    <Style TargetType="controls:AppIconPresenter">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesGlyph}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:AppIconPresenter.Style>
                                                            </controls:AppIconPresenter>
                                                            <Border Background="{DynamicResource FocusAccentSoftBrush}"
                                                                    CornerRadius="{StaticResource FocusControlCornerRadius}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesGlyph}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Glyph}"
                                                                           Style="{StaticResource FocusIconText}"
                                                                           FontSize="15"
                                                                           Foreground="{DynamicResource FocusAccentBrightBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{DynamicResource FocusTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Margin="0,3,0,0"
                                                                       Style="{StaticResource FocusSecondaryBodyText}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource FocusIconText}"
                                                           FontSize="16"
                                                           Text="&#xE72A;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding IsWindow, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource FocusIconButton}"
                                                        Width="40"
                                                        Height="40"
                                                        ToolTip="固定或取消固定"
                                                        AutomationProperties.Name="固定或取消固定应用"
                                                        Command="{Binding DataContext.ToggleSearchPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanTogglePin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource FocusIconText}" FontSize="16" Text="&#xE840;"/>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource FocusIconButton}"
                                                        Width="40"
                                                        Height="40"
                                                        ToolTip="直接完成任务"
                                                        AutomationProperties.Name="完成这条待办任务"
                                                        Command="{Binding DataContext.CompleteSearchTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanCompleteTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource FocusIconText}"
                                                               FontSize="16"
                                                               Text="&#xE73E;"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding AppSearchStatusText}"
                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsAppSearchStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Focus center -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="11"
                            Width="390"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="0,10,14,10"
                            Padding="22"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsFocusCenterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Focus 中心"
                                           Style="{StaticResource FocusSectionTitleText}"/>
                                <Button Margin="0,14,0,0"
                                        Height="50"
                                        Style="{StaticResource FocusPrimaryButton}"
                                        Content="打开今日概览"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Dashboard"/>
                                <Button Height="64"
                                        Margin="0,12,0,0"
                                        Padding="14,0"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        Click="SettingsMenuItem_Click"
                                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="打开设置并安装更新">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat=可更新到 v{0}}"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource FocusCardTitleText}"
                                                   Foreground="{DynamicResource FocusAccentBrightBrush}"/>
                                        <TextBlock Text="打开设置一键安装"
                                                   Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FocusCenterLastWorkspaceButton"
                                        Margin="0,14,0,10"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        AutomationProperties.Name="{Binding CurrentSectionTitle, StringFormat=打开最近使用的模块：{0}}"
                                        Command="{Binding OpenLastWorkspaceCommand}">
                                    <TextBlock Text="{Binding CurrentSectionTitle, StringFormat=最近使用 · {0}}"/>
                                </Button>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="桌面收纳" Command="{Binding NavigateCommand}" CommandParameter="Files"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="任务" Command="{Binding NavigateCommand}" CommandParameter="Tasks"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="番茄钟" Command="{Binding NavigateCommand}" CommandParameter="Pomodoro"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="OKR" Command="{Binding NavigateCommand}" CommandParameter="OKR"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="AI 助手" Command="{Binding NavigateCommand}" CommandParameter="AI"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="设置与更新" Click="SettingsMenuItem_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Status center -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="11"
                            Width="390"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="0,10,14,10"
                            Padding="22"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsStatusCenterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="状态中心"
                                           Style="{StaticResource FocusSectionTitleText}"/>
                                <TextBlock Text="{Binding ReplacementStatus}"
                                           Margin="0,5,0,12"
                                           Style="{StaticResource FocusSecondaryBodyText}"/>
                                <TextBlock Text="{Binding ReplacementError}" Margin="0,0,0,10"
                                           Foreground="{DynamicResource FocusDangerBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SystemActionMessage}"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource FocusDangerBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Assertive"/>
                                <Button Style="{StaticResource FocusSecondaryButton}" Content="重新接管任务栏"
                                        Command="{Binding EnableReplacementCommand}"
                                        Visibility="{Binding HasReplacementWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Grid Margin="0,14,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FocusIconText}"
                                               Text="{Binding NetworkGlyph}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding NetworkSummary}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding NetworkDisplayName}"
                                                   Style="{StaticResource FocusCardTitleText}"/>
                                        <TextBlock Text="{Binding NetworkDetail}"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                    </StackPanel>
                                    <Button x:Name="StatusCenterQuickSettingsButton"
                                            Grid.Column="2"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Content="快捷设置"
                                            Command="{Binding OpenQuickSettingsCommand}"/>
                                </Grid>
                                <UniformGrid Columns="2"
                                             Margin="0,0,0,4">
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="{Binding WiFiRadioActionText}"
                                            Command="{Binding ToggleWiFiRadioCommand}"
                                            IsEnabled="{Binding CanToggleWiFiRadio}"
                                            AutomationProperties.Name="{Binding WiFiRadioActionText}"
                                            ToolTip="直接切换 Wi‑Fi Radio；不可用时使用上方快捷设置"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="{Binding BluetoothRadioActionText}"
                                            Command="{Binding ToggleBluetoothRadioCommand}"
                                            IsEnabled="{Binding CanToggleBluetoothRadio}"
                                            AutomationProperties.Name="{Binding BluetoothRadioActionText}"
                                            ToolTip="直接切换蓝牙 Radio；不可用时使用上方快捷设置"/>
                                </UniformGrid>
                                <TextBlock Margin="4,0,0,12"
                                           Text="{Binding RadioStatusText}"
                                           Style="{StaticResource FocusCaptionText}"
                                           TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource FocusIconButton}"
                                            Command="{Binding ToggleMuteCommand}"
                                            IsEnabled="{Binding IsAudioAvailable}"
                                            ToolTip="{Binding AudioToggleLabel}"
                                            AutomationProperties.Name="{Binding AudioToggleLabel}">
                                        <TextBlock Style="{StaticResource FocusIconText}"
                                                   Text="{Binding AudioGlyph}"/>
                                    </Button>
                                    <Slider Grid.Column="1" Margin="8,0,14,0" Minimum="0" Maximum="1"
                                            IsEnabled="{Binding IsAudioAvailable}"
                                            Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="3"
                                               Margin="4,5,0,0"
                                               Text="{Binding AudioStatusText}"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="4,0,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="应用音量"
                                               Style="{StaticResource FocusCardTitleText}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ApplicationAudioStatusText}"
                                               Style="{StaticResource FocusCaptionText}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ApplicationAudioSessions}"
                                              Margin="0,0,0,12"
                                              AutomationProperties.Name="应用音量混音器">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,8"
                                                    BorderBrush="{DynamicResource FocusStrokeBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="44"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.ColumnSpan="2"
                                                               Margin="6,0,0,2"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource FocusCardTitleText}">
                                                        <TextBlock.ToolTip>
                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource FocusAccentBrush}"
                                                               Text="正在播放"
                                                               Style="{StaticResource FocusMetaText}"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Button Grid.Row="1"
                                                            Style="{StaticResource FocusIconButton}"
                                                            Command="{Binding DataContext.ToggleApplicationAudioMuteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding MuteActionLabel}"
                                                            AutomationProperties.Name="{Binding MuteActionLabel}">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"
                                                                       BasedOn="{StaticResource FocusIconText}">
                                                                    <Setter Property="Text" Value="&#xE767;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE74F;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Slider Grid.Row="1"
                                                            Grid.Column="1"
                                                            Margin="8,0,14,0"
                                                            Minimum="0"
                                                            Maximum="1"
                                                            Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            AutomationProperties.Name="{Binding DisplayName, StringFormat={}{0} 音量}"/>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Volume, StringFormat={}{0:P0}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,0,0,12"
                                      AutomationProperties.Name="{Binding BrightnessSummary}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FocusIconText}"
                                               Text="&#xE706;"
                                               ToolTip="显示亮度"/>
                                    <Slider Grid.Column="1"
                                            Margin="8,0,14,0"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding IsBrightnessAvailable}"
                                            Value="{Binding BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="内置显示器亮度"/>
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding BrightnessPercent, StringFormat={}{0}%}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="3"
                                               Margin="4,5,0,0"
                                               Text="{Binding BrightnessStatusText}"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock Text="媒体控制"
                                           Margin="4,2,0,7"
                                           Style="{StaticResource FocusCaptionText}"/>
                                <UniformGrid Columns="3"
                                             Margin="0,0,0,12">
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="上一首"
                                            Command="{Binding SendMediaCommandCommand}"
                                            CommandParameter="{x:Static services:MediaTransportAction.PreviousTrack}"
                                            AutomationProperties.Name="播放上一首"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="播放 / 暂停"
                                            Command="{Binding SendMediaCommandCommand}"
                                            CommandParameter="{x:Static services:MediaTransportAction.PlayPause}"
                                            AutomationProperties.Name="播放或暂停媒体"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="下一首"
                                            Command="{Binding SendMediaCommandCommand}"
                                            CommandParameter="{x:Static services:MediaTransportAction.NextTrack}"
                                            AutomationProperties.Name="播放下一首"/>
                                </UniformGrid>
                                <Grid Visibility="{Binding HasBattery, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FocusIconText}"
                                               Text="{Binding BatteryGlyph}"/>
                                    <ProgressBar Grid.Column="1"
                                                 Height="6"
                                                 Margin="8,0,14,0"
                                                 Maximum="100"
                                                 Value="{Binding BatteryPercent}"
                                                 AutomationProperties.Name="{Binding BatterySummary}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding BatteryValueText}"/>
                                </Grid>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            Content="{Binding InputSwitcherLabel}"
                                            Command="{Binding OpenInputSwitcherCommand}"
                                            ToolTip="{Binding InputSwitcherSummary}"
                                            AutomationProperties.Name="{Binding InputSwitcherSummary}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="通知中心" Command="{Binding OpenNotificationsCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="显示桌面" Command="{Binding ShowDesktopCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="锁定" Command="{Binding LockComputerCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}" Content="睡眠" Command="{Binding SleepComputerCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            Content="电源"
                                            Click="PowerMenuItem_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Calendar and daily overview -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="11"
                            Width="430"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,8"
                            Padding="22"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsCalendarOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <local:CalendarPanelView/>
                    </Border>

                    <!-- Settings overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="12"
                            Width="420"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,8"
                            MaxHeight="760"
                            Padding="20"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                          <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="系统与恢复"
                                       Style="{StaticResource FocusSectionTitleText}"/>
                            <TextBlock Text="紧急恢复：Ctrl + Alt + Shift + F10"
                                       Margin="0,6,0,16"
                                       Style="{StaticResource FocusCaptionText}"/>
                             <Border Style="{StaticResource FocusCard}" Margin="0,0,0,12">
                                 <StackPanel>
                                     <TextBlock Text="侧边任务栏完整替代"
                                                Style="{StaticResource FocusCardTitleText}"/>
                                    <TextBlock Margin="0,4,0,10"
                                               Text="{Binding ReplacementStatus}"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <TextBlock Margin="0,0,0,10"
                                               Text="{Binding ReplacementError}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource FocusDangerBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SettingsEnableReplacementButton"
                                                Style="{StaticResource FocusPrimaryButton}"
                                                Content="启用"
                                                Command="{Binding EnableReplacementCommand}"/>
                                        <Button Style="{StaticResource FocusSecondaryButton}"
                                                Margin="8,3,0,3"
                                                Content="恢复原任务栏设置"
                                                Command="{Binding DisableReplacementCommand}"/>
                                    </StackPanel>
                                 </StackPanel>
                             </Border>
                            <Border Style="{StaticResource FocusCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="外观与交互"
                                               Style="{StaticResource FocusCardTitleText}"/>
                                    <TextBlock Text="主题"
                                               Margin="0,10,0,5"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <ComboBox SelectedValuePath="Tag"
                                              SelectedValue="{Binding ThemeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="跟随系统" Tag="System"/>
                                        <ComboBoxItem Content="浅色" Tag="Light"/>
                                        <ComboBoxItem Content="深色" Tag="Dark"/>
                                    </ComboBox>
                                    <TextBlock Text="Panel 所在屏幕"
                                               Margin="0,12,0,5"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <ComboBox ItemsSource="{Binding DisplayTargetOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding DisplayTargetMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    </ComboBox>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Panel、右缘热区和运行指示条会一起迁移。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <CheckBox Margin="0,12,0,0"
                                              Content="全屏应用前台时停用鼠标热区"
                                              IsChecked="{Binding DisableHotZoneInFullscreen}"/>
                                    <CheckBox Margin="0,8,0,0"
                                              Content="启用 Ctrl + Alt + 1…9 全局快速应用键"
                                              IsChecked="{Binding EnableTaskbarSlotHotkeys}"/>
                                    <CheckBox Margin="0,8,0,0"
                                              Content="随 Windows 启动 FocusPanel"
                                              IsChecked="{Binding StartWithWindows}"/>
                                    <TextBlock Margin="24,5,0,0"
                                               Text="{Binding StartupStatus}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding SummonShortcutText}"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding TaskbarSlotShortcutText}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <Border x:Name="ProtectedFilesWarning"
                                            Margin="0,12,0,0"
                                            Padding="10"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Background="{DynamicResource FocusWarningSoftBrush}"
                                            BorderBrush="{DynamicResource FocusWarningBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding ShowsProtectedSystemFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource FocusWarningTextBrush}"
                                                   Text="当前 Explorer 已启用“显示受保护的系统文件”。收纳项目仍会保留在原路径，因此无法保证桌面图标不可见；关闭该系统选项后会立即按收纳状态隐藏。"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FocusCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="软件更新"
                                                   Style="{StaticResource FocusCardTitleText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentAppVersion, StringFormat=v{0}}"
                                                   Style="{StaticResource FocusMetaText}"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="更新源"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   Text="GitHub Releases · 静态清单"
                                                   Foreground="{DynamicResource FocusTextBrush}"/>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,10"
                                               Text="{Binding UpdateStatus}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <ProgressBar Height="5"
                                                 Margin="0,0,0,10"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding UpdateProgress}"
                                                 Visibility="{Binding IsUpdateBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Command="{Binding CheckAndInstallUpdateCommand}"
                                            Content="一键检查并安装更新">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FocusPrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdateBusy}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Content" Value="正在更新…"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Margin="0,8,0,0"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Command="{Binding OpenUpdateDownloadPageCommand}"
                                            Content="打开官方下载页"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource FocusSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="从最新备份恢复数据库"
                                    Command="{Binding RestoreDatabaseCommand}"/>
                            <Button Style="{StaticResource FocusDangerButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="退出 FocusPanel"
                                    Command="{Binding CloseAppCommand}"/>
                          </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Power overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="13"
                            Width="320"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,8"
                            Padding="18"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsPowerMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="电源"
                                       Margin="4,0,0,10"
                                       Style="{StaticResource FocusSectionTitleText}"/>
                            <Button x:Name="PowerMenuLockButton"
                                    Style="{StaticResource FocusSecondaryButton}"
                                    HorizontalContentAlignment="Left"
                                    Content="锁定"
                                    Command="{Binding LockComputerCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Content="睡眠" Command="{Binding SleepComputerCommand}"/>
                            <Button Style="{StaticResource FocusSecondaryButton}" HorizontalContentAlignment="Left" Content="重启…" Command="{Binding RestartComputerCommand}"/>
                            <Button Style="{StaticResource FocusDangerButton}" HorizontalContentAlignment="Left" Content="关机…" Command="{Binding ShutdownComputerCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Compact app dock -->
                <Border Grid.Column="1"
                        Margin="10,12,10,12"
                        CornerRadius="0"
                        Background="Transparent"
                        BorderThickness="0"
                        KeyboardNavigation.TabNavigation="Cycle"
                        KeyboardNavigation.DirectionalNavigation="Cycle"
                        AutomationProperties.Name="FocusPanel 侧边任务栏">
                    <Grid Margin="0,3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Button x:Name="StartButton"
                                    Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Command="{Binding OpenStartMenuCommand}"
                                    AutomationProperties.Name="开始"
                                    AutomationProperties.HelpText="按 Enter 打开开始菜单，按 Shift+F10 打开系统管理菜单"
                                    ToolTip="开始 · 右键打开系统管理菜单">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                 Opened="TransientContextMenu_Opened"
                                                 Closed="TransientContextMenu_Closed">
                                        <MenuItem Header="安装的应用"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.InstalledApps}"/>
                                        <MenuItem Header="电源选项"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.PowerOptions}"/>
                                        <MenuItem Header="事件查看器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.EventViewer}"/>
                                        <MenuItem Header="系统"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.SystemAbout}"/>
                                        <MenuItem Header="设备管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DeviceManager}"/>
                                        <MenuItem Header="网络连接"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.NetworkConnections}"/>
                                        <MenuItem Header="磁盘管理"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DiskManagement}"/>
                                        <MenuItem Header="计算机管理"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.ComputerManagement}"/>
                                        <MenuItem Header="终端"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.Terminal}"/>
                                        <MenuItem Header="终端（管理员）"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.TerminalAdministrator}"/>
                                        <MenuItem Header="任务管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.TaskManager}"/>
                                        <Separator/>
                                        <MenuItem Header="设置"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.Settings}"/>
                                        <MenuItem Header="文件资源管理器"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.FileExplorer}"/>
                                        <MenuItem Header="搜索"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWindowsSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="小组件"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWidgetsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="运行…"
                                                  Command="{Binding PlacementTarget.DataContext.OpenRunDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="关机或注销">
                                            <MenuItem Header="锁定"
                                                      Command="{Binding PlacementTarget.DataContext.LockComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="睡眠"
                                                      Command="{Binding PlacementTarget.DataContext.SleepComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="重启…"
                                                      Command="{Binding PlacementTarget.DataContext.RestartComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="关机…"
                                                      Command="{Binding PlacementTarget.DataContext.ShutdownComputerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </MenuItem>
                                        <MenuItem Header="桌面"
                                                  Command="{Binding PlacementTarget.DataContext.ShowDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE782;"/>
                            </Button>
                            <Button x:Name="SearchButton"
                                    Tag="CompactFixedEntry"
                                    Style="{StaticResource FocusIconButton}"
                                    Click="SearchButton_Click"
                                    Command="{Binding ToggleSearchCommand}"
                                    AutomationProperties.Name="搜索应用"
                                    ToolTip="启动应用">
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE721;"/>
                            </Button>
                            <Border Height="1"
                                    Margin="11,6"
                                    Background="{DynamicResource FocusStrokeBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              x:Name="TaskbarAppsHost"
                              AllowDrop="True"
                              PreviewDragEnter="TaskbarAppsHost_PreviewDragEnter"
                              PreviewDragOver="TaskbarAppsHost_PreviewDragOver"
                              PreviewDragLeave="TaskbarAppsHost_PreviewDragLeave"
                              PreviewDrop="TaskbarAppsHost_PreviewDrop">
                            <Button x:Name="TaskbarScrollUpButton"
                                    Panel.ZIndex="2"
                                    Style="{StaticResource FocusIconButton}"
                                    Height="28"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                    Visibility="Collapsed"
                                    Click="TaskbarScrollUpButton_Click"
                                    AutomationProperties.Name="查看上方应用"
                                    ToolTip="查看上方应用">
                                <TextBlock Style="{StaticResource FocusIconText}"
                                           FontSize="12"
                                           Text="&#xE70E;"/>
                            </Button>

                            <ScrollViewer x:Name="TaskbarAppsScrollViewer"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          ScrollChanged="TaskbarAppsScrollViewer_ScrollChanged">
                                <ItemsControl x:Name="TaskbarAppsItemsControl"
                                              ItemsSource="{Binding TaskbarApps}"
                                              KeyboardNavigation.DirectionalNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        AllowDrop="True"
                                                        PreviewMouseDown="TaskbarApp_PreviewMouseDown"
                                                        PreviewMouseWheel="TaskbarApp_PreviewMouseWheel"
                                                        MouseEnter="TaskbarApp_MouseEnter"
                                                        MouseLeave="TaskbarApp_MouseLeave"
                                                        PreviewKeyDown="TaskbarApp_PreviewKeyDown"
                                                        PreviewMouseLeftButtonDown="TaskbarApp_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="TaskbarApp_PreviewMouseMove"
                                                        DragOver="TaskbarApp_DragOver"
                                                        DragLeave="TaskbarApp_DragLeave"
                                                        Drop="TaskbarApp_Drop"
                                                        Click="TaskbarApp_Click"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        AutomationProperties.HelpText="{Binding InteractionHint}"
                                                        ContextMenuOpening="TaskbarApp_ContextMenuOpening">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource FocusIconButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource FocusSurfaceSoftBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFileDropTarget}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource FocusAccentSoftBrush}"/>
                                                                    <Setter Property="BorderThickness"
                                                                            Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Style="{StaticResource FocusCardTitleText}"/>
                                                            <TextBlock Text="{Binding StatusSummary}"
                                                                       Style="{StaticResource FocusMetaText}"/>
                                                            <TextBlock Text="{Binding WindowPreviewText}"
                                                                       Margin="0,6,0,0"
                                                                       Style="{StaticResource FocusCaptionText}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="260"
                                                                       Visibility="{Binding HasWindowPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding InteractionHint}"
                                                                       Margin="0,6,0,0"
                                                                       Style="{StaticResource FocusCaptionText}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="260"/>
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                                     Opened="TransientContextMenu_Opened"
                                                                     Closed="TransientContextMenu_Closed"/>
                                                    </Button.ContextMenu>
                                                    <Grid>
                                                        <controls:AppIconPresenter
                                                            Icon="{Binding Icon}"
                                                            DisplayName="{Binding DisplayName}"/>
                                                        <Border MinWidth="16"
                                                                Height="16"
                                                                Padding="2,0"
                                                                Margin="0,-4,-4,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                CornerRadius="{StaticResource FocusControlCornerRadius}"
                                                                Background="{DynamicResource FocusSurfaceStrongBrush}"
                                                                BorderBrush="{DynamicResource FocusAccentBrightBrush}"
                                                                BorderThickness="1"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding HasMultipleWindows, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding WindowCountBadgeText}"
                                                                       Style="{StaticResource FocusMetaText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource FocusAccentBrightBrush}"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                                <Border Width="4"
                                                        CornerRadius="2"
                                                        Background="{DynamicResource FocusAccentBrightBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="1,0,0,0"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Height" Value="12"/>
                                                            <Setter Property="Opacity" Value="0.58"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Height" Value="24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Height="3"
                                                        Margin="7,-1"
                                                        Panel.ZIndex="3"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource FocusAccentBrightBrush}"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding ShowsDropBefore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Border Height="3"
                                                        Margin="7,-1"
                                                        Panel.ZIndex="3"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource FocusAccentBrightBrush}"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding ShowsDropAfter, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button x:Name="TaskbarScrollDownButton"
                                    Panel.ZIndex="2"
                                    Style="{StaticResource FocusIconButton}"
                                    Height="28"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,2"
                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                    Visibility="Collapsed"
                                    Click="TaskbarScrollDownButton_Click"
                                    AutomationProperties.Name="查看下方应用"
                                    ToolTip="查看下方应用">
                                <TextBlock Style="{StaticResource FocusIconText}"
                                           FontSize="12"
                                           Text="&#xE70D;"/>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Border Height="1" Margin="11,6" Background="{DynamicResource FocusStrokeBrush}"/>
                            <Button x:Name="TaskViewButton"
                                    Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Command="{Binding OpenTaskViewCommand}"
                                    PreviewMouseWheel="TaskViewButton_PreviewMouseWheel"
                                    AutomationProperties.Name="任务视图"
                                    AutomationProperties.HelpText="按 Enter 打开任务视图；滚轮切换虚拟桌面；右键新建或关闭桌面"
                                    ToolTip="任务视图&#x0a;滚轮：切换虚拟桌面&#x0a;右键：桌面操作">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                 Opened="TransientContextMenu_Opened"
                                                 Closed="TransientContextMenu_Closed">
                                        <MenuItem Header="上一个虚拟桌面"
                                                  InputGestureText="Win+Ctrl+←"
                                                  Command="{Binding PlacementTarget.DataContext.SwitchVirtualDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:VirtualDesktopDirection.Previous}"/>
                                        <MenuItem Header="下一个虚拟桌面"
                                                  InputGestureText="Win+Ctrl+→"
                                                  Command="{Binding PlacementTarget.DataContext.SwitchVirtualDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:VirtualDesktopDirection.Next}"/>
                                        <Separator/>
                                        <MenuItem Header="新建虚拟桌面"
                                                  InputGestureText="Win+Ctrl+D"
                                                  Command="{Binding PlacementTarget.DataContext.CreateVirtualDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="关闭当前虚拟桌面"
                                                  InputGestureText="Win+Ctrl+F4"
                                                  Command="{Binding PlacementTarget.DataContext.CloseCurrentVirtualDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE7C4;"/>
                            </Button>
                            <Button x:Name="FocusCenterButton"
                                    Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Click="FocusCenterButton_Click"
                                    AutomationProperties.Name="Focus 中心"
                                    ToolTip="Focus 中心">
                                <Grid Width="32" Height="32">
                                    <TextBlock Style="{StaticResource FocusIconText}"
                                               Text="&#xE8B7;"/>
                                    <Ellipse Width="8"
                                             Height="8"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Fill="{DynamicResource FocusAccentBrightBrush}"
                                             Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="StatusCenterButton"
                                    Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Click="StatusCenterButton_Click"
                                    PreviewMouseWheel="VolumeButton_PreviewMouseWheel"
                                    PreviewMouseDown="StatusCenterButton_PreviewMouseDown"
                                    MouseRightButtonUp="VolumeButton_MouseRightButtonUp"
                                    AutomationProperties.Name="{Binding StatusCenterAutomationName}"
                                    AutomationProperties.HelpText="鼠标滚轮调节音量，右键静音，中键播放或暂停媒体">
                                <Button.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusCenterSummary}"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="滚轮调音量 · 右键静音 · 中键播放/暂停"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FocusIconText}">
                                            <Setter Property="Text" Value="{Binding AudioGlyph}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasReplacementWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource FocusDangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button x:Name="TimeButton"
                                    Style="{StaticResource FocusIconButton}"
                                    Tag="CompactFixedEntry"
                                    Click="CalendarPanelButton_Click"
                                    AutomationProperties.Name="时间与今日任务"
                                    AutomationProperties.HelpText="按 Enter 打开月历，按 Shift+F10 调整日期时间或通知设置"
                                    ToolTip="时间与今日任务 · 右键打开系统设置">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                 Opened="TransientContextMenu_Opened"
                                                 Closed="TransientContextMenu_Closed">
                                        <MenuItem Header="调整日期和时间"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.DateAndTimeSettings}"/>
                                        <MenuItem Header="通知设置"
                                                  Command="{Binding PlacementTarget.DataContext.OpenManagementToolCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static services:SystemManagementTool.NotificationSettings}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm}}"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:M/d}}"
                                               HorizontalAlignment="Center"
                                               FontSize="9"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- First-run safety onboarding -->
                <Border Grid.Column="0"
                        Panel.ZIndex="50"
                        Margin="0"
                        Padding="28"
                        CornerRadius="0"
                        Background="{DynamicResource FocusSurfaceStrongBrush}"
                        BorderThickness="0"
                        Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" MaxWidth="500">
                            <Border Width="64" Height="64" CornerRadius="{StaticResource FocusCardCornerRadius}" Background="{DynamicResource FocusAccentBrush}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource FocusIconText}" FontSize="28" Text="&#xE7F8;"/>
                            </Border>
                            <TextBlock Text="启用 FocusPanel 侧边任务栏"
                                       Margin="0,22,0,10"
                                       Style="{StaticResource FocusPageTitleText}"/>
                            <TextBlock TextWrapping="Wrap"
                                       Style="{StaticResource FocusSecondaryBodyText}"
                                       LineHeight="23"
                                       Text="FocusPanel 会关闭原生底边呼出、释放主屏工作区，并以空窗口区域与 DWM 合成隐藏两层一次性停用主屏任务栏。守护器只验证状态，不循环隐藏或反复改写工作区；异常、退出或紧急快捷键会完整恢复。Win+A、Win+N、Win+Space 等系统入口仍可使用。"/>
                            <CheckBox Content="随 Windows 启动 FocusPanel"
                                      Margin="0,20,0,0"
                                      IsChecked="{Binding StartWithWindows}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FocusSecondaryButton}"
                                    Content="暂不启用"
                                    Command="{Binding SkipOnboardingCommand}"/>
                            <Button Style="{StaticResource FocusPrimaryButton}"
                                    Margin="10,3,0,3"
                                    Content="启用侧边任务栏"
                                    Command="{Binding EnableReplacementCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
