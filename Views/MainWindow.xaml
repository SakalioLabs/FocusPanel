<Window x:Class="FocusPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FocusPanel.Views"
        xmlns:controls="clr-namespace:FocusPanel.Controls"
        xmlns:converters="clr-namespace:FocusPanel.Converters"
        xmlns:vm="clr-namespace:FocusPanel.ViewModels"
        xmlns:services="clr-namespace:FocusPanel.Services"
        mc:Ignorable="d"
        Title="FocusPanel"
        Width="76"
        Height="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <Style x:Key="CompactLabeledEntryButton"
               TargetType="Button"
               BasedOn="{StaticResource FocusIconButton}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <local:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}">
            <local:TasksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
            <local:PomodoroView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileOrganizerViewModel}">
            <local:FileOrganizerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AIAssistantViewModel}">
            <local:AIAssistantView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspaceLoadingViewModel}">
            <Grid>
                <StackPanel Width="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar Height="4"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar"
                                   BasedOn="{StaticResource FocusLinearProgress}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Margin="0,18,0,0"
                               Text="{Binding Message}"
                               TextAlignment="Center"
                               Style="{StaticResource FocusSecondaryBodyText}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Border x:Name="ShellBorder"
                Margin="0"
                CornerRadius="0"
                Background="{DynamicResource FocusShellTintBrush}"
                BorderThickness="0"
                MouseEnter="Shell_MouseEnter"
                MouseLeave="Shell_MouseLeave"
                LostKeyboardFocus="Shell_LostKeyboardFocus"
                AllowDrop="True"
                DragEnter="Sidebar_DragEnter"
                DragLeave="Sidebar_DragLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>

                <!-- Expandable FocusPanel workspace -->
                <Grid x:Name="WorkspaceHost"
                      Grid.Column="0"
                      Visibility="Collapsed"
                      Margin="12,12,2,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CurrentSectionTitle}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FocusSectionTitleText}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ToggleWorkspacePinCommand}"
                                    AutomationProperties.Name="{Binding WorkspacePinActionText}"
                                    ToolTip="{Binding WorkspacePinActionText}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource FocusIconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkspacePinned}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource FocusAccentSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Style="{StaticResource FocusIconText}"
                                           Text="&#xE840;"/>
                            </Button>
                            <Button Style="{StaticResource FocusIconButton}"
                                    Click="CollapseSidebar_Click"
                                    AutomationProperties.Name="收回工作区"
                                    ToolTip="收回工作区">
                                <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE72B;"/>
                            </Button>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="6"
                                     AutomationProperties.Name="主要功能快捷入口">
                            <RadioButton Margin="2" Height="40"
                                         GroupName="WorkspaceNavigation"
                                         Style="{StaticResource FocusSegmentRadioButton}"
                                         Content="概览"
                                         IsChecked="{Binding IsDashboardWorkspaceActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Dashboard"/>
                            <RadioButton Margin="2" Height="40"
                                         GroupName="WorkspaceNavigation"
                                         Style="{StaticResource FocusSegmentRadioButton}"
                                         Content="桌面收纳"
                                         IsChecked="{Binding IsFilesWorkspaceActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Files"/>
                            <RadioButton Margin="2" Height="40"
                                         GroupName="WorkspaceNavigation"
                                         Style="{StaticResource FocusSegmentRadioButton}"
                                         Content="任务"
                                         IsChecked="{Binding IsTasksWorkspaceActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Tasks"/>
                            <RadioButton Margin="2" Height="40"
                                         GroupName="WorkspaceNavigation"
                                         Style="{StaticResource FocusSegmentRadioButton}"
                                         Content="番茄钟"
                                         IsChecked="{Binding IsPomodoroWorkspaceActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Pomodoro"/>
                            <RadioButton Margin="2" Height="40"
                                         GroupName="WorkspaceNavigation"
                                         Style="{StaticResource FocusSegmentRadioButton}"
                                         Content="AI 助手"
                                         IsChecked="{Binding IsAiWorkspaceActive, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="AI"/>
                            <RadioButton x:Name="SettingsNavigationButton"
                                         Margin="2" Height="40"
                                         GroupName="WorkspaceNavigation"
                                         Style="{StaticResource FocusSegmentRadioButton}"
                                         IsChecked="{Binding IsSettingsWorkspaceActive, Mode=OneWay}"
                                         Click="SettingsMenuItem_Click"
                                         AutomationProperties.Name="FocusPanel 设置">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="设置"/>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="6,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource FocusAccentBrightBrush}"
                                             Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>

                    <Border x:Name="WorkspaceSurface"
                            Grid.Row="1"
                            Padding="0"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0">
                        <ContentControl Content="{Binding CurrentViewModel}"/>
                    </Border>

                    <!-- Search overlay -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="10"
                            Margin="8,100,14,8"
                            Padding="18"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SearchPanelTitle}"
                                           Style="{StaticResource FocusSectionTitleText}"/>
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SearchPanelInstruction}"
                                           Style="{StaticResource FocusCaptionText}"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,14,0,12">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource FocusSearchBox}"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         AutomationProperties.Name="搜索应用、窗口、待办、Panel 运行、系统命令与计算"
                                         AutomationProperties.HelpText="输入应用名、窗口标题、已有待办、系统工具、音量、媒体、专注或任务命令、算式；输入大于号运行程序、文件或网址；使用上下方向键选择，按回车执行"
                                         ToolTip="搜索应用、窗口和已有待办；输入 > 可在 Panel 内运行程序、文件、文件夹或网址"/>
                                <TextBlock Text="{Binding SearchPlaceholder}"
                                           Margin="16,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource FocusSecondaryBodyText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <UniformGrid Grid.Row="2"
                                         Columns="4"
                                         Margin="0,0,0,10"
                                         AutomationProperties.Name="搜索范围">
                                <RadioButton Height="40"
                                             Margin="2"
                                             GroupName="ShellSearchScope"
                                             Style="{StaticResource FocusSegmentRadioButton}"
                                             Content="全部"
                                             IsChecked="{Binding IsAllSearchScope, Mode=OneWay}"
                                             Command="{Binding SelectSearchScopeCommand}"
                                             CommandParameter="All"/>
                                <RadioButton Height="40"
                                             Margin="2"
                                             GroupName="ShellSearchScope"
                                             Style="{StaticResource FocusSegmentRadioButton}"
                                             Content="{Binding OpenWindowScopeLabel}"
                                             IsChecked="{Binding IsWindowSearchScope, Mode=OneWay}"
                                             Command="{Binding SelectSearchScopeCommand}"
                                             CommandParameter="Windows"/>
                                <RadioButton Height="40"
                                             Margin="2"
                                             GroupName="ShellSearchScope"
                                             Style="{StaticResource FocusSegmentRadioButton}"
                                             Content="应用"
                                             IsChecked="{Binding IsApplicationSearchScope, Mode=OneWay}"
                                             Command="{Binding SelectSearchScopeCommand}"
                                             CommandParameter="Applications"/>
                                <RadioButton Height="40"
                                             Margin="2"
                                             GroupName="ShellSearchScope"
                                             Style="{StaticResource FocusSegmentRadioButton}"
                                             Content="系统"
                                             IsChecked="{Binding IsSystemSearchScope, Mode=OneWay}"
                                             Command="{Binding SelectSearchScopeCommand}"
                                             CommandParameter="System"/>
                            </UniformGrid>
                            <Grid Grid.Row="3"
                                  Margin="2,0,2,10"
                                  Visibility="{Binding IsWindowSearchScope, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="虚拟桌面快捷操作">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="4,0,12,0"
                                           VerticalAlignment="Center"
                                           Text="虚拟桌面"
                                           Style="{StaticResource FocusCaptionText}"/>
                                <UniformGrid Grid.Column="1"
                                             Columns="4">
                                    <Button MinHeight="44"
                                            Margin="2,0"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Content="上一个"
                                            ToolTip="切换到上一个虚拟桌面 · Win+Ctrl+←"
                                            AutomationProperties.Name="切换到上一个虚拟桌面"
                                            Command="{Binding SwitchVirtualDesktopCommand}"
                                            CommandParameter="{x:Static services:VirtualDesktopDirection.Previous}"/>
                                    <Button MinHeight="44"
                                            Margin="2,0"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Content="新建"
                                            ToolTip="新建虚拟桌面 · Win+Ctrl+D"
                                            AutomationProperties.Name="新建虚拟桌面"
                                            Command="{Binding CreateVirtualDesktopCommand}"/>
                                    <Button MinHeight="44"
                                            Margin="2,0"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Content="下一个"
                                            ToolTip="切换到下一个虚拟桌面 · Win+Ctrl+→"
                                            AutomationProperties.Name="切换到下一个虚拟桌面"
                                            Command="{Binding SwitchVirtualDesktopCommand}"
                                            CommandParameter="{x:Static services:VirtualDesktopDirection.Next}"/>
                                    <Button MinHeight="44"
                                            Margin="2,0"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Content="关闭…"
                                            ToolTip="关闭当前虚拟桌面 · 应用不会被关闭"
                                            AutomationProperties.Name="关闭当前虚拟桌面"
                                            Click="CloseCurrentVirtualDesktop_Click"/>
                                </UniformGrid>
                            </Grid>
                            <WrapPanel Grid.Row="4"
                                       Margin="0,0,0,8"
                                       AutomationProperties.Name="搜索示例，点击后可编辑并按回车执行">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreSearchSuggestionsVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <TextBlock Text="试试"
                                           Margin="4,0,7,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FocusCaptionText}"/>
                                <Button Height="36"
                                        Margin="3,0"
                                        Padding="12,0"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        Content="任务管理器"
                                        Tag="任务管理器"
                                        Click="SearchSuggestion_Click"
                                        ToolTip="填入搜索框，按 Enter 执行"/>
                                <Button Height="36"
                                        Margin="3,0"
                                        Padding="12,0"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        Content="运行"
                                        Tag=">"
                                        Click="SearchSuggestion_Click"
                                        ToolTip="在 > 后输入程序、文件夹、文件或网址"/>
                                <Button Height="36"
                                        Margin="3,0"
                                        Padding="12,0"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        Content="音量 50"
                                        Tag="音量 50"
                                        Click="SearchSuggestion_Click"
                                        ToolTip="填入搜索框，按 Enter 执行"/>
                                <Button Height="36"
                                        Margin="3,0"
                                        Padding="12,0"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        Content="专注 25"
                                        Tag="专注 25"
                                        Click="SearchSuggestion_Click"
                                        ToolTip="填入搜索框，按 Enter 执行"/>
                                <Button Height="36"
                                        Margin="3,0"
                                        Padding="12,0"
                                        Style="{StaticResource FocusSecondaryButton}"
                                        Content="新建任务"
                                        Tag="任务："
                                        Click="SearchSuggestion_Click"
                                        ToolTip="填入任务前缀，继续输入标题后按 Enter"/>
                            </WrapPanel>
                            <Border Grid.Row="4"
                                    Height="44"
                                    Margin="0,0,0,8"
                                    Padding="12,0,4,0"
                                    CornerRadius="{StaticResource FocusControlCornerRadius}"
                                    Background="{DynamicResource FocusAccentSoftBrush}"
                                    Visibility="{Binding IsWindowApplicationFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="按应用筛选窗口">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FocusIconText}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource FocusAccentBrightBrush}"
                                                   Text="&#xE71D;"/>
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding WindowApplicationFilterText}"
                                                   Foreground="{DynamicResource FocusTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Height="36"
                                            MinWidth="88"
                                            Padding="12,0"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Content="查看全部"
                                            ToolTip="清除应用筛选，显示全部窗口"
                                            AutomationProperties.Name="查看全部窗口"
                                            Command="{Binding ClearWindowApplicationFilterCommand}"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="5">
                                <ListBox x:Name="SearchResultsList"
                                         ItemsSource="{Binding SearchResults}"
                                         SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                         Style="{StaticResource FocusListBox}"
                                         Foreground="{DynamicResource FocusTextBrush}"
                                         AutomationProperties.Name="应用、窗口、待办、Panel 运行、系统命令与计算结果"
                                         PreviewKeyDown="SearchResultsList_PreviewKeyDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"
                                               BasedOn="{StaticResource FocusListBoxItem}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,3"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="64"
                                                  Margin="10,0"
                                                  MouseEnter="SearchResult_MouseEnter"
                                                  MouseLeave="SearchResult_MouseLeave"
                                                  ContextMenuOpening="SearchWindow_ContextMenuOpening">
                                                <Grid.ContextMenu>
                                                    <ContextMenu Style="{StaticResource FocusContextMenu}"/>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.ColumnSpan="2"
                                                        Style="{StaticResource FocusRowButton}"
                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Foreground="{DynamicResource FocusTextBrush}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DataContext.ExecuteSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="30"
                                                              Height="30">
                                                            <controls:AppIconPresenter
                                                                Icon="{Binding Icon}"
                                                                DisplayName="{Binding DisplayName}">
                                                                <controls:AppIconPresenter.Style>
                                                                    <Style TargetType="controls:AppIconPresenter">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesGlyph}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:AppIconPresenter.Style>
                                                            </controls:AppIconPresenter>
                                                            <Border Background="{DynamicResource FocusAccentSoftBrush}"
                                                                    CornerRadius="{StaticResource FocusControlCornerRadius}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesGlyph}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Glyph}"
                                                                           Style="{StaticResource FocusIconText}"
                                                                           FontSize="15"
                                                                           Foreground="{DynamicResource FocusAccentBrightBrush}"/>
                                                            </Border>
                                                            <Grid Width="12"
                                                                  Height="12"
                                                                  Margin="0,0,-2,-2"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Bottom"
                                                                  IsHitTestVisible="False"
                                                                  Visibility="{Binding IsAttentionRequested, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                  AutomationProperties.Name="此窗口需要注意">
                                                                <Ellipse Fill="{DynamicResource FocusWarningBrush}"/>
                                                                <TextBlock Text="&#xE7BA;"
                                                                           Style="{StaticResource FocusIconText}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource FocusWarningTextBrush}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"/>
                                                            </Grid>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="10,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{DynamicResource FocusTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Margin="0,3,0,0"
                                                                       Style="{StaticResource FocusSecondaryBodyText}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource FocusIconButton}"
                                                        Width="40"
                                                        Height="40"
                                                        Click="SearchWindowPreviewButton_Click"
                                                        ToolTip="打开实时窗口缩略图"
                                                        AutomationProperties.Name="打开此窗口的实时缩略图"
                                                        Visibility="{Binding IsWindow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource FocusIconText}"
                                                               FontSize="14"
                                                               Text="&#xE7B3;"/>
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource FocusIconButton}"
                                                        Width="40"
                                                        Height="40"
                                                        ToolTip="{Binding DisplayName, StringFormat=关闭窗口：{0}}"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat=关闭窗口 {0}}"
                                                        Command="{Binding DataContext.CloseWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Window}"
                                                        Visibility="{Binding IsWindow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource FocusIconText}"
                                                               FontSize="12"
                                                               Text="&#xE711;"/>
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource FocusIconButton}"
                                                        Width="40"
                                                        Height="40"
                                                        ToolTip="固定或取消固定"
                                                        AutomationProperties.Name="固定或取消固定应用"
                                                        Command="{Binding DataContext.ToggleSearchPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanTogglePin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource FocusIconText}" FontSize="16" Text="&#xE840;"/>
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource FocusIconButton}"
                                                        Width="40"
                                                        Height="40"
                                                        ToolTip="直接完成任务"
                                                        AutomationProperties.Name="完成这条待办任务"
                                                        Command="{Binding DataContext.CompleteSearchTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanCompleteTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource FocusIconText}"
                                                               FontSize="16"
                                                               Text="&#xE73E;"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding AppSearchStatusText}"
                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsAppSearchStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Status center -->
                    <Border Grid.RowSpan="2"
                            Panel.ZIndex="11"
                            Width="390"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="0,10,14,10"
                            Padding="22"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsStatusCenterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="状态中心"
                                           Style="{StaticResource FocusSectionTitleText}"/>
                                <TextBlock Text="{Binding ReplacementStatus}"
                                           Margin="0,5,0,12"
                                           Style="{StaticResource FocusSecondaryBodyText}"/>
                                <TextBlock Text="{Binding ReplacementError}" Margin="0,0,0,10"
                                           Foreground="{DynamicResource FocusDangerBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SystemActionMessage}"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource FocusDangerBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Assertive"/>
                                <Button Style="{StaticResource FocusSecondaryButton}" Content="重新接管任务栏"
                                        Command="{Binding EnableReplacementCommand}"
                                        Visibility="{Binding HasReplacementWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="常用"
                                           Margin="4,14,0,7"
                                           Style="{StaticResource FocusCaptionText}"/>
                                <ToggleButton x:Name="StatusCenterWindowOverviewButton"
                                              Style="{StaticResource FocusToggleButton}"
                                              MinHeight="44"
                                              Margin="0,0,0,8"
                                              HorizontalContentAlignment="Stretch"
                                              Tag="{x:Static services:StatusCenterDetail.Applications}"
                                              IsChecked="{Binding IsExpanded, ElementName=ApplicationsDetailsExpander, Mode=OneWay}"
                                              Click="StatusCenterDetailButton_Click"
                                              AutomationProperties.Name="展开 Panel 自有后台应用与窗口"
                                              ToolTip="只展开 Panel 自有应用抽屉，不调用 Windows 任务栏或隐藏图标抽屉">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8FD;"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FocusIconText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="后台应用与窗口"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FocusCardTitleText}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TaskbarApps.Count, StringFormat={}{0} 项}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                    </Grid>
                                </ToggleButton>
                                <UniformGrid Columns="5"
                                             Margin="0,0,0,12"
                                             AutomationProperties.Name="Panel 状态详情">
                                    <ToggleButton Style="{StaticResource FocusToggleButton}"
                                                  MinHeight="44"
                                                  Content="网络"
                                                  Tag="{x:Static services:StatusCenterDetail.Network}"
                                                  IsChecked="{Binding IsExpanded, ElementName=NetworkDetailsExpander, Mode=OneWay}"
                                                  Click="StatusCenterDetailButton_Click"
                                                  AutomationProperties.Name="展开网络与无线详情"/>
                                    <ToggleButton Style="{StaticResource FocusToggleButton}"
                                                  MinHeight="44"
                                                  Content="应用音量"
                                                  Tag="{x:Static services:StatusCenterDetail.ApplicationAudio}"
                                                  IsChecked="{Binding IsExpanded, ElementName=ApplicationAudioDetailsExpander, Mode=OneWay}"
                                                  Click="StatusCenterDetailButton_Click"
                                                  AutomationProperties.Name="展开应用音量详情"/>
                                    <ToggleButton Style="{StaticResource FocusToggleButton}"
                                                  MinHeight="44"
                                                  Content="媒体"
                                                  Tag="{x:Static services:StatusCenterDetail.MediaAndBattery}"
                                                  IsChecked="{Binding IsExpanded, ElementName=MediaBatteryDetailsExpander, Mode=OneWay}"
                                                  Click="StatusCenterDetailButton_Click"
                                                  AutomationProperties.Name="展开媒体与电池详情"/>
                                    <ToggleButton Style="{StaticResource FocusToggleButton}"
                                                  MinHeight="44"
                                                  Content="输入法"
                                                  Tag="{x:Static services:StatusCenterDetail.InputMethod}"
                                                  IsChecked="{Binding IsExpanded, ElementName=InputMethodDetailsExpander, Mode=OneWay}"
                                                  Click="StatusCenterDetailButton_Click"
                                                  ToolTip="{Binding InputSwitcherSummary}"
                                                  AutomationProperties.Name="展开 Panel 输入法列表"/>
                                    <ToggleButton Style="{StaticResource FocusToggleButton}"
                                                  MinHeight="44"
                                                  Tag="{x:Static services:StatusCenterDetail.PanelNotifications}"
                                                  IsChecked="{Binding IsExpanded, ElementName=PanelNotificationsDetailsExpander, Mode=OneWay}"
                                                  Click="StatusCenterDetailButton_Click"
                                                  AutomationProperties.Name="展开 Panel 通知历史">
                                        <Grid>
                                            <TextBlock Text="通知"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Border MinWidth="18"
                                                    Height="18"
                                                    Margin="0,-13,-12,0"
                                                    Padding="4,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="{StaticResource FocusControlCornerRadius}"
                                                    Background="{DynamicResource FocusAccentBrightBrush}"
                                                    Visibility="{Binding HasUnreadPanelNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding PanelNotificationBadgeText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FocusWarningTextBrush}"
                                                           Style="{StaticResource FocusMetaText}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                </UniformGrid>
                                <TextBlock Text="设备与会话"
                                           Margin="4,0,0,7"
                                           Style="{StaticResource FocusCaptionText}"/>
                                <UniformGrid Columns="3"
                                             Margin="0,0,0,12"
                                             AutomationProperties.Name="设备与会话操作">
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="显示桌面"
                                            Command="{Binding ShowDesktopCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="锁定"
                                            Command="{Binding LockComputerCommand}"/>
                                    <Button Style="{StaticResource FocusSecondaryButton}"
                                            MinHeight="44"
                                            Content="电源"
                                            Click="PowerMenuItem_Click"/>
                                </UniformGrid>
                                <TextBlock Text="音量与亮度"
                                           Margin="4,2,0,7"
                                           Style="{StaticResource FocusCaptionText}"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource FocusIconButton}"
                                            Command="{Binding ToggleMuteCommand}"
                                            IsEnabled="{Binding IsAudioAvailable}"
                                            ToolTip="{Binding AudioToggleLabel}"
                                            AutomationProperties.Name="{Binding AudioToggleLabel}">
                                        <TextBlock Style="{StaticResource FocusIconText}"
                                                   Text="{Binding AudioGlyph}"/>
                                    </Button>
                                    <Slider Grid.Column="1" Margin="8,0,14,0" Minimum="0" Maximum="1"
                                            IsEnabled="{Binding IsAudioAvailable}"
                                            Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="3"
                                               Margin="4,5,0,0"
                                               Text="{Binding AudioStatusText}"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,0,0,12"
                                      AutomationProperties.Name="{Binding BrightnessSummary}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FocusIconText}"
                                               Text="&#xE706;"
                                               ToolTip="显示亮度"/>
                                    <Slider Grid.Column="1"
                                            Margin="8,0,14,0"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding IsBrightnessAvailable}"
                                            Value="{Binding BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="内置显示器亮度"/>
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding BrightnessPercent, StringFormat={}{0}%}"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="3"
                                               Margin="4,5,0,0"
                                               Text="{Binding BrightnessStatusText}"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <Expander x:Name="ApplicationsDetailsExpander"
                                          Style="{StaticResource FocusDetailsExpander}"
                                          Tag="{x:Static services:StatusCenterDetail.Applications}"
                                          Expanded="StatusDetailsExpander_Expanded"
                                          Collapsed="StatusDetailsExpander_Collapsed"
                                          AutomationProperties.Name="Panel 应用与窗口抽屉">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="应用与窗口"
                                                       Style="{StaticResource FocusCardTitleText}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Text="{Binding TaskbarApps.Count, StringFormat={}{0} 项}"
                                                       Style="{StaticResource FocusCaptionText}"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Margin="4,0,4,8"
                                                   Text="固定、运行、后台和仅消息窗口应用共用同一身份与顺序。多窗口可在此展开，点画面按钮查看 DWM 实时预览。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource FocusCaptionText}"/>
                                        <ListBox ItemsSource="{Binding TaskbarApps}"
                                                 MaxHeight="420"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 AutomationProperties.Name="Panel 统一应用列表">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem"
                                                       BasedOn="{StaticResource FocusListBoxItem}">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,6">
                                                            <Button MinHeight="58"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Click="StatusCenterApp_Click"
                                                                    PreviewMouseDown="TaskbarApp_PreviewMouseDown"
                                                                    ContextMenuOpening="TaskbarApp_ContextMenuOpening"
                                                                    AutomationProperties.Name="{Binding AccessibleName}"
                                                                    AutomationProperties.HelpText="{Binding InteractionHint}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource FocusSecondaryButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource FocusAccentSoftBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FocusAccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsAttentionRequested}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource FocusWarningSoftBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Button.ContextMenu>
                                                                    <ContextMenu Style="{StaticResource FocusContextMenu}"
                                                                                 Opened="TransientContextMenu_Opened"
                                                                                 Closed="TransientContextMenu_Closed"/>
                                                                </Button.ContextMenu>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="44"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <controls:AppIconPresenter Icon="{Binding Icon}"
                                                                                               DisplayName="{Binding DisplayName}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"/>
                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="8,0"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Style="{StaticResource FocusCardTitleText}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding StatusSummary}"
                                                                                   Style="{StaticResource FocusCaptionText}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                                Margin="8,0,4,0"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding WindowCountBadgeText, StringFormat={}{0} 窗口}"
                                                                                   HorizontalAlignment="Right"
                                                                                   Style="{StaticResource FocusMetaText}"
                                                                                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        <TextBlock Text="&#xE70D;"
                                                                                   Margin="0,3,0,0"
                                                                                   HorizontalAlignment="Right"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="10"
                                                                                   Visibility="{Binding HasMultipleWindows, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        <ItemsControl ItemsSource="{Binding Windows}"
                                                                      Margin="18,4,0,2"
                                                                      Visibility="{Binding IsStatusCenterWindowListExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="40"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button MinHeight="44"
                                                                                Padding="10,4"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                Style="{StaticResource FocusSecondaryButton}"
                                                                                Command="{Binding DataContext.ActivateWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                AutomationProperties.Name="{Binding Title, StringFormat=切换到窗口 {0}}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Style="{StaticResource FocusBodyText}"/>
                                                                                <TextBlock Text="{Binding State}"
                                                                                           Style="{StaticResource FocusMetaText}"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Grid.Column="1"
                                                                                Width="36"
                                                                                Height="36"
                                                                                Margin="4"
                                                                                Style="{StaticResource FocusIconButton}"
                                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                Click="StatusCenterWindowPreviewButton_Click"
                                                                                MouseEnter="StatusCenterWindowPreviewButton_MouseEnter"
                                                                                MouseLeave="StatusCenterWindowPreviewButton_MouseLeave"
                                                                                ToolTip="实时预览窗口"
                                                                                AutomationProperties.Name="{Binding Title, StringFormat=实时预览窗口 {0}}">
                                                                            <TextBlock Text="&#xE7F4;"
                                                                                       Style="{StaticResource FocusIconText}"
                                                                                       FontSize="13"/>
                                                                        </Button>
                                                                        <Button Grid.Column="2"
                                                                                Width="36"
                                                                                Height="36"
                                                                                Margin="4"
                                                                                Style="{StaticResource FocusIconButton}"
                                                                                Command="{Binding DataContext.CloseWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="关闭窗口"
                                                                                AutomationProperties.Name="{Binding Title, StringFormat=关闭窗口 {0}}">
                                                                            <TextBlock Text="&#xE8BB;"
                                                                                       Style="{StaticResource FocusIconText}"
                                                                                       FontSize="12"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Margin="4,12"
                                                   HorizontalAlignment="Center"
                                                   Text="没有固定、运行或后台应用">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource FocusSecondaryBodyText}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaskbarApps.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="4,10,4,2"
                                                   Text="第三方专属托盘菜单没有 Windows 公共协议；Panel 不读取 Explorer 私有结构，也不会弹出原生隐藏图标抽屉。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource FocusMetaText}"/>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="PanelNotificationsDetailsExpander"
                                          Style="{StaticResource FocusDetailsExpander}"
                                          Tag="{x:Static services:StatusCenterDetail.PanelNotifications}"
                                          Expanded="StatusDetailsExpander_Expanded"
                                          Collapsed="StatusDetailsExpander_Collapsed"
                                          AutomationProperties.Name="Panel 通知历史">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Panel 通知"
                                                       Style="{StaticResource FocusCardTitleText}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Text="{Binding UnreadPanelNotificationCount, StringFormat={}{0} 条未读}"
                                                       Style="{StaticResource FocusCaptionText}"
                                                       Visibility="{Binding HasUnreadPanelNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="更新、任务、番茄钟和恢复消息会跨重启保留；查看详情不会擅自清除未读状态。"
                                                   Margin="4,0,4,6"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource FocusSecondaryBodyText}"/>
                                        <Grid Margin="4,0,4,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PanelNotificationCountText}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource FocusCaptionText}"/>
                                            <CheckBox Grid.Column="1"
                                                      MinHeight="40"
                                                      Content="只看未读"
                                                      IsChecked="{Binding ShowUnreadPanelNotificationsOnly}"
                                                      AutomationProperties.Name="只显示未读 Panel 通知"/>
                                        </Grid>
                                        <TextBlock Text="{Binding NotificationPersistenceError}"
                                                   Margin="4,0,4,10"
                                                   Foreground="{DynamicResource FocusDangerBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasNotificationPersistenceError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding PanelNotificationEmptyText}"
                                                   Margin="4,10"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource FocusSecondaryBodyText}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFilteredPanelNotifications}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ListBox ItemsSource="{Binding FilteredPanelNotifications}"
                                                 MaxHeight="360"
                                                 Style="{StaticResource FocusListBox}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 Visibility="{Binding HasFilteredPanelNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 AutomationProperties.Name="Panel 通知列表">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem"
                                                       BasedOn="{StaticResource FocusListBoxItem}">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type services:FocusNotificationItem}">
                                                    <Border Margin="0,0,0,8"
                                                            Padding="12"
                                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                                            Background="{DynamicResource FocusSurfaceBrush}"
                                                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       VerticalAlignment="Top"
                                                                       Style="{StaticResource FocusIconText}"/>
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="6,0,10,0">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Message}"
                                                                           Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Style="{StaticResource FocusSecondaryBodyText}"/>
                                                                <Button Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Style="{StaticResource FocusSecondaryButton}"
                                                                        Content="{Binding ActionLabel}"
                                                                        Command="{Binding DataContext.InvokePanelNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="上次运行的操作已失效；消息仍可阅读。"
                                                                           Style="{StaticResource FocusMetaText}"
                                                                           Visibility="{Binding IsExpiredAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2"
                                                                        Width="84"
                                                                        HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding TimeText}"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource FocusMetaText}"/>
                                                                <StackPanel Margin="0,6,0,0"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right">
                                                                    <Button Width="40"
                                                                            Height="40"
                                                                            Margin="0,0,4,0"
                                                                            Style="{StaticResource FocusIconButton}"
                                                                            ToolTip="标为已读"
                                                                            AutomationProperties.Name="标记这条通知为已读"
                                                                            Command="{Binding DataContext.MarkPanelNotificationReadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="&#xE73E;"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="13"/>
                                                                    </Button>
                                                                    <Button Width="40"
                                                                            Height="40"
                                                                            Style="{StaticResource FocusIconButton}"
                                                                            ToolTip="删除通知"
                                                                            AutomationProperties.Name="从 Panel 历史删除这条通知"
                                                                            Command="{Binding DataContext.RemovePanelNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}">
                                                                        <TextBlock Text="&#xE711;"
                                                                                   Style="{StaticResource FocusIconText}"
                                                                                   FontSize="12"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <UniformGrid Columns="2"
                                                     Margin="0,2,0,8">
                                            <Button Style="{StaticResource FocusSecondaryButton}"
                                                    MinHeight="40"
                                                    Content="全部已读"
                                                    Command="{Binding MarkAllPanelNotificationsReadCommand}"
                                                    IsEnabled="{Binding HasUnreadPanelNotifications}"/>
                                            <Button Style="{StaticResource FocusSecondaryButton}"
                                                    MinHeight="40"
                                                    Content="清空"
                                                    Command="{Binding ClearPanelNotificationsCommand}"
                                                    IsEnabled="{Binding HasPanelNotifications}"/>
                                        </UniformGrid>
                                        <TextBlock Margin="4,0,4,2"
                                                   Text="通知的查看、筛选、已读、删除和历史保存全部在 Panel 内完成，不会唤起 Windows 任务栏或通知中心。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource FocusMetaText}"/>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="NetworkDetailsExpander"
                                          Style="{StaticResource FocusDetailsExpander}"
                                          Tag="{x:Static services:StatusCenterDetail.Network}"
                                          Expanded="StatusDetailsExpander_Expanded"
                                          Collapsed="StatusDetailsExpander_Collapsed"
                                          AutomationProperties.Name="网络与无线详情">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
