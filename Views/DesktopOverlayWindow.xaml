<Window x:Class="FocusPanel.Views.DesktopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="False"
        AllowDrop="True"
        DragOver="Desktop_DragOver"
        Drop="Desktop_Drop">
        <Canvas x:Name="DesktopCanvas"
            Background="Transparent"
            AllowDrop="True"
            DragOver="Desktop_DragOver"
            Drop="Desktop_Drop"
            MouseLeftButtonDown="DesktopCanvas_MouseLeftButtonDown"
            Tag="{Binding}">
        <Canvas.ContextMenu>
            <ContextMenu>
                <MenuItem Header="查看">
                    <MenuItem Header="图标大小">
                        <MenuItem Header="小图标"
                                  Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="0.85"/>
                        <MenuItem Header="中等图标"
                                  Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="1.0"/>
                        <MenuItem Header="大图标"
                                  Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="1.18"/>
                        <MenuItem Header="超大图标"
                                  Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="1.35"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="按名称排序"
                              Command="{Binding PlacementTarget.Tag.SortByNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="按类型排序"
                              Command="{Binding PlacementTarget.Tag.SortByTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="按时间排序"
                              Command="{Binding PlacementTarget.Tag.SortByDateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="按大小排序"
                              Command="{Binding PlacementTarget.Tag.SortBySizeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </MenuItem>
                <MenuItem Header="刷新"
                          Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="粘贴"
                          Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="打开桌面文件夹"
                          Command="{Binding PlacementTarget.Tag.OpenDesktopFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
        </Canvas.ContextMenu>

        <Rectangle Width="{Binding ActualWidth, ElementName=DesktopCanvas}"
                   Height="{Binding ActualHeight, ElementName=DesktopCanvas}"
                   Fill="#01000000"
                   IsHitTestVisible="True"/>

        <ItemsControl ItemsSource="{Binding Files}"
                      Tag="{Binding}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AreDesktopIconsVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding DesktopX}"/>
                    <Setter Property="Canvas.Top" Value="{Binding DesktopY}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding DataContext.DesktopIconWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="{Binding DataContext.DesktopIconHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="4"
                            CornerRadius="8"
                            Background="Transparent"
                            AllowDrop="True"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding FullPath}"
                            PreviewMouseLeftButtonDown="FileIcon_PreviewMouseLeftButtonDown"
                            MouseMove="FileIcon_MouseMove"
                            MouseLeftButtonUp="FileIcon_MouseLeftButtonUp"
                            DragOver="Desktop_DragOver"
                            Drop="Desktop_Drop">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开"
                                          Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="打开方式"
                                          Command="{Binding PlacementTarget.Tag.OpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="在文件夹中显示"
                                          Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="剪切"
                                          Command="{Binding PlacementTarget.Tag.CutFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="复制"
                                          Command="{Binding PlacementTarget.Tag.CopyFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="粘贴"
                                          Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="图标大小">
                                    <MenuItem Header="小图标"
                                              Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="0.85"/>
                                    <MenuItem Header="中等图标"
                                              Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="1.0"/>
                                    <MenuItem Header="大图标"
                                              Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="1.18"/>
                                    <MenuItem Header="超大图标"
                                              Command="{Binding PlacementTarget.Tag.SetDesktopIconScaleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="1.35"/>
                                </MenuItem>
                                <MenuItem Header="排序">
                                    <MenuItem Header="按名称"
                                              Command="{Binding PlacementTarget.Tag.SortByNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="按类型"
                                              Command="{Binding PlacementTarget.Tag.SortByTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="按时间"
                                              Command="{Binding PlacementTarget.Tag.SortByDateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="按大小"
                                              Command="{Binding PlacementTarget.Tag.SortBySizeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="重命名"
                                          Command="{Binding PlacementTarget.Tag.RenameFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="删除"
                                          Command="{Binding PlacementTarget.Tag.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="刷新"
                                          Command="{Binding PlacementTarget.Tag.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="属性"
                                          Command="{Binding PlacementTarget.Tag.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#260078D7"/>
                                        <Setter Property="BorderBrush" Value="#550078D7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{Binding DataContext.DesktopIconTopRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Image Source="{Binding Icon}"
                                   Width="{Binding DataContext.DesktopIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding DataContext.DesktopIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="{Binding DataContext.DesktopIconTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="42">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Canvas>
</Window>
