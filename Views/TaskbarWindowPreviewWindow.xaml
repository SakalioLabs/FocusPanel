<Window x:Class="FocusPanel.Views.TaskbarWindowPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusPanel 实时窗口预览"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Segoe UI Variable Text"
        AutomationProperties.Name="运行窗口实时预览">
    <Border Background="{DynamicResource FocusShellTintBrush}"
            BorderThickness="0"
            Padding="12">
        <StackPanel>
            <Grid Margin="4,2,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AppTitleText"
                               Style="{StaticResource FocusCardTitleText}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="WindowCountText"
                               Margin="0,3,0,0"
                               Style="{StaticResource FocusMetaText}"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="实时预览"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource FocusMetaText}"
                           Foreground="{DynamicResource FocusAccentBrightBrush}"/>
            </Grid>

            <ItemsControl x:Name="WindowItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,9"
                                CornerRadius="{StaticResource FocusCardCornerRadius}"
                                Background="{DynamicResource FocusSurfaceSoftBrush}"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="162"/>
                                    <RowDefinition Height="48"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="ThumbnailSurface"
                                        Margin="8,8,8,0"
                                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                                        Background="{DynamicResource FocusSurfaceStrongBrush}"
                                        PreviewMouseLeftButtonUp="ThumbnailSurface_PreviewMouseLeftButtonUp"
                                        ToolTip="切换到此窗口"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel x:Name="FallbackContent"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <TextBlock Text="&#xE7F4;"
                                                   Style="{StaticResource FocusIconText}"
                                                   FontSize="28"
                                                   Foreground="{DynamicResource FocusMutedTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="FallbackStatusText"
                                                   Text="正在连接 DWM 实时画面"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource FocusMetaText}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource FocusSurfaceBrush}">
                                    <Grid Margin="12,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4"
                                                Height="22"
                                                Margin="0,0,10,0"
                                                CornerRadius="2"
                                                Background="{DynamicResource FocusAccentBrightBrush}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FocusBodyText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2"
                                                Width="36"
                                                Height="36"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource FocusIconButton}"
                                                Click="CloseWindowButton_Click"
                                                ToolTip="关闭窗口"
                                                AutomationProperties.Name="关闭此窗口">
                                            <TextBlock Text="&#xE711;"
                                                       Style="{StaticResource FocusIconText}"
                                                       FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="RemainingText"
                       Margin="4,0,4,3"
                       Style="{StaticResource FocusCaptionText}"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
