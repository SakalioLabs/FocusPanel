<Window x:Class="FocusPanel.Views.TaskbarWindowPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FocusPanel.Models"
        xmlns:services="clr-namespace:FocusPanel.Services"
        Title="FocusPanel 实时窗口预览"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Segoe UI Variable Text"
        AutomationProperties.Name="运行窗口实时预览">
    <Border Background="{DynamicResource FocusShellTintBrush}"
            BorderThickness="0"
            Padding="12">
        <StackPanel>
            <Grid Margin="4,2,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AppTitleText"
                               Style="{StaticResource FocusCardTitleText}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="WindowCountText"
                               Margin="0,3,0,0"
                               Style="{StaticResource FocusMetaText}"/>
                </StackPanel>
                <TextBlock x:Name="ModeText"
                           Grid.Column="1"
                           Text="悬停预览"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource FocusMetaText}"
                           Foreground="{DynamicResource FocusAccentBrightBrush}"/>
            </Grid>

            <ItemsControl x:Name="WindowItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,9"
                                CornerRadius="{StaticResource FocusCardCornerRadius}"
                                Background="{DynamicResource FocusSurfaceSoftBrush}"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="162"/>
                                    <RowDefinition Height="56"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="ThumbnailSurface"
                                        Margin="8,8,8,0"
                                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                                        Background="{DynamicResource FocusSurfaceStrongBrush}"
                                        PreviewMouseLeftButtonUp="ThumbnailSurface_PreviewMouseLeftButtonUp"
                                        ToolTip="切换到此窗口"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel x:Name="FallbackContent"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <TextBlock Text="&#xE7F4;"
                                                   Style="{StaticResource FocusIconText}"
                                                   FontSize="28"
                                                   Foreground="{DynamicResource FocusMutedTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="FallbackStatusText"
                                                   Text="正在连接 DWM 实时画面"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource FocusMetaText}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource FocusSurfaceBrush}">
                                    <Grid Margin="12,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4"
                                                Height="22"
                                                Margin="0,0,10,0"
                                                CornerRadius="2"
                                                Background="{DynamicResource FocusAccentBrightBrush}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource FocusBodyText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       Margin="0,2,0,0"
                                                       Style="{StaticResource FocusMetaText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasDisplayLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Width="36"
                                                Height="36"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource FocusIconButton}"
                                                Click="LayoutWindowButton_Click"
                                                ToolTip="排列到半屏或四角"
                                                AutomationProperties.Name="排列此窗口">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <ContextMenu.Style>
                                                        <Style TargetType="ContextMenu"
                                                               BasedOn="{StaticResource FocusContextMenu}">
                                                            <EventSetter Event="Opened"
                                                                         Handler="LayoutContextMenu_Opened"/>
                                                            <EventSetter Event="Closed"
                                                                         Handler="LayoutContextMenu_Closed"/>
                                                        </Style>
                                                    </ContextMenu.Style>
                                                    <ContextMenu.Resources>
                                                        <Style TargetType="MenuItem"
                                                               BasedOn="{StaticResource FocusMenuItem}"/>
                                                    </ContextMenu.Resources>
                                                    <MenuItem Header="左半屏"
                                                              Tag="{x:Static services:WindowLayoutTarget.LeftHalf}"
                                                              Click="LayoutMenuItem_Click"/>
                                                    <MenuItem Header="右半屏"
                                                              Tag="{x:Static services:WindowLayoutTarget.RightHalf}"
                                                              Click="LayoutMenuItem_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="左上四分区"
                                                              Tag="{x:Static services:WindowLayoutTarget.TopLeftQuarter}"
                                                              Click="LayoutMenuItem_Click"/>
                                                    <MenuItem Header="右上四分区"
                                                              Tag="{x:Static services:WindowLayoutTarget.TopRightQuarter}"
                                                              Click="LayoutMenuItem_Click"/>
                                                    <MenuItem Header="左下四分区"
                                                              Tag="{x:Static services:WindowLayoutTarget.BottomLeftQuarter}"
                                                              Click="LayoutMenuItem_Click"/>
                                                    <MenuItem Header="右下四分区"
                                                              Tag="{x:Static services:WindowLayoutTarget.BottomRightQuarter}"
                                                              Click="LayoutMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <TextBlock Text="&#xE8A7;"
                                                       Style="{StaticResource FocusIconText}"
                                                       FontSize="13"/>
                                        </Button>
                                        <Button Grid.Column="3"
                                                Width="36"
                                                Height="36"
                                                Margin="4,0,0,0"
                                                Click="MinimizeWindowButton_Click"
                                                AutomationProperties.Name="最小化此窗口">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource FocusIconButton}">
                                                    <Setter Property="ToolTip" Value="最小化窗口"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}"
                                                                     Value="{x:Static models:TrackedWindowState.Minimized}">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="ToolTip" Value="窗口已经最小化"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE921;"
                                                       Style="{StaticResource FocusIconText}"
                                                       FontSize="12"/>
                                        </Button>
                                        <Button Grid.Column="4"
                                                Width="36"
                                                Height="36"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource FocusIconButton}"
                                                Click="ResizeWindowButton_Click"
                                                ToolTip="最大化或还原窗口"
                                                AutomationProperties.Name="最大化或还原此窗口">
                                            <TextBlock FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource FocusIconText}">
                                                        <Setter Property="Text" Value="&#xE922;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}"
                                                                         Value="{x:Static models:TrackedWindowState.Maximized}">
                                                                <Setter Property="Text" Value="&#xE923;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Grid.Column="5"
                                                Width="36"
                                                Height="36"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource FocusIconButton}"
                                                Click="CloseWindowButton_Click"
                                                ToolTip="关闭窗口"
                                                AutomationProperties.Name="关闭此窗口">
                                            <TextBlock Text="&#xE711;"
                                                       Style="{StaticResource FocusIconText}"
                                                       FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="4,0,4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RemainingText"
                           VerticalAlignment="Center"
                           Style="{StaticResource FocusCaptionText}"
                           Visibility="Collapsed"/>
                <Button x:Name="FullOverviewButton"
                        Grid.Column="1"
                        MinWidth="88"
                        Height="36"
                        Margin="12,0,0,0"
                        Style="{StaticResource FocusSecondaryButton}"
                        Click="FullOverviewButton_Click"
                        AutomationProperties.Name="查看此应用的完整窗口列表"
                        Content="完整列表"
                        Visibility="Collapsed"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
