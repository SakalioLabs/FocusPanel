<UserControl x:Class="FocusPanel.Views.FileOrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FocusPanel.ViewModels"
             xmlns:converters="clr-namespace:FocusPanel.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:FileOrganizerViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <SolidColorBrush x:Key="OrganizerGlassBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="OrganizerGlassStrongBrush" Color="#FFF8F9FB"/>
        <SolidColorBrush x:Key="OrganizerGlassStrokeBrush" Color="#FFD8DCE3"/>
        <SolidColorBrush x:Key="OrganizerInkBrush" Color="#FF1D1D1F"/>
        <SolidColorBrush x:Key="OrganizerSubtleInkBrush" Color="#99000000"/>
        <SolidColorBrush x:Key="OrganizerHoverBrush" Color="#FFF5F7FA"/>
        <SolidColorBrush x:Key="OrganizerSelectedBrush" Color="#22007AFF"/>
        <DropShadowEffect x:Key="OrganizerCardShadow" Color="#18000000" BlurRadius="10" ShadowDepth="0" Opacity="0.18"/>

        <!-- File Item Style (Grid Item) -->
        <Style x:Key="FileItemStyle" TargetType="Border">
            <EventSetter Event="MouseMove" Handler="FileCard_MouseMove"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FileCard_PreviewMouseLeftButtonDown"/>
            <Setter Property="Width" Value="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Height" Value="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrganizerHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OrganizerGlassStrokeBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrganizerSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="#FF007AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- File List Item Style (List View) -->
        <Style x:Key="FileListItemStyle" TargetType="Border">
            <EventSetter Event="MouseMove" Handler="FileCard_MouseMove"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FileCard_PreviewMouseLeftButtonDown"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrganizerHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrganizerSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="#FF007AFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Button Style (Simplified) -->
        <Style x:Key="SidebarButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Sidebar PopupBox Style (Unified) -->
        <Style x:Key="SidebarPopupBoxStyle" TargetType="materialDesign:PopupBox">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="PlacementMode" Value="RightAndAlignTopEdges"/>
            <Setter Property="StaysOpen" Value="True"/>
            <Setter Property="PopupMode" Value="Click"/>
            <Setter Property="ToolTipService.Placement" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="materialDesign:PopupBox">
                        <ControlTemplate.Resources>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignIconButton}">
                                <Setter Property="Width" Value="40"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Grid>
                            <ToggleButton x:Name="Toggle" 
                                          Content="{TemplateBinding ToggleContent}" 
                                          ContentTemplate="{TemplateBinding ToggleContentTemplate}"
                                          IsChecked="{Binding IsPopupOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   PlacementTarget="{Binding ElementName=Toggle}"
                                   Placement="{TemplateBinding PlacementMode}"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsPopupOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <materialDesign:Card Content="{TemplateBinding PopupContent}" ContentTemplate="{TemplateBinding PopupContentTemplate}" Margin="5" Padding="8"/>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Icon Style -->
        <Style x:Key="SidebarIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Partition Style (Masonry Card) -->
        <Style x:Key="MasonryPartitionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OrganizerGlassBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource OrganizerGlassStrokeBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect" Value="{StaticResource OrganizerCardShadow}"/>
            <!-- Auto Height for Content Fit -->
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- Partition Data Template -->
        <DataTemplate x:Key="PartitionTemplate">
            <Border Style="{StaticResource MasonryPartitionStyle}"
                    AllowDrop="True"
                    Drop="Partition_Drop"
                    DragEnter="Partition_DragEnter"
                    DragOver="Partition_DragOver"
                    DragLeave="Partition_DragLeave">
                <StackPanel>
                    <!-- Header -->
                    <Grid Height="44"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="PartitionHeader_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PartitionHeader_PreviewMouseMove"
                          Drop="PartitionHeader_Drop">
                        <Grid.Background>
                            <SolidColorBrush Color="#FFF8F9FB"/>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Collapse Toggle -->
                        <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded}" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Margin="4,0,0,0" ToolTip="折叠/展开">
                            <materialDesign:PackIcon Width="16" Height="16">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronDown"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Kind" Value="ChevronRight"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </ToggleButton>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource OrganizerInkBrush}"/>
                            <Border Background="#14007AFF" CornerRadius="9" Margin="8,0,0,0" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Files.Count}" FontSize="11" Foreground="#FF0066CC"/>
                            </Border>
                        </StackPanel>

                        <materialDesign:PopupBox Grid.Column="2" PlacementMode="BottomAndAlignRightEdges" Padding="0" Margin="0,0,8,0" Height="24" Width="24">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Kind="DotsVertical" Width="16" Height="16" Opacity="0.5"/>
                            </materialDesign:PopupBox.ToggleContent>
                            <StackPanel>
                                <Button Command="{Binding DataContext.OpenPartitionFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <TextBlock Text="Open in Explorer"/>
                                </Button>
                                <Button Command="{Binding DataContext.OpenRenameDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <TextBlock Text="Rename"/>
                                </Button>
                                <Button Command="{Binding DataContext.DeletePartitionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <TextBlock Text="Delete"/>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </Grid>

                    <!-- Files Content (Collapsible) -->
                    <ContentControl Content="{Binding}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <!-- Default Grid View -->
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Files}" Margin="4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource FileItemStyle}" ToolTip="{Binding FullPath}">
                                                            <Border.InputBindings>
                                                                <MouseBinding Gesture="LeftClick" 
                                                                              Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                                <MouseBinding Gesture="LeftDoubleClick" 
                                                                              Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Open" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                    <MenuItem Header="Move to" ItemsSource="{Binding Data.AllPartitions, Source={StaticResource VmProxy}}">
                                                                        <MenuItem.ItemContainerStyle>
                                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                                                <Setter Property="Command" Value="{Binding Data.AssignToPartitionCommand, Source={StaticResource VmProxy}}"/>
                                                                                <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                                            </Style>
                                                                        </MenuItem.ItemContainerStyle>
                                                                    </MenuItem>
                                                                    <!-- 收纳到面板 -->
                                                                    <MenuItem Header="收纳到面板" ItemsSource="{Binding Data.AllPartitions, Source={StaticResource VmProxy}}">
                                                                        <MenuItem.ItemContainerStyle>
                                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                                                <Setter Property="Command" Value="{Binding Data.HideFileToPanelCommand, Source={StaticResource VmProxy}}"/>
                                                                                <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                                            </Style>
                                                                        </MenuItem.ItemContainerStyle>
                                                                    </MenuItem>
                                                                    <!-- 取消收纳 -->
                                                                    <MenuItem Header="取消收纳" Command="{Binding Data.RestoreFileFromPanelCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            
                                                            <Grid Margin="4">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Image Grid.Row="0" Source="{Binding Icon}" Width="{Binding DataContext.IconImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.IconImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,4"/>
                                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" Margin="4,4,4,4" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- List View Template -->
                                    <DataTrigger Binding="{Binding DataContext.IsListView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding Files}" Margin="4">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Vertical" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource FileListItemStyle}" ToolTip="{Binding FullPath}">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding Gesture="LeftClick" 
                                                                                      Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                      CommandParameter="{Binding}"/>
                                                                        <MouseBinding Gesture="LeftDoubleClick" 
                                                                                      Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                      CommandParameter="{Binding}"/>
                                                                    </Border.InputBindings>
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Open" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                            <MenuItem Header="Move to" ItemsSource="{Binding Data.AllPartitions, Source={StaticResource VmProxy}}">
                                                                                <MenuItem.ItemContainerStyle>
                                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                                                        <Setter Property="Header" Value="{Binding Name}"/>
                                                                                        <Setter Property="Command" Value="{Binding Data.AssignToPartitionCommand, Source={StaticResource VmProxy}}"/>
                                                                                        <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                                                    </Style>
                                                                                </MenuItem.ItemContainerStyle>
                                                                            </MenuItem>
                                                                    <!-- 收纳到面板 -->
                                                                    <MenuItem Header="收纳到面板" ItemsSource="{Binding Data.AllPartitions, Source={StaticResource VmProxy}}">
                                                                        <MenuItem.ItemContainerStyle>
                                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                                                <Setter Property="Command" Value="{Binding Data.HideFileToPanelCommand, Source={StaticResource VmProxy}}"/>
                                                                                <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                                            </Style>
                                                                        </MenuItem.ItemContainerStyle>
                                                                    </MenuItem>
                                                                    <!-- 取消收纳 -->
                                                                    <MenuItem Header="取消收纳" Command="{Binding Data.RestoreFileFromPanelCommand, Source={StaticResource VmProxy}}" CommandParameter="{Binding}"/>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                    
                                                                    <Grid Margin="8,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="32"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#FFF3F5F8">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar (Tools) -->
            <ColumnDefinition Width="Auto"/>
            <!-- Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Toolbar -->
        <Border Grid.Column="0" 
                Background="#FFFFFFFF" 
                BorderThickness="1" 
                BorderBrush="{StaticResource OrganizerGlassStrokeBrush}"
                CornerRadius="14"
                Effect="{StaticResource OrganizerCardShadow}"
                Padding="8,16"
                Width="56"
                Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top: Brand / Home -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                     <materialDesign:PackIcon Kind="FolderStarOutline" Style="{StaticResource SidebarIconStyle}" Foreground="#FF007AFF" Opacity="1" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- Middle: Actions -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <!-- View Switcher -->
                    <Grid>
                        <ToggleButton x:Name="ViewToggle" Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40" Padding="0" Margin="0,8">
                            <materialDesign:PackIcon Kind="ViewModule" Style="{StaticResource SidebarIconStyle}"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ViewToggle, Mode=TwoWay}" 
                               PlacementTarget="{Binding ElementName=ViewToggle}"
                               Placement="Right"
                               StaysOpen="False"
                               AllowsTransparency="True">
                             <materialDesign:Card Margin="5" Padding="8">
                                <StackPanel Width="220" Margin="12">
                                    <!-- View Mode -->
                                    <TextBlock Text="视图模式" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipOutlineRadioButton}"
                                                     IsChecked="{Binding IsListView, Converter={StaticResource InverseBoolConverter}}"
                                                     Content="网格" Margin="0,0,8,0"/>
                                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipOutlineRadioButton}"
                                                     IsChecked="{Binding IsListView}"
                                                     Content="列表"/>
                                    </StackPanel>

                                    <!-- Icon Size -->
                                    <TextBlock Text="面板图标大小" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipOutlineRadioButton}"
                                                     Content="小"
                                                     IsChecked="{Binding IconScale, Converter={StaticResource EqualityConverter}, ConverterParameter=0.8}"
                                                     Command="{Binding SetIconScaleCommand}" CommandParameter="0.8"
                                                     Margin="0,0,8,0"/>
                                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipOutlineRadioButton}"
                                                     Content="中"
                                                     IsChecked="{Binding IconScale, Converter={StaticResource EqualityConverter}, ConverterParameter=1.0}"
                                                     Command="{Binding SetIconScaleCommand}" CommandParameter="1.0"
                                                     Margin="0,0,8,0"/>
                                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipOutlineRadioButton}"
                                                     Content="大"
                                                     IsChecked="{Binding IconScale, Converter={StaticResource EqualityConverter}, ConverterParameter=1.2}"
                                                     Command="{Binding SetIconScaleCommand}" CommandParameter="1.2"/>
                                    </StackPanel>
                                    
                                    <!-- Partition Mode -->
                                    <TextBlock Text="分组方式" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6" Margin="0,0,0,8"/>
                                    <RadioButton Style="{StaticResource MaterialDesignRadioButton}"
                                                 IsChecked="{Binding IsPersonalizedView}"
                                                 Command="{Binding ToggleViewCommand}"
                                                 Content="自定义收纳盒" Margin="0,4"/>
                                    <RadioButton Style="{StaticResource MaterialDesignRadioButton}"
                                                 IsChecked="{Binding IsPersonalizedView, Converter={StaticResource InverseBoolConverter}}"
                                                 Command="{Binding ToggleViewCommand}"
                                                 Content="时间线" Margin="0,4"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </Popup>
                    </Grid>
                    
                    <!-- Add Partition -->
                    <Grid Visibility="{Binding IsPersonalizedView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ToggleButton x:Name="AddPartitionToggle" Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40" Padding="0" Margin="0,8">
                            <materialDesign:PackIcon Kind="PlusBoxOutline" Style="{StaticResource SidebarIconStyle}"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=AddPartitionToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=AddPartitionToggle}"
                               Placement="Right"
                               StaysOpen="False"
                               AllowsTransparency="True">
                             <materialDesign:Card Margin="5" Padding="8">
                                <StackPanel Width="200" FocusManager.FocusedElement="{Binding ElementName=PartitionNameBox}">
                                     <TextBlock Text="新建收纳盒" FontWeight="Bold" Margin="12,12,12,8"/>
                                     <TextBox x:Name="PartitionNameBox" Text="{Binding NewPartitionName, UpdateSourceTrigger=PropertyChanged}" 
                                             materialDesign:HintAssist.Hint="名称"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Padding="8" Margin="12,0,12,8"/>
                                    <Button Command="{Binding CreatePartitionCommand}" Content="创建" Style="{StaticResource MaterialDesignFlatButton}" Margin="12,0,12,12"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </Popup>
                    </Grid>

                    <Button Command="{Binding OrganizeAllCommand}" Style="{StaticResource SidebarButtonStyle}" ToolTip="自动整理全部文件" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="AutoFix" Style="{StaticResource SidebarIconStyle}"/>
                    </Button>

                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource SidebarButtonStyle}" ToolTip="刷新" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource SidebarIconStyle}"/>
                    </Button>

                    <Button Command="{Binding ToggleDesktopCommand}" Style="{StaticResource SidebarButtonStyle}" ToolTip="{Binding OrganizeButtonText}" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="{Binding OrganizeButtonIcon}" Style="{StaticResource SidebarIconStyle}"/>
                    </Button>
                </StackPanel>

                <!-- Bottom: Advanced -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                     <Grid>
                        <ToggleButton x:Name="RescueToggle" Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40" Padding="0" Margin="0,8">
                             <materialDesign:PackIcon Kind="ToolboxOutline" Style="{StaticResource SidebarIconStyle}"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=RescueToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=RescueToggle}"
                               Placement="Right"
                               StaysOpen="False"
                               AllowsTransparency="True">
                             <materialDesign:Card Margin="5" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="修复工具" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6" Margin="0,0,0,12"/>
                                    
                                    <Button Command="{Binding RescueCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="8" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <Grid Width="150">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Lifebuoy" Width="20" Height="20" Foreground="#F44336" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="恢复桌面" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    
                                    <Button Command="{Binding SmartRescueCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalContentAlignment="Left" Padding="8" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <Grid Width="150">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Brain" Width="20" Height="20" Foreground="#673AB7" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="智能分组" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </materialDesign:Card>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (Masonry Layout) -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14" PreviewMouseLeftButtonDown="ContentArea_PreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0 Drop Area -->
                    <Border Grid.Column="0" Background="Transparent" AllowDrop="True" Drop="Column_Drop" Tag="0" Margin="0,0,8,0">
                        <ItemsControl ItemsSource="{Binding PartitionsCol1}" ItemTemplate="{StaticResource PartitionTemplate}">
                             <ItemsControl.ItemsPanel>
                                 <ItemsPanelTemplate>
                                     <StackPanel Orientation="Vertical"/>
                                 </ItemsPanelTemplate>
                             </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <!-- Column 1 Drop Area -->
                    <Border Grid.Column="1" Background="Transparent" AllowDrop="True" Drop="Column_Drop" Tag="1" Margin="8,0,0,0">
                        <ItemsControl ItemsSource="{Binding PartitionsCol2}" ItemTemplate="{StaticResource PartitionTemplate}">
                             <ItemsControl.ItemsPanel>
                                 <ItemsPanelTemplate>
                                     <StackPanel Orientation="Vertical"/>
                                 </ItemsPanelTemplate>
                             </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Empty State Overlay -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Opacity="0.4" TextAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBody}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllPartitions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="点击 + 创建一个收纳盒"/>
                <LineBreak/>
                <Run Text="或从桌面拖入文件"/>
            </TextBlock>
        </Grid>

        <!-- Rename Dialog Overlay -->
        <Grid Grid.ColumnSpan="2" 
              Visibility="{Binding IsRenameDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Background="#50000000"
              Panel.ZIndex="999">
             <materialDesign:Card Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16">
                <StackPanel>
                    <TextBlock Text="重命名收纳盒" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16"/>
                    <TextBox x:Name="RenameTextBox" 
                             Text="{Binding RenamePartitionName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="新名称"
                             Margin="0,0,0,16"
                             FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Content="取消" Command="{Binding CancelRenameCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Content="重命名" Command="{Binding ConfirmRenameCommand}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
