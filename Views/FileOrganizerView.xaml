<UserControl x:Class="FocusPanel.Views.FileOrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FocusPanel.ViewModels"
             xmlns:converters="clr-namespace:FocusPanel.Converters"
             xmlns:controls="clr-namespace:FocusPanel.Controls"
             mc:Ignorable="d"
             AllowDrop="True"
             PreviewDragOver="Organizer_PreviewDragOver"
             PreviewDragLeave="Organizer_PreviewDragLeave"
             PreviewDrop="Organizer_PreviewDrop"
             PreviewMouseLeftButtonUp="FileDrag_PreviewMouseLeftButtonUp"
             Unloaded="UserControl_Unloaded"
             d:DataContext="{d:DesignInstance Type=vm:FileOrganizerViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <Style x:Key="ToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FocusIconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarToggleButtonStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource FocusToggleButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OrganizerChoiceChipStyle"
               TargetType="RadioButton"
               BasedOn="{StaticResource FocusSegmentRadioButton}">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="PopupPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FocusPopupSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource FocusCardCornerRadius}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="PartitionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FocusSurfaceStrongBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource FocusCardCornerRadius}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="FileGridItemStyle" TargetType="Border">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FileCard_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="MouseMove" Handler="FileCard_MouseMove"/>
            <Setter Property="Width" Value="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Height" Value="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="{StaticResource FocusControlCornerRadius}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusAccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusAccentBrightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileListItemStyle" TargetType="Border">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FileCard_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="MouseMove" Handler="FileCard_MouseMove"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource FocusControlCornerRadius}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FocusAccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusAccentBrightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="FileContextMenu"
                     x:Shared="False"
                     Style="{StaticResource FocusContextMenu}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="TransientSurface_Opened"
                     Closed="TransientSurface_Closed">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem"
                       BasedOn="{StaticResource FocusMenuItem}"/>
            </ContextMenu.Resources>
            <MenuItem Header="&#x6253;&#x5F00;"
                      Command="{Binding Data.OpenFileCommand, Source={StaticResource VmProxy}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="&#x79FB;&#x52A8;&#x5230;"
                      Tag="MoveToPartitionRoot"/>
            <MenuItem Header="&#x6536;&#x7EB3;&#x5230;&#x9762;&#x677F;"
                      Tag="CollectToPartitionRoot"/>
            <MenuItem Header="&#x6062;&#x590D;&#x5230;&#x684C;&#x9762;"
                      Command="{Binding Data.RestoreFileFromPanelCommand, Source={StaticResource VmProxy}}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>

        <DataTemplate x:Key="FileGridTemplate">
            <Border Style="{StaticResource FileGridItemStyle}"
                    ToolTip="{Binding FullPath}"
                    ContextMenu="{StaticResource FileContextMenu}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding Data.SelectFileCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}"/>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding Data.OpenFileCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="{Binding Icon}"
                           Width="{Binding Data.IconImageSize, Source={StaticResource VmProxy}}"
                           Height="{Binding Data.IconImageSize, Source={StaticResource VmProxy}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"/>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="5,2"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            Background="{DynamicResource FocusDangerBrush}"
                            Visibility="{Binding NeedsRecovery, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="需恢复" FontSize="10" Foreground="White"/>
                    </Border>
                    <TextBlock Grid.Row="1"
                               Text="{Binding DisplayName}"
                               Style="{StaticResource FocusCaptionText}"
                               Foreground="{DynamicResource FocusTextBrush}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Margin="0,6,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FileListTemplate">
            <Border Style="{StaticResource FileListItemStyle}"
                    ToolTip="{Binding FullPath}"
                    ContextMenu="{StaticResource FileContextMenu}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding Data.SelectFileCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}"/>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding Data.OpenFileCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}"
                           Width="18"
                           Height="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               Style="{StaticResource FocusBodyText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="1"
                               Text="需要恢复"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FocusDangerBrush}"
                               Style="{StaticResource FocusMetaText}"
                               Visibility="{Binding NeedsRecovery, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PartitionTemplate">
            <Border Style="{StaticResource PartitionCardStyle}"
                    AllowDrop="True"
                    Drop="Partition_Drop"
                    DragEnter="Partition_DragEnter"
                    DragOver="Partition_DragOver"
                    DragLeave="Partition_DragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="Transparent"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="PartitionHeader_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PartitionHeader_PreviewMouseMove"
                          Drop="PartitionHeader_Drop">
                        <Grid Margin="10,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0"
                                          IsChecked="{Binding IsExpanded}"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          Width="28"
                                          Height="28"
                                          Padding="0"
                                          ToolTip="&#x5C55;&#x5F00;&#x6216;&#x6298;&#x53E0;">
                                <TextBlock Width="17"
                                           FontSize="14"
                                           Foreground="{DynamicResource FocusAccentBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource FocusIconText}">
                                            <Setter Property="Text" Value="&#xE70D;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                    <Setter Property="Text" Value="&#xE76C;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToggleButton>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource FocusCardTitleText}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource FocusHoverBrush}"
                                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                                        Padding="7,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Files.Count}"
                                               Style="{StaticResource FocusMetaText}"
                                               Foreground="{DynamicResource FocusAccentBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource FocusAccentSoftBrush}"
                                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                                        Padding="7,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="已锁定"
                                               Style="{StaticResource FocusMetaText}"
                                               Foreground="{DynamicResource FocusAccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Column="2">
                                <ToggleButton x:Name="PartitionMenuToggle"
                                              Style="{StaticResource ToolbarToggleButtonStyle}"
                                              Width="28"
                                              Height="28"
                                              ToolTip="收纳盒操作">
                                    <TextBlock Style="{StaticResource FocusIconText}"
                                               Text="&#xE712;"
                                               FontSize="16"
                                               Foreground="{DynamicResource FocusMutedTextBrush}"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=PartitionMenuToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=PartitionMenuToggle}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PreviewKeyDown="TransientPopup_PreviewKeyDown"
                                       Opened="TransientPopup_Opened"
                                       Closed="TransientPopup_Closed">
                                    <Border Style="{StaticResource PopupPanelStyle}"
                                            Margin="0,8,0,0">
                                        <StackPanel Width="168">
                                            <Button Command="{Binding Data.OpenPartitionFolderCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FocusSecondaryButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="打开文件夹"/>
                                            <Button Command="{Binding Data.OpenRenameDialogCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FocusSecondaryButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="重命名"/>
                                            <Button Command="{Binding Data.TogglePartitionLockCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolConverter}}"
                                                    Style="{StaticResource FocusSecondaryButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="锁定 AI 调整"/>
                                            <Button Command="{Binding Data.TogglePartitionLockCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource FocusSecondaryButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="允许 AI 调整"/>
                                            <Button Command="{Binding Data.DeletePartitionCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource FocusDangerButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="删除"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                        <Border Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource FocusStrokeBrush}"/>
                    </Grid>

                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Files}"
                                                          Margin="6"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:ViewportVirtualizingPanel
                                                            ItemWidth="{Binding Data.CardWidth, Source={StaticResource VmProxy}}"
                                                            ItemHeight="{Binding Data.CardHeight, Source={StaticResource VmProxy}}"
                                                            ItemSpacing="10"
                                                            IsWrapping="True"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <StaticResource ResourceKey="FileGridTemplate"/>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Data.IsListView, Source={StaticResource VmProxy}}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding Files}"
                                                                  Margin="0,6,0,8"
                                                                  VirtualizingPanel.IsVirtualizing="True"
                                                                  VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <controls:ViewportVirtualizingPanel
                                                                    ItemHeight="38"
                                                                    IsWrapping="False"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <StaticResource ResourceKey="FileListTemplate"/>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Transparent"
                BorderBrush="{DynamicResource FocusStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FocusIconText}"
                               Text="&#xE8B7;"
                               FontSize="18"
                               Foreground="{DynamicResource FocusAccentBrush}"/>
                    <TextBlock Text="&#x6536;&#x7EB3;&#x76D2;"
                               Style="{StaticResource FocusCardTitleText}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <ToggleButton x:Name="ViewToggle"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      ToolTip="&#x89C6;&#x56FE;&#x9009;&#x9879;">
                            <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE80A;" FontSize="18"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ViewToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=ViewToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PreviewKeyDown="TransientPopup_PreviewKeyDown"
                               Opened="TransientPopup_Opened"
                               Closed="TransientPopup_Closed">
                            <Border Style="{StaticResource PopupPanelStyle}" Margin="0,8,0,0">
                                <StackPanel Width="220">
                                    <TextBlock Text="&#x89C6;&#x56FE;&#x6A21;&#x5F0F;"
                                               Margin="0,0,0,8"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton Style="{StaticResource OrganizerChoiceChipStyle}"
                                                     IsChecked="{Binding IsListView, Converter={StaticResource InverseBoolConverter}}"
                                                     Content="&#x7F51;&#x683C;"
                                                     Margin="0,0,8,0"/>
                                        <RadioButton Style="{StaticResource OrganizerChoiceChipStyle}"
                                                     IsChecked="{Binding IsListView}"
                                                     Content="&#x5217;&#x8868;"/>
                                    </StackPanel>

                                    <TextBlock Text="&#x9762;&#x677F;&#x56FE;&#x6807;&#x5927;&#x5C0F;"
                                               Margin="0,0,0,8"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton Style="{StaticResource OrganizerChoiceChipStyle}"
                                                     Content="&#x5C0F;"
                                                     IsChecked="{Binding IconScale, Converter={StaticResource EqualityConverter}, ConverterParameter=0.8}"
                                                     Command="{Binding SetIconScaleCommand}"
                                                     CommandParameter="0.8"
                                                     Margin="0,0,8,0"/>
                                        <RadioButton Style="{StaticResource OrganizerChoiceChipStyle}"
                                                     Content="&#x4E2D;"
                                                     IsChecked="{Binding IconScale, Converter={StaticResource EqualityConverter}, ConverterParameter=1.0}"
                                                     Command="{Binding SetIconScaleCommand}"
                                                     CommandParameter="1.0"
                                                     Margin="0,0,8,0"/>
                                        <RadioButton Style="{StaticResource OrganizerChoiceChipStyle}"
                                                     Content="&#x5927;"
                                                     IsChecked="{Binding IconScale, Converter={StaticResource EqualityConverter}, ConverterParameter=1.2}"
                                                     Command="{Binding SetIconScaleCommand}"
                                                     CommandParameter="1.2"/>
                                    </StackPanel>

                                    <TextBlock Text="&#x5206;&#x7EC4;&#x65B9;&#x5F0F;"
                                               Margin="0,0,0,8"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <RadioButton Style="{StaticResource OrganizerChoiceChipStyle}"
                                                 IsChecked="{Binding IsPersonalizedView}"
                                                 Command="{Binding ToggleViewCommand}"
                                                 Content="&#x81EA;&#x5B9A;&#x4E49;&#x6536;&#x7EB3;&#x76D2;"
                                                 Margin="0,3"/>
                                    <RadioButton Style="{StaticResource OrganizerChoiceChipStyle}"
                                                 IsChecked="{Binding IsPersonalizedView, Converter={StaticResource InverseBoolConverter}}"
                                                 Command="{Binding ToggleViewCommand}"
                                                 Content="&#x65F6;&#x95F4;&#x7EBF;"
                                                 Margin="0,3"/>
                                    <Border Height="1"
                                            Margin="0,12,0,10"
                                            Background="{DynamicResource FocusStrokeBrush}"/>
                                    <CheckBox IsChecked="{Binding IsAutoOrganizeEnabled}"
                                              Content="新增桌面项目自动按类型收纳"
                                              ToolTip="仅处理开启后新增到桌面根目录的项目；不会移动或改名"
                                              Padding="2,5"/>
                                    <TextBlock Text="{Binding AutoOrganizeStatus}"
                                               Margin="2,4,2,0"
                                               Style="{StaticResource FocusMetaText}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Margin="2,5,2,0"
                                               Style="{StaticResource FocusMetaText}"
                                               TextWrapping="Wrap"
                                               Text="分区方式可在 AI 助手中选择：本地按类型，或 DeepSeek 智能分区；手动分区始终优先。"/>
                                    <Button Margin="0,8,0,0"
                                            MinHeight="44"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            Content="{Binding PendingCommonDesktopCount, StringFormat=授权收纳 {0} 个公共桌面项目}"
                                            Command="{Binding CollectPendingCommonDesktopCommand}"
                                            Visibility="{Binding HasPendingCommonDesktopItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="授权收纳公共桌面项目"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Visibility="{Binding IsPersonalizedView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ToggleButton x:Name="AddPartitionToggle"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      ToolTip="&#x65B0;&#x5EFA;&#x6536;&#x7EB3;&#x76D2;">
                            <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE710;" FontSize="18"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=AddPartitionToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=AddPartitionToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PreviewKeyDown="TransientPopup_PreviewKeyDown"
                               Opened="TransientPopup_Opened"
                               Closed="TransientPopup_Closed">
                            <Border Style="{StaticResource PopupPanelStyle}" Margin="0,8,0,0">
                                <StackPanel Width="210" FocusManager.FocusedElement="{Binding ElementName=PartitionNameBox}">
                                    <TextBlock Text="&#x65B0;&#x5EFA;&#x6536;&#x7EB3;&#x76D2;"
                                               Margin="0,0,0,10"
                                               Style="{StaticResource FocusCardTitleText}"/>
                                    <TextBox x:Name="PartitionNameBox"
                                             Text="{Binding NewPartitionName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FocusSearchBox}"
                                             ToolTip="收纳盒名称"
                                             Padding="8"
                                             Margin="0,0,0,10"/>
                                    <Button Command="{Binding CreatePartitionCommand}"
                                            Content="&#x521B;&#x5EFA;"
                                            Style="{StaticResource FocusPrimaryButton}"
                                            HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Command="{Binding SmartPartitionCommand}"
                            Style="{StaticResource FocusPrimaryButton}"
                            MinHeight="40"
                            MinWidth="118"
                            Margin="4,0"
                            Content="AI 智能分区"
                            ToolTip="预览并重新分配未锁定收纳盒中的已收纳项目"/>
                    <Button Command="{Binding OrganizeAllCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="本地按类型整理">
                        <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE9D2;" FontSize="18"/>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="&#x5237;&#x65B0;">
                        <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE72C;" FontSize="18"/>
                    </Button>

                    <Grid>
                        <ToggleButton x:Name="RescueToggle"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      ToolTip="&#x4FEE;&#x590D;&#x5DE5;&#x5177;">
                            <TextBlock Style="{StaticResource FocusIconText}" Text="&#xE90F;" FontSize="18"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=RescueToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=RescueToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PreviewKeyDown="TransientPopup_PreviewKeyDown"
                               Opened="TransientPopup_Opened"
                               Closed="TransientPopup_Closed">
                            <Border Style="{StaticResource PopupPanelStyle}" Margin="0,8,0,0">
                                <StackPanel Width="210">
                                    <TextBlock Text="&#x4FEE;&#x590D;&#x5DE5;&#x5177;"
                                               Margin="0,0,0,10"
                                               Style="{StaticResource FocusCaptionText}"/>
                                    <Button Command="{Binding RestoreAllCollectedDesktopItemsCommand}"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8"
                                            Margin="0,0,0,8"
                                            Content="&#x7D27;&#x6025;&#x6062;&#x590D;&#x5168;&#x90E8;&#x56FE;&#x6807;"/>
                                    <Button Command="{Binding RescueCommand}"
                                            Style="{StaticResource FocusSecondaryButton}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8"
                                            Content="&#x6551;&#x63F4;&#x672A;&#x5206;&#x7C7B;&#x6587;&#x4EF6;"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="14,8"
                Background="{DynamicResource FocusAccentSoftBrush}"
                BorderBrush="{DynamicResource FocusStrokeBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsOrganizing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding AutoOrganizeStatus}"
                           Style="{StaticResource FocusMetaText}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar Grid.Row="1"
                             Margin="0,6,0,0"
                             Height="4"
                             Minimum="0"
                             Maximum="{Binding OrganizeProgressMaximum}"
                             Value="{Binding OrganizeProgressValue}"
                             IsIndeterminate="False"
                             AutomationProperties.Name="桌面整理进度"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="OrganizerScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14"
                          PreviewMouseLeftButtonDown="ContentArea_PreviewMouseLeftButtonDown">
                <Grid>
                    <ItemsControl ItemsSource="{Binding AllPartitions}"
                                  ItemTemplate="{StaticResource PartitionTemplate}"
                                  Visibility="{Binding IsListView, Converter={StaticResource InverseBoolConverter}}"
                                  AutomationProperties.Name="全宽图标收纳盒">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="Transparent"
                                AllowDrop="True"
                                Drop="Column_Drop"
                                Tag="0"
                                Margin="0,0,7,0">
                            <ItemsControl ItemsSource="{Binding PartitionsCol1}"
                                          ItemTemplate="{StaticResource PartitionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>

                        <Border Grid.Column="1"
                                Background="Transparent"
                                AllowDrop="True"
                                Drop="Column_Drop"
                                Tag="1"
                                Margin="7,0,0,0">
                            <ItemsControl ItemsSource="{Binding PartitionsCol2}"
                                          ItemTemplate="{StaticResource PartitionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{DynamicResource FocusMutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource FocusSecondaryBodyText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllPartitions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="&#x65B0;&#x5EFA;&#x6536;&#x7EB3;&#x76D2;&#xFF0C;&#x6216;&#x628A;&#x684C;&#x9762;&#x6587;&#x4EF6;&#x62D6;&#x8FDB;&#x6765;"/>
            </TextBlock>
        </Grid>

        <Grid x:Name="RenameOverlay"
              Grid.RowSpan="2"
              Visibility="{Binding IsRenameDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource FocusOverlayBrush}"
              Panel.ZIndex="999">
            <Border Width="320"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PopupPanelStyle}">
                <StackPanel>
                    <TextBlock Text="&#x91CD;&#x547D;&#x540D;&#x6536;&#x7EB3;&#x76D2;"
                               Style="{StaticResource FocusSectionTitleText}"
                               Margin="0,0,0,14"/>
                    <TextBox x:Name="RenameTextBox"
                             Text="{Binding RenamePartitionName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FocusSearchBox}"
                             ToolTip="新名称"
                             Margin="0,0,0,14"
                             FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FocusSecondaryButton}"
                                Content="&#x53D6;&#x6D88;"
                                Command="{Binding CancelRenameCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource FocusPrimaryButton}"
                                Content="&#x91CD;&#x547D;&#x540D;"
                                Command="{Binding ConfirmRenameCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
