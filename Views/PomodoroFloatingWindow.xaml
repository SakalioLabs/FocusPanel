<Window x:Class="FocusPanel.Views.PomodoroFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusPanel 专注计时"
        Height="96"
        Width="304"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource FocusShellTintBrush}"
            BorderThickness="0"
            Padding="14,10,10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="7"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding TimerDisplay}"
                           FontFamily="Segoe UI Variable Display"
                           FontSize="27"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="1,-1,0,0"
                           Foreground="{DynamicResource FocusMutedTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"
                        Style="{StaticResource FocusIconButton}"
                        Width="36"
                        Height="36"
                        ToolTip="开始或继续">
                    <TextBlock Text="&#xE768;"
                               Style="{StaticResource FocusIconText}"
                               FontSize="16"/>
                </Button>
                <Button Command="{Binding PauseCommand}"
                        IsEnabled="{Binding CanPause}"
                        Style="{StaticResource FocusIconButton}"
                        Width="36"
                        Height="36"
                        ToolTip="暂停">
                    <TextBlock Text="&#xE769;"
                               Style="{StaticResource FocusIconText}"
                               FontSize="16"/>
                </Button>
                <Button Command="{Binding ResetCommand}"
                        Style="{StaticResource FocusIconButton}"
                        Width="36"
                        Height="36"
                        ToolTip="重置">
                    <TextBlock Text="&#xE71A;"
                               Style="{StaticResource FocusIconText}"
                               FontSize="16"
                               Foreground="{DynamicResource FocusDangerBrush}"/>
                </Button>
            </StackPanel>

            <ProgressBar Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Height="5"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress}"
                         Style="{StaticResource FocusLinearProgress}"/>
        </Grid>
    </Border>
</Window>
