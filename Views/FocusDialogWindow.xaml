<Window x:Class="FocusPanel.Views.FocusDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusPanel"
        Width="520"
        MinWidth="420"
        MaxWidth="620"
        MaxHeight="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text"
        AutomationProperties.Name="FocusPanel 对话框">
    <Border x:Name="DialogSurface"
            Background="{DynamicResource FocusShellTintBrush}"
            BorderThickness="0"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        Margin="0,0,14,0"
                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                        Background="{DynamicResource FocusAccentSoftBrush}">
                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource FocusIconText}"
                               FontSize="18"
                               AutomationProperties.Name="消息类型"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource FocusSectionTitleText}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="FocusPanel"
                               Margin="0,2,0,0"
                               Style="{StaticResource FocusMetaText}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="38"
                        Height="38"
                        Margin="12,0,0,0"
                        Style="{StaticResource FocusIconButton}"
                        Click="CloseButton_Click"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭对话框">
                    <TextBlock Text="&#xE711;"
                               Style="{StaticResource FocusIconText}"
                               FontSize="14"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,22"
                          MaxHeight="380"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource FocusBodyText}"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="对话框内容"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Margin="0,0,8,0"
                        MinWidth="92"
                        Height="42"
                        Style="{StaticResource FocusSecondaryButton}"
                        Content="取消"
                        Click="CancelButton_Click"/>
                <Button x:Name="NoButton"
                        Margin="0,0,8,0"
                        MinWidth="92"
                        Height="42"
                        Style="{StaticResource FocusSecondaryButton}"
                        Content="否"
                        Click="NoButton_Click"/>
                <Button x:Name="OkButton"
                        MinWidth="92"
                        Height="42"
                        Style="{StaticResource FocusPrimaryButton}"
                        Content="确定"
                        Click="OkButton_Click"/>
                <Button x:Name="YesButton"
                        MinWidth="92"
                        Height="42"
                        Style="{StaticResource FocusPrimaryButton}"
                        Content="是"
                        Click="YesButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
