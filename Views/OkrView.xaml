<UserControl x:Class="FocusPanel.Views.OkrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FocusPanel.ViewModels"
             xmlns:converters="clr-namespace:FocusPanel.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OkrViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="720">
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:SyncStatusToIconConverter x:Key="SyncStatusToIconConverter"/>
        <converters:SyncStatusToTooltipConverter x:Key="SyncStatusToTooltipConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="OkrSectionTitle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FocusSectionTitleText}"/>

        <Style x:Key="OkrCaption"
               TargetType="TextBlock"
               BasedOn="{StaticResource FocusCaptionText}"/>
    </UserControl.Resources>

    <Grid Margin="22,18,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;"
                               Style="{StaticResource FocusIconText}"
                               Foreground="{DynamicResource FocusAccentBrightBrush}"
                               FontSize="24"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="目标与关键结果"
                               Style="{StaticResource FocusPageTitleText}"/>
                </StackPanel>
                <TextBlock Text="本地管理目标，按需与飞书 OKR 双向同步"
                           Margin="34,4,0,0"
                           Style="{StaticResource FocusCaptionText}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="立即同步"
                        Style="{StaticResource FocusPrimaryButton}"
                        MinWidth="104"
                        Command="{Binding SyncNowCommand}"
                        IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Width="44"
                        Height="44"
                        Margin="8,0,0,0"
                        Style="{StaticResource FocusIconButton}"
                        Command="{Binding ToggleSettingsCommand}"
                        ToolTip="飞书同步设置">
                    <TextBlock Text="&#xE713;"
                               Style="{StaticResource FocusIconText}"
                               FontSize="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource FocusCard}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        CornerRadius="12"
                        Background="{DynamicResource FocusSurfaceStrongBrush}">
                    <TextBlock Text="&#xE895;"
                               Style="{StaticResource FocusIconText}"
                               Foreground="{DynamicResource FocusAccentBrightBrush}"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SyncStatusText}"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource FocusCardTitleText}"/>
                    <TextBlock Text="{Binding LastSyncResultText}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource FocusMetaText}"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="上次同步"
                               HorizontalAlignment="Right"
                               Style="{StaticResource OkrCaption}"/>
                    <TextBlock Text="{Binding LastSyncTime, StringFormat='{}{0:MM-dd HH:mm}', TargetNullValue='—'}"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource FocusCaptionText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource FocusCard}"
                        Margin="0,0,0,14"
                        Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="飞书同步设置"
                                           Style="{StaticResource OkrSectionTitle}"/>
                                <TextBlock Text="凭据仅保存在本机配置中；清除凭据不会删除本地 OKR。"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource OkrCaption}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Style="{StaticResource FocusIconButton}"
                                    Command="{Binding ToggleSettingsCommand}"
                                    ToolTip="关闭设置">
                                <TextBlock Text="&#xE711;"
                                           Style="{StaticResource FocusIconText}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="App ID"
                                   Margin="2,0,0,5"
                                   Style="{StaticResource OkrCaption}"/>
                        <TextBox Text="{Binding SettingsAppId, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="飞书开放平台应用 App ID"/>

                        <TextBlock Text="App Secret"
                                   Margin="2,10,0,5"
                                   Style="{StaticResource OkrCaption}"/>
                        <PasswordBox x:Name="SettingsAppSecretBox"
                                     Style="{StaticResource FocusPasswordBox}"
                                     ToolTip="为安全起见，已保存的密钥不会回显"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="自动同步间隔"
                                           Margin="2,0,0,5"
                                           Style="{StaticResource OkrCaption}"/>
                                <TextBlock Text="修改后立即保存"
                                           Style="{StaticResource OkrCaption}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SyncIntervalOptions}"
                                      SelectedItem="{Binding SyncIntervalMinutes}"
                                      Style="{StaticResource FocusComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0} 分钟}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="{Binding SettingsValidationMessage}"
                                   Margin="2,10,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource OkrCaption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsValidationSuccess}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SettingsValidationSuccess}"
                                                     Value="False">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource FocusDangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button Content="验证并保存"
                                    Style="{StaticResource FocusPrimaryButton}"
                                    Command="{Binding ValidateAndSaveCredentialsCommand}"/>
                            <Button Content="清除凭据"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource FocusDangerButton}"
                                    Command="{Binding ClearCredentialsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource FocusCard}"
                        Margin="0,0,0,14"
                        Visibility="{Binding IsConfigured, Converter={StaticResource InverseBoolConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;"
                                   Style="{StaticResource FocusIconText}"
                                   Foreground="{DynamicResource FocusAccentBrightBrush}"
                                   FontSize="20"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0">
                            <TextBlock Text="当前仅使用本地 OKR"
                                       Style="{StaticResource FocusCardTitleText}"/>
                            <TextBlock Text="可以正常创建和管理；配置飞书后再进行双向同步。"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource OkrCaption}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="配置飞书"
                                Style="{StaticResource FocusSecondaryButton}"
                                Command="{Binding ToggleSettingsCommand}"/>
                    </Grid>
                </Border>

                <ProgressBar Height="4"
                             Margin="0,0,0,14"
                             IsIndeterminate="True"
                             Style="{StaticResource FocusLinearProgress}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <Border Style="{StaticResource FocusCard}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="新建目标"
                                   Style="{StaticResource OkrSectionTitle}"/>
                        <TextBlock Text="先写清想达成的结果，再用可量化的关键结果跟踪。"
                                   Margin="0,4,0,12"
                                   Style="{StaticResource OkrCaption}"/>

                        <TextBox Text="{Binding NewObjectiveName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="目标名称"/>
                        <TextBox Text="{Binding NewObjectiveNote, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,8,0,0"
                                 Height="64"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 ToolTip="目标说明（可选）"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewObjectivePeriod, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="周期，例如 2026 Q3"/>
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Content="创建目标"
                                    Style="{StaticResource FocusPrimaryButton}"
                                    Command="{Binding AddObjectiveCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="目标"
                           Margin="2,0,0,10"
                           Style="{StaticResource OkrSectionTitle}"/>

                <Border Style="{StaticResource FocusCard}"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasObjectives, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,24">
                        <TextBlock Text="&#xE9D9;"
                                   Style="{StaticResource FocusIconText}"
                                   Foreground="{DynamicResource FocusMutedTextBrush}"
                                   FontSize="30"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="还没有目标"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource FocusCardTitleText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="在上方创建第一个目标，数据会先安全保存在本机。"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource OkrCaption}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Objectives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FocusCard}"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource FocusCardTitleText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Period, StringFormat='周期：{0}', TargetNullValue='未设置周期'}"
                                                           Style="{StaticResource OkrCaption}"/>
                                                <TextBlock Text="  ·  "
                                                           Style="{StaticResource OkrCaption}"/>
                                                <TextBlock Text="{Binding KeyResults.Count, StringFormat='{}{0} 个关键结果'}"
                                                           Style="{StaticResource OkrCaption}"/>
                                                <TextBlock Text="  "
                                                           Style="{StaticResource OkrCaption}"/>
                                                <TextBlock Text="{Binding SyncStatus, Converter={StaticResource SyncStatusToIconConverter}}"
                                                           FontFamily="Segoe Fluent Icons"
                                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                                           ToolTip="{Binding SyncStatus, Converter={StaticResource SyncStatusToTooltipConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="管理"
                                                Style="{StaticResource FocusSecondaryButton}"
                                                MinWidth="72"
                                                Command="{Binding DataContext.SelectObjectiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Click="ManageObjective_Click"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Height="7"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Progress}"
                                                     Style="{StaticResource FocusLinearProgress}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Note}"
                                               Margin="0,9,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource FocusMutedTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Note}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Note}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding KeyResults}"
                                                  Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource FocusSurfaceStrongBrush}"
                                                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                                                        Padding="11,9"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="92"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Margin="0,3,0,0"
                                                                       Style="{StaticResource OkrCaption}">
                                                                <Run Text="{Binding CurrentValue, StringFormat={}{0:G}}"/>
                                                                <Run Text=" / "/>
                                                                <Run Text="{Binding TargetValue, StringFormat={}{0:G}}"/>
                                                                <Run Text="{Binding Unit}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource FocusAccentBrightBrush}"
                                                                   FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="ObjectiveEditor"
                        Style="{StaticResource FocusCard}"
                        Margin="0,2,0,0"
                        Visibility="{Binding IsObjectiveSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="管理目标"
                                           Style="{StaticResource OkrSectionTitle}"/>
                                <TextBlock Text="{Binding SelectedObjective.Name}"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource OkrCaption}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    Style="{StaticResource FocusIconButton}"
                                    Command="{Binding SelectObjectiveCommand}"
                                    ToolTip="关闭管理面板">
                                <TextBlock Text="&#xE711;"
                                           Style="{StaticResource FocusIconText}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="目标名称"
                                   Margin="2,0,0,5"
                                   Style="{StaticResource OkrCaption}"/>
                        <TextBox Text="{Binding SelectedObjective.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="目标说明"
                                   Margin="2,9,0,5"
                                   Style="{StaticResource OkrCaption}"/>
                        <TextBox Text="{Binding SelectedObjective.Note, UpdateSourceTrigger=PropertyChanged}"
                                 Height="62"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>
                        <TextBlock Text="周期"
                                   Margin="2,9,0,5"
                                   Style="{StaticResource OkrCaption}"/>
                        <TextBox Text="{Binding SelectedObjective.Period, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,14">
                            <Button Content="保存目标"
                                    Style="{StaticResource FocusPrimaryButton}"
                                    Command="{Binding UpdateObjectiveCommand}"
                                    CommandParameter="{Binding SelectedObjective}"/>
                            <Button Content="删除目标"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource FocusDangerButton}"
                                    Command="{Binding DeleteObjectiveCommand}"
                                    CommandParameter="{Binding SelectedObjective}"/>
                        </StackPanel>

                        <Border Height="1"
                                Background="{DynamicResource FocusStrokeBrush}"
                                Margin="0,0,0,14"/>

                        <TextBlock Text="新增关键结果"
                                   Style="{StaticResource OkrSectionTitle}"/>
                        <TextBox Text="{Binding NewKrName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,10,0,0"
                                 ToolTip="关键结果名称"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewKrStartValue}"
                                     Margin="0,0,8,0"
                                     ToolTip="起始值"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewKrTargetValue}"
                                     Margin="0,0,8,0"
                                     ToolTip="目标值"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding NewKrUnit}"
                                     ToolTip="单位"/>
                        </Grid>
                        <Button Content="添加关键结果"
                                Margin="0,8,0,14"
                                HorizontalAlignment="Left"
                                Style="{StaticResource FocusPrimaryButton}"
                                Command="{Binding AddKeyResultCommand}"
                                CommandParameter="{Binding SelectedObjective}"/>

                        <ItemsControl ItemsSource="{Binding SelectedObjective.KeyResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource FocusSurfaceStrongBrush}"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            Padding="11"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding StartValue}"
                                                         Margin="0,0,6,0"
                                                         ToolTip="起始值"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding CurrentValue}"
                                                         Margin="0,0,6,0"
                                                         ToolTip="当前值"/>
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding TargetValue}"
                                                         Margin="0,0,6,0"
                                                         ToolTip="目标值"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding Unit}"
                                                         ToolTip="单位"/>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Height="7"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding Progress}"
                                                             Style="{StaticResource FocusLinearProgress}"
                                                             VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="保存"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource FocusSecondaryButton}"
                                                        MinWidth="68"
                                                        Command="{Binding DataContext.UpdateKeyResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2"
                                                        Width="40"
                                                        Height="40"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource FocusIconButton}"
                                                        Command="{Binding DataContext.DeleteKeyResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="删除关键结果">
                                                    <TextBlock Text="&#xE74D;"
                                                               Style="{StaticResource FocusIconText}"
                                                               Foreground="{DynamicResource FocusDangerBrush}"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
