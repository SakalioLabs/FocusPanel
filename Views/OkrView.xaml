<UserControl x:Class="FocusPanel.Views.OkrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="clr-namespace:FocusPanel.Controls"
             xmlns:vm="clr-namespace:FocusPanel.ViewModels"
             xmlns:converters="clr-namespace:FocusPanel.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OkrViewModel}"
             d:DesignHeight="700" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:ProgressToColorConverter x:Key="ProgressToColorConverter"/>
        <converters:SyncStatusToIconConverter x:Key="SyncStatusToIconConverter"/>
        <converters:SyncStatusToTooltipConverter x:Key="SyncStatusToTooltipConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Target" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="OKR Goals" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Sync Now" Command="{Binding SyncNowCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            Margin="0,0,8,0"/>
                    <Button Command="{Binding ToggleSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Settings">
                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="1" Margin="0,0,0,12" Padding="8" CornerRadius="{StaticResource FocusControlCornerRadius}"
                    Background="{DynamicResource MaterialDesignDivider}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Status: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SyncStatusText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Last sync: " Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock Text="{Binding LastSyncTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock Text=" | " Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock Text="{Binding LastSyncResultText}" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings Panel -->
            <Border Grid.Row="2" Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,12" Padding="16" CornerRadius="{StaticResource FocusCardCornerRadius}"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Feishu Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="App ID:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SettingsAppId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4" materialDesign:HintAssist.Hint="Feishu App ID"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="App Secret:" VerticalAlignment="Center" Margin="0,4"/>
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="SettingsAppSecretBox"
                                 materialDesign:HintAssist.Hint="Feishu App Secret" Margin="0,4"/>

                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Validate &amp; Save" Command="{Binding ValidateAndSaveCredentialsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="12" Margin="0,0,8,0"/>
                        <Button Content="Clear Credentials" Command="{Binding ClearCredentialsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="12"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SettingsValidationMessage}"
                               Margin="0,8,0,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsValidationSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettingsValidationSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Sync interval -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Sync Interval:" VerticalAlignment="Center" Margin="0,8"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,8" Width="120" HorizontalAlignment="Left"
                              ItemsSource="{Binding SyncIntervalOptions}"
                              SelectedItem="{Binding SyncIntervalMinutes}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., StringFormat='{}{0} min'}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Main Content -->
            <StackPanel Grid.Row="3">
                <!-- Not Configured Placeholder -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsConfigured, Converter={StaticResource InverseBoolConverter}}">
                    <materialDesign:PackIcon Kind="Target" Width="48" Height="48"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Feishu OKR Not Configured" FontSize="18" HorizontalAlignment="Center" Margin="0,8"/>
                    <TextBlock Text="Click the gear icon to set up your Feishu app credentials."
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- OKR List -->
                <ItemsControl ItemsSource="{Binding Objectives}"
                              Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="{StaticResource FocusCardCornerRadius}"
                                    Background="{DynamicResource MaterialDesignCardBackground}">
                                <StackPanel>
                                    <!-- Objective Header -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Column="0" Grid.RowSpan="2"
                                                     Width="80" Height="6" Minimum="0" Maximum="100"
                                                     Value="{Binding Progress}"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"/>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}%'}" FontSize="13"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Period, StringFormat='Period: {0}'}" FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Weight, StringFormat='Weight: {0:F1}'}" FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,12,0"/>
                                            <materialDesign:PackIcon Kind="{Binding SyncStatus, Converter={StaticResource SyncStatusToIconConverter}}"
                                                                     Width="14" Height="14" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>

                                    </Grid>

                                    <!-- Key Results -->
                                    <StackPanel Margin="24,8,0,0">
                                        <ItemsControl ItemsSource="{Binding KeyResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,4" Padding="8" CornerRadius="{StaticResource FocusControlCornerRadius}"
                                                            Background="{DynamicResource MaterialDesignDivider}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                               Text="{Binding CurrentValue, StringFormat='Current: {0:F0}'}"/>
                                                                    <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                               Text="{Binding StartValue, StringFormat='{}{0:F0}'}"/>
                                                                    <TextBlock Text=" -> " FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                               Text="{Binding TargetValue, StringFormat='{}{0:F0}'}"/>
                                                                    <TextBlock Text=" " FontSize="12"/>
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                               Text="{Binding Unit}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                                                         Value="{Binding Progress}"
                                                                         Foreground="{Binding Progress, Converter={StaticResource ProgressToColorConverter}}"
                                                                         Margin="8,0" VerticalAlignment="Center"/>

                                                            <Button Grid.Column="2"
                                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                                    ToolTip="Delete this KR"
                                                                    Command="{Binding DataContext.DeleteKeyResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"
                                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Objective -->
                <Border Margin="0,12,0,0" Padding="12" CornerRadius="{StaticResource FocusCardCornerRadius}"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <TextBlock Text="New Objective" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding NewObjectiveName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Objective name" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewObjectiveNote, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Notes (optional)" Margin="0,0,0,4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewObjectivePeriod, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Period (e.g., 2026 Q2)" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Add Objective" Command="{Binding AddObjectiveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="12"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
