<UserControl x:Class="FocusPanel.Views.AIAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FocusPanel.Models">
    <Grid Margin="22,18,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AI 助手"
                           Style="{StaticResource FocusPageTitleText}"/>
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,5,0,0"
                           Style="{StaticResource FocusSecondaryBodyText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Style="{StaticResource FocusSecondaryButton}"
                        MinWidth="92"
                        Content="清空对话"
                        Command="{Binding ClearConversationCommand}"/>
                <Button Style="{StaticResource FocusSecondaryButton}"
                        MinWidth="76"
                        Margin="8,1,0,1"
                        Content="配置"
                        Command="{Binding ToggleSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource FocusCard}"
                Margin="0,16,0,14"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="OpenAI API 配置"
                               Style="{StaticResource FocusSectionTitleText}"/>
                    <TextBlock Margin="0,4,0,12"
                               Style="{StaticResource FocusCaptionText}"
                               TextWrapping="Wrap"
                               Text="API Key 使用 Windows DPAPI 加密，仅当前 Windows 用户可解密；不会显示或写入日志。ChatGPT 订阅不等同于 API Key。"/>
                </StackPanel>
                <PasswordBox x:Name="ApiKeyBox"
                             Grid.Row="1"
                             Style="{StaticResource FocusPasswordBox}"
                             ToolTip="输入新的 OpenAI API Key"/>
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="10,0,0,0"
                          Style="{StaticResource FocusComboBox}"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}"/>
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="10,1,0,1"
                        Style="{StaticResource FocusPrimaryButton}"
                        MinWidth="88"
                        Content="保存"
                        Click="CredentialAction_Click"
                        Command="{Binding SaveSettingsCommand}"/>
                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource FocusDangerButton}"
                            MinWidth="108"
                            Height="36"
                            Content="移除 API Key"
                            Click="CredentialAction_Click"
                            Command="{Binding ClearApiKeyCommand}"/>
                    <TextBlock Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource FocusCaptionText}"
                               Text="更换 Key 时直接输入新值并保存；留空只更新模型。"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource FocusCard}"
                    Visibility="{Binding HasMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer x:Name="ConversationScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AiChatMessage}">
                                <Border x:Name="MessageBubble"
                                        MaxWidth="560"
                                        HorizontalAlignment="Left"
                                        Margin="0,5,0,7"
                                        Padding="14,11"
                                        CornerRadius="{StaticResource FocusControlCornerRadius}"
                                        Background="{DynamicResource FocusSurfaceStrongBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Sender}"
                                                       Style="{StaticResource FocusCardTitleText}"/>
                                            <TextBlock Text="{Binding TimeText}"
                                                       Margin="8,0,0,0"
                                                       Style="{StaticResource FocusMetaText}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   Margin="0,7,0,0"
                                                   Style="{StaticResource FocusBodyText}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21"
                                                   IsHyphenationEnabled="False"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}"
                                                 Value="True">
                                        <Setter TargetName="MessageBubble"
                                                Property="HorizontalAlignment"
                                                Value="Right"/>
                                        <Setter TargetName="MessageBubble"
                                                Property="Background"
                                                Value="{DynamicResource FocusAccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMessages}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE99A;"
                           Style="{StaticResource FocusIconText}"
                           FontSize="40"/>
                <TextBlock Text="把下一步想清楚"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource FocusEmptyStateTitleText}"/>
                <TextBlock Text="AI 默认看不到你的 FocusPanel 数据；只有打开下方授权开关后，才会随问题发送精简摘要。"
                           Width="460"
                           Margin="0,8,0,0"
                           Style="{StaticResource FocusSecondaryBodyText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <WrapPanel Margin="0,18,0,0"
                           HorizontalAlignment="Center">
                    <Button Style="{StaticResource FocusSecondaryButton}"
                            Content="整理今日重点"
                            Command="{Binding UseQuickPromptCommand}"
                            CommandParameter="请帮我整理今天最重要的三件事，并给出执行顺序。"/>
                    <Button Style="{StaticResource FocusSecondaryButton}"
                            Margin="8,1,0,1"
                            Content="拆解下一步"
                            Command="{Binding UseQuickPromptCommand}"
                            CommandParameter="请把我现在最重要的目标拆解成可以立刻开始的下一步。"/>
                    <Button Style="{StaticResource FocusSecondaryButton}"
                            Margin="8,1,0,1"
                            Content="复盘专注"
                            Command="{Binding UseQuickPromptCommand}"
                            CommandParameter="请根据可用信息帮我复盘最近的专注状态，并提出一个改进建议。"/>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource FocusCard}"
                Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox MinHeight="72"
                         MaxHeight="150"
                         MaxLength="8000"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="输入问题"/>
                <Grid Grid.Row="1"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="随问题附带本地任务、OKR 与近 7 天专注摘要"
                              IsChecked="{Binding IncludeLocalContext}"
                              VerticalAlignment="Center"
                              ToolTip="仅发送任务标题、状态、OKR 进度与专注统计；不读取文件内容"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource FocusSecondaryButton}"
                                MinWidth="72"
                                Content="停止"
                                Command="{Binding StopCommand}"/>
                        <Button Style="{StaticResource FocusPrimaryButton}"
                                MinWidth="88"
                                Margin="8,1,0,1"
                                Content="发送"
                                Command="{Binding SendCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
