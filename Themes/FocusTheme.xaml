<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FocusPanel.Controls">
    <Color x:Key="FocusAccentColor">#006FC4</Color>
    <Color x:Key="FocusAccentBrightColor">#4CA6E8</Color>
    <Color x:Key="FocusTextColor">#F5F7FF</Color>
    <Color x:Key="FocusMutedTextColor">#AEB5C8</Color>
    <Color x:Key="FocusShellTintColor">#10191C24</Color>
    <Color x:Key="FocusSurfaceColor">#521E222B</Color>
    <Color x:Key="FocusSurfaceStrongColor">#D020242C</Color>
    <Color x:Key="FocusSurfaceSoftColor">#302C313D</Color>
    <Color x:Key="FocusStrokeColor">#1CFFFFFF</Color>
    <Color x:Key="FocusHoverColor">#18FFFFFF</Color>
    <Color x:Key="FocusDangerColor">#FF6B7A</Color>

    <SolidColorBrush x:Key="FocusAccentBrush" Color="{StaticResource FocusAccentColor}"/>
    <SolidColorBrush x:Key="FocusAccentBrightBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <SolidColorBrush x:Key="FocusTextBrush" Color="{StaticResource FocusTextColor}"/>
    <SolidColorBrush x:Key="FocusMutedTextBrush" Color="{StaticResource FocusMutedTextColor}"/>
    <SolidColorBrush x:Key="FocusShellTintBrush" Color="{StaticResource FocusShellTintColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceBrush" Color="{StaticResource FocusSurfaceColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceStrongBrush" Color="{StaticResource FocusSurfaceStrongColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceSoftBrush" Color="{StaticResource FocusSurfaceSoftColor}"/>
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="{StaticResource FocusStrokeColor}"/>
    <SolidColorBrush x:Key="FocusHoverBrush" Color="{StaticResource FocusHoverColor}"/>
    <SolidColorBrush x:Key="FocusDangerBrush" Color="{StaticResource FocusDangerColor}"/>
    <SolidColorBrush x:Key="FocusKeyboardFocusBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <CornerRadius x:Key="FocusShellCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FocusCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="FocusControlCornerRadius">8</CornerRadius>

    <!-- Compatibility names used by existing feature pages while they move to the shared design system. -->
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource FocusAccentColor}"/>
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <SolidColorBrush x:Key="MaterialDesignBody" Color="{StaticResource FocusTextColor}"/>
    <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="{StaticResource FocusMutedTextColor}"/>
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="{StaticResource FocusSurfaceStrongColor}"/>
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="{StaticResource FocusStrokeColor}"/>
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="{StaticResource FocusSurfaceSoftColor}"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
    </Style>

    <Style x:Key="FocusIconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FocusRoundedKeyboardVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusKeyboardFocusBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusIconButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusPrimaryButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FocusSecondaryButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
    </Style>

    <Style x:Key="FocusSearchBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource FocusSearchBox}"/>

    <Style x:Key="FocusCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource FocusCardCornerRadius}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="FocusLinearProgress"
           TargetType="ProgressBar">
        <Setter Property="Foreground"
                Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceStrongBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaterialDesignIconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
    </Style>
    <Style x:Key="MaterialDesignIconForegroundButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}"/>
    <Style x:Key="MaterialDesignFlatButton" TargetType="Button" BasedOn="{StaticResource FocusSecondaryButton}"/>
    <Style x:Key="MaterialDesignRaisedButton" TargetType="Button" BasedOn="{StaticResource FocusPrimaryButton}"/>
    <Style x:Key="MaterialDesignOutlinedButton" TargetType="Button" BasedOn="{StaticResource FocusSecondaryButton}"/>
    <Style x:Key="MaterialDesignFloatingActionMiniButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}">
        <Setter Property="Background" Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="MaterialDesignOutlinedTextBox" TargetType="TextBox" BasedOn="{StaticResource FocusSearchBox}"/>
    <Style x:Key="MaterialDesignTextBox" TargetType="TextBox" BasedOn="{StaticResource FocusSearchBox}"/>
    <Style x:Key="MaterialDesignOutlinedComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
    </Style>
    <Style x:Key="MaterialDesignRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
    </Style>
    <Style x:Key="MaterialDesignTabRadioButton" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}"/>
    <Style x:Key="MaterialDesignChoiceChipOutlineRadioButton" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}"/>
    <Style x:Key="MaterialDesignCaptionTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusMutedTextBrush}"/>
    </Style>
    <Style x:Key="MaterialDesignBody2TextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="MaterialDesignHeadline6TextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MaterialDesignSubtitle2TextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MaterialDesignMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceStrongBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style TargetType="{x:Type controls:Card}">
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Card}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource FocusCardCornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:PopupBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PopupBox}">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      IsChecked="{Binding IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Content="{TemplateBinding ToggleContent}"/>
                        <Popup IsOpen="{TemplateBinding IsPopupOpen}"
                               Placement="{TemplateBinding PlacementMode}"
                               PlacementTarget="{Binding ElementName=Toggle}"
                               StaysOpen="{TemplateBinding StaysOpen}"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F02A2E38"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</ResourceDictionary>
