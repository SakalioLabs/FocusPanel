<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="FocusAccentColor">#006FC4</Color>
    <Color x:Key="FocusAccentBrightColor">#4CA6E8</Color>
    <Color x:Key="FocusTextColor">#F5F7FF</Color>
    <Color x:Key="FocusMutedTextColor">#AEB5C8</Color>
    <Color x:Key="FocusShellTintColor">#10191C24</Color>
    <Color x:Key="FocusSurfaceColor">#521E222B</Color>
    <Color x:Key="FocusSurfaceStrongColor">#D020242C</Color>
    <Color x:Key="FocusSurfaceSoftColor">#302C313D</Color>
    <Color x:Key="FocusStrokeColor">#1CFFFFFF</Color>
    <Color x:Key="FocusHoverColor">#18FFFFFF</Color>
    <Color x:Key="FocusDangerColor">#FF6B7A</Color>

    <SolidColorBrush x:Key="FocusAccentBrush" Color="{StaticResource FocusAccentColor}"/>
    <SolidColorBrush x:Key="FocusAccentBrightBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <SolidColorBrush x:Key="FocusTextBrush" Color="{StaticResource FocusTextColor}"/>
    <SolidColorBrush x:Key="FocusMutedTextBrush" Color="{StaticResource FocusMutedTextColor}"/>
    <SolidColorBrush x:Key="FocusShellTintBrush" Color="{StaticResource FocusShellTintColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceBrush" Color="{StaticResource FocusSurfaceColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceStrongBrush" Color="{StaticResource FocusSurfaceStrongColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceSoftBrush" Color="{StaticResource FocusSurfaceSoftColor}"/>
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="{StaticResource FocusStrokeColor}"/>
    <SolidColorBrush x:Key="FocusHoverBrush" Color="{StaticResource FocusHoverColor}"/>
    <SolidColorBrush x:Key="FocusDangerBrush" Color="{StaticResource FocusDangerColor}"/>
    <SolidColorBrush x:Key="FocusKeyboardFocusBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <CornerRadius x:Key="FocusShellCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FocusCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="FocusControlCornerRadius">8</CornerRadius>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
    </Style>

    <Style x:Key="FocusIconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FocusRoundedKeyboardVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusKeyboardFocusBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusIconButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusPrimaryButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FocusSecondaryButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
    </Style>

    <Style x:Key="FocusSegmentRadioButton"
           TargetType="RadioButton">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusMutedTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource FocusControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="Chrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusAccentBrush}"/>
                            <Setter Property="Foreground"
                                    Value="White"/>
                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusComboBox"
           TargetType="ComboBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
    </Style>

    <Style x:Key="FocusSearchBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource FocusSearchBox}"/>

    <Style x:Key="FocusPasswordBox"
           TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource FocusCardCornerRadius}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="FocusLinearProgress"
           TargetType="ProgressBar">
        <Setter Property="Foreground"
                Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceStrongBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusContextMenu"
           TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="MenuSurface"
                            MinWidth="188"
                            MaxWidth="420"
                            Padding="4"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusMenuItem"
           TargetType="MenuItem">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource FocusControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckIndicator"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="13"
                                           Foreground="{DynamicResource FocusAccentBrightBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="7,0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <TextBlock x:Name="SubmenuArrow"
                                           Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="11"
                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Right"
                               PlacementTarget="{Binding ElementName=ItemChrome}"
                               HorizontalOffset="-3"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="188"
                                    MaxWidth="420"
                                    Padding="4"
                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                    BorderBrush="{DynamicResource FocusStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource FocusCardCornerRadius}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusSurfaceSoftBrush}"/>
                            <Setter TargetName="SubmenuArrow"
                                    Property="Foreground"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="CheckIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems"
                                 Value="True">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ItemChrome"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusMenuSeparator"
           TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="12,5"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu"
           BasedOn="{StaticResource FocusContextMenu}"/>
    <Style TargetType="MenuItem"
           BasedOn="{StaticResource FocusMenuItem}"/>
    <Style TargetType="Separator"
           BasedOn="{StaticResource FocusMenuSeparator}"/>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F02A2E38"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</ResourceDictionary>
