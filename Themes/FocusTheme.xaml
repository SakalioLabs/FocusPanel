<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="FocusAccentColor">#006FC4</Color>
    <Color x:Key="FocusAccentBrightColor">#4CA6E8</Color>
    <Color x:Key="FocusTextColor">#F5F7FF</Color>
    <Color x:Key="FocusMutedTextColor">#AEB5C8</Color>
    <Color x:Key="FocusShellTintColor">#10191C24</Color>
    <Color x:Key="FocusSurfaceColor">#521E222B</Color>
    <Color x:Key="FocusSurfaceStrongColor">#D020242C</Color>
    <Color x:Key="FocusSurfaceSoftColor">#302C313D</Color>
    <Color x:Key="FocusStrokeColor">#1CFFFFFF</Color>
    <Color x:Key="FocusHoverColor">#18FFFFFF</Color>
    <Color x:Key="FocusDangerColor">#FF6B7A</Color>

    <SolidColorBrush x:Key="FocusAccentBrush" Color="{StaticResource FocusAccentColor}"/>
    <SolidColorBrush x:Key="FocusAccentBrightBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <SolidColorBrush x:Key="FocusAccentSoftBrush" Color="#2E006FC4"/>
    <SolidColorBrush x:Key="FocusTextBrush" Color="{StaticResource FocusTextColor}"/>
    <SolidColorBrush x:Key="FocusMutedTextBrush" Color="{StaticResource FocusMutedTextColor}"/>
    <SolidColorBrush x:Key="FocusShellTintBrush" Color="{StaticResource FocusShellTintColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceBrush" Color="{StaticResource FocusSurfaceColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceStrongBrush" Color="{StaticResource FocusSurfaceStrongColor}"/>
    <SolidColorBrush x:Key="FocusSurfaceSoftBrush" Color="{StaticResource FocusSurfaceSoftColor}"/>
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="{StaticResource FocusStrokeColor}"/>
    <SolidColorBrush x:Key="FocusHoverBrush" Color="{StaticResource FocusHoverColor}"/>
    <SolidColorBrush x:Key="FocusDangerBrush" Color="{StaticResource FocusDangerColor}"/>
    <SolidColorBrush x:Key="FocusWarningBrush" Color="#FFFFC857"/>
    <SolidColorBrush x:Key="FocusWarningSoftBrush" Color="#33FFB020"/>
    <SolidColorBrush x:Key="FocusWarningTextBrush" Color="#FFF5F7FF"/>
    <SolidColorBrush x:Key="FocusOverlayBrush" Color="#50000000"/>
    <SolidColorBrush x:Key="FocusEdgeIndicatorBrush" Color="#C8FFFFFF"/>
    <SolidColorBrush x:Key="FocusKeyboardFocusBrush" Color="{StaticResource FocusAccentBrightColor}"/>
    <CornerRadius x:Key="FocusShellCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="FocusCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="FocusControlCornerRadius">8</CornerRadius>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
    </Style>

    <Style x:Key="FocusIconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FocusRoundedKeyboardVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusKeyboardFocusBrush}"
                            BorderThickness="2"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusIconButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusPrimaryButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FocusSecondaryButton" TargetType="Button" BasedOn="{StaticResource FocusIconButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
    </Style>

    <Style x:Key="FocusToggleButton"
           TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleChrome"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ToggleChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="ToggleChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusAccentSoftBrush}"/>
                            <Setter TargetName="ToggleChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ToggleChrome"
                                    Property="Opacity"
                                    Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ToggleChrome"
                                    Property="Opacity"
                                    Value="0.38"/>
                            <Setter Property="Cursor"
                                    Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusSegmentRadioButton"
           TargetType="RadioButton">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusMutedTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SegmentChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Border x:Name="SegmentSelectionIndicator"
                                    Height="3"
                                    Margin="10,0,10,3"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource FocusAccentBrightBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="SegmentChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="SegmentChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusAccentSoftBrush}"/>
                            <Setter TargetName="SegmentChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusStrokeBrush}"/>
                            <Setter TargetName="SegmentSelectionIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource FocusTextBrush}"/>
                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="SegmentChrome"
                                    Property="Opacity"
                                    Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="SegmentChrome"
                                    Property="Opacity"
                                    Value="0.38"/>
                            <Setter Property="Cursor"
                                    Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusCheckBox"
           TargetType="CheckBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="InteractionSurface"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxChrome"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FocusSurfaceSoftBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <TextBlock x:Name="CheckGlyph"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="12"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                    <Border x:Name="IndeterminateGlyph"
                                            Width="9"
                                            Height="2"
                                            Background="White"
                                            CornerRadius="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="CheckContent"
                                              Grid.Column="1"
                                              Margin="8,0,0,0"
                                              ContentSource="Content"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="InteractionSurface"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="CheckBoxChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusAccentBrush}"/>
                            <Setter TargetName="CheckBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                            <Setter TargetName="CheckGlyph"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="{x:Null}">
                            <Setter TargetName="CheckBoxChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusAccentBrush}"/>
                            <Setter TargetName="CheckBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                            <Setter TargetName="IndeterminateGlyph"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasContent"
                                 Value="False">
                            <Setter TargetName="CheckContent"
                                    Property="Margin"
                                    Value="0"/>
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="InteractionSurface"
                                    Property="Opacity"
                                    Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="InteractionSurface"
                                    Property="Opacity"
                                    Value="0.38"/>
                            <Setter Property="Cursor"
                                    Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox"
           BasedOn="{StaticResource FocusCheckBox}"/>

    <Style x:Key="FocusComboBoxItem"
           TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    Margin="-5,3,0,3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource FocusAccentBrightBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="6,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusSurfaceSoftBrush}"/>
                            <Setter TargetName="SelectionIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ItemChrome"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusComboBox"
           TargetType="ComboBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource FocusComboBoxItem}"/>
        <Setter Property="ScrollViewer.CanContentScroll"
                Value="True"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboChrome"
                                            MinHeight="{Binding MinHeight, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              SnapsToDevicePixels="True"/>
                                            <TextBlock x:Name="DropDownArrow"
                                                       Grid.Column="1"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource FocusMutedTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="ComboChrome"
                                                    Property="Background"
                                                    Value="{DynamicResource FocusHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked"
                                                 Value="True">
                                            <Setter TargetName="ComboChrome"
                                                    Property="Background"
                                                    Value="{DynamicResource FocusSurfaceSoftBrush}"/>
                                            <Setter TargetName="DropDownArrow"
                                                    Property="Foreground"
                                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=DropDownToggle}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border x:Name="DropDownSurface"
                                    MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,6,0,0"
                                    Padding="4"
                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                    BorderBrush="{DynamicResource FocusStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource FocusCardCornerRadius}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems"
                                 Value="False">
                            <Setter TargetName="DropDownSurface"
                                    Property="MinHeight"
                                    Value="44"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="DropDownToggle"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox"
           BasedOn="{StaticResource FocusComboBox}"/>
    <Style TargetType="ComboBoxItem"
           BasedOn="{StaticResource FocusComboBoxItem}"/>

    <Style x:Key="FocusTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.72"/>
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextInputChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="TextInputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="TextInputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                            <Setter TargetName="TextInputChrome"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly"
                                 Value="True">
                            <Setter TargetName="TextInputChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusSurfaceBrush}"/>
                            <Setter TargetName="TextInputChrome"
                                    Property="Opacity"
                                    Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="TextInputChrome"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusSearchBox"
           TargetType="TextBox"
           BasedOn="{StaticResource FocusTextBox}"/>
    <Style TargetType="TextBox"
           BasedOn="{StaticResource FocusTextBox}"/>

    <Style x:Key="FocusPasswordBox"
           TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="CaretBrush"
                Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="SelectionBrush"
                Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="SelectionTextBrush"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="SelectionOpacity"
                Value="0.72"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="PasswordInputChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="PasswordInputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="PasswordInputChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                            <Setter TargetName="PasswordInputChrome"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="PasswordInputChrome"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox"
           BasedOn="{StaticResource FocusPasswordBox}"/>

    <Style x:Key="FocusCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FocusSurfaceSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource FocusCardCornerRadius}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="FocusSliderThumb"
           TargetType="Thumb">
        <Setter Property="Width"
                Value="18"/>
        <Setter Property="Height"
                Value="18"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="SliderThumbSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusSliderTrackButton"
           TargetType="RepeatButton">
        <Setter Property="Focusable"
                Value="False"/>
        <Setter Property="IsTabStop"
                Value="False"/>
        <Setter Property="Height"
                Value="4"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceStrongBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="SliderTrackSegment"
                            Height="{TemplateBinding Height}"
                            Width="{TemplateBinding Width}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusSlider"
           TargetType="Slider">
        <Setter Property="MinHeight"
                Value="44"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusAccentBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceStrongBrush}"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderRoot"
                          MinHeight="{TemplateBinding MinHeight}"
                          MinWidth="{TemplateBinding MinWidth}"
                          Background="Transparent"
                          SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track"
                               Margin="9,0"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseTrackButton"
                                              Style="{StaticResource FocusSliderTrackButton}"
                                              Background="{TemplateBinding Foreground}"
                                              Command="{x:Static Slider.DecreaseLarge}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb"
                                       Style="{StaticResource FocusSliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseTrackButton"
                                              Style="{StaticResource FocusSliderTrackButton}"
                                              Background="{TemplateBinding Background}"
                                              Command="{x:Static Slider.IncreaseLarge}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation"
                                 Value="Vertical">
                            <Setter Property="MinHeight"
                                    Value="0"/>
                            <Setter Property="MinWidth"
                                    Value="44"/>
                            <Setter TargetName="PART_Track"
                                    Property="Margin"
                                    Value="0,9"/>
                            <Setter TargetName="DecreaseTrackButton"
                                    Property="Height"
                                    Value="Auto"/>
                            <Setter TargetName="DecreaseTrackButton"
                                    Property="Width"
                                    Value="4"/>
                            <Setter TargetName="IncreaseTrackButton"
                                    Property="Height"
                                    Value="Auto"/>
                            <Setter TargetName="IncreaseTrackButton"
                                    Property="Width"
                                    Value="4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="SliderThumb"
                                    Property="Background"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                            <Setter TargetName="SliderThumb"
                                    Property="Width"
                                    Value="20"/>
                            <Setter TargetName="SliderThumb"
                                    Property="Height"
                                    Value="20"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="SliderRoot"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider"
           BasedOn="{StaticResource FocusSlider}"/>

    <Style x:Key="FocusLinearProgress"
           TargetType="ProgressBar">
        <Setter Property="Foreground"
                Value="{DynamicResource FocusAccentBrightBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceStrongBrush}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="ProgressRoot"
                          ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"/>
                        <Border x:Name="IndeterminateIndicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"
                                Opacity="0.28"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate"
                                 Value="True">
                            <Setter TargetName="PART_Indicator"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                            <Setter TargetName="IndeterminateIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminatePulseStoryboard">
                                    <Storyboard RepeatBehavior="Forever"
                                                AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.28"
                                                         To="0.9"
                                                         Duration="0:0:0.72"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminatePulseStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ProgressRoot"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ProgressBar"
           BasedOn="{StaticResource FocusLinearProgress}"/>

    <Style x:Key="FocusScrollThumb"
           TargetType="Thumb">
        <Setter Property="Background"
                Value="{DynamicResource FocusMutedTextBrush}"/>
        <Setter Property="Opacity"
                Value="0.52"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbSurface"
                            Margin="2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusScrollPageButton"
           TargetType="RepeatButton">
        <Setter Property="Focusable"
                Value="False"/>
        <Setter Property="IsTabStop"
                Value="False"/>
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusScrollBar"
           TargetType="ScrollBar">
        <Setter Property="Width"
                Value="10"/>
        <Setter Property="MinWidth"
                Value="10"/>
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusMutedTextBrush}"/>
        <Setter Property="Focusable"
                Value="False"/>
        <Setter Property="OverridesDefaultStyle"
                Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="ScrollRoot"
                          Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreasePageButton"
                                              Style="{StaticResource FocusScrollPageButton}"
                                              Command="{x:Static ScrollBar.PageUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb"
                                       MinHeight="28"
                                       Style="{StaticResource FocusScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreasePageButton"
                                              Style="{StaticResource FocusScrollPageButton}"
                                              Command="{x:Static ScrollBar.PageDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation"
                                 Value="Horizontal">
                            <Setter Property="Width"
                                    Value="Auto"/>
                            <Setter Property="MinWidth"
                                    Value="0"/>
                            <Setter Property="Height"
                                    Value="10"/>
                            <Setter Property="MinHeight"
                                    Value="10"/>
                            <Setter TargetName="PART_Track"
                                    Property="IsDirectionReversed"
                                    Value="False"/>
                            <Setter TargetName="ScrollThumb"
                                    Property="MinHeight"
                                    Value="0"/>
                            <Setter TargetName="ScrollThumb"
                                    Property="MinWidth"
                                    Value="28"/>
                            <Setter TargetName="DecreasePageButton"
                                    Property="Command"
                                    Value="{x:Static ScrollBar.PageLeftCommand}"/>
                            <Setter TargetName="IncreasePageButton"
                                    Property="Command"
                                    Value="{x:Static ScrollBar.PageRightCommand}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ScrollThumb"
                                    Property="Background"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                            <Setter TargetName="ScrollThumb"
                                    Property="Opacity"
                                    Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ScrollRoot"
                                    Property="Opacity"
                                    Value="0.28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar"
           BasedOn="{StaticResource FocusScrollBar}"/>

    <Style x:Key="FocusContextMenu"
           TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="MenuSurface"
                            MinWidth="188"
                            MaxWidth="420"
                            Padding="4"
                            Background="{DynamicResource FocusSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource FocusStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource FocusCardCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusMenuItem"
           TargetType="MenuItem">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>
        <Setter Property="FocusVisualStyle"
                Value="{StaticResource FocusRoundedKeyboardVisual}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource FocusControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckIndicator"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="13"
                                           Foreground="{DynamicResource FocusAccentBrightBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="7,0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <TextBlock x:Name="SubmenuArrow"
                                           Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="11"
                                           Foreground="{DynamicResource FocusMutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Right"
                               PlacementTarget="{Binding ElementName=ItemChrome}"
                               HorizontalOffset="-3"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="188"
                                    MaxWidth="420"
                                    Padding="4"
                                    Background="{DynamicResource FocusSurfaceStrongBrush}"
                                    BorderBrush="{DynamicResource FocusStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource FocusCardCornerRadius}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen"
                                 Value="True">
                            <Setter TargetName="ItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource FocusSurfaceSoftBrush}"/>
                            <Setter TargetName="SubmenuArrow"
                                    Property="Foreground"
                                    Value="{DynamicResource FocusAccentBrightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="CheckIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems"
                                 Value="True">
                            <Setter TargetName="SubmenuArrow"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ItemChrome"
                                    Property="Opacity"
                                    Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusMenuSeparator"
           TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="12,5"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu"
           BasedOn="{StaticResource FocusContextMenu}"/>
    <Style TargetType="MenuItem"
           BasedOn="{StaticResource FocusMenuItem}"/>
    <Style TargetType="Separator"
           BasedOn="{StaticResource FocusMenuSeparator}"/>

    <Style x:Key="FocusToolTip"
           TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Background"
                Value="{DynamicResource FocusSurfaceStrongBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource FocusTextBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="ToolTipSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource FocusControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip"
           BasedOn="{StaticResource FocusToolTip}"/>
</ResourceDictionary>
